---
layout: base.njk
title: Search Records
permalink: /search/
---

<div class="search-page">

  <div class="search-header">
    <h1 class="search-title">Search Records</h1>
    <p class="search-subtitle">
      Search by name, nickname, platoon, location, or unit.
      Events and documents are cross-referenced by soldier — searching a name
      surfaces every record that mentions them.
    </p>
  </div>

  <form class="search-form" id="search-form" action="/search/" method="get">
    <div class="search-input-row">
      <input
        type="search"
        id="search-input"
        name="q"
        class="search-input"
        placeholder="Name, nickname, platoon, location…"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="submit" class="search-btn">Search</button>
    </div>
  </form>

  <div id="search-results" class="search-results" aria-live="polite"></div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/lunr.js/2.3.9/lunr.min.js"></script>
<script>
(function () {

  function qs(sel) { return document.querySelector(sel); }

  function getParam(key) {
    return new URLSearchParams(window.location.search).get(key) || "";
  }

  function photoPath(soldier) {
    if (soldier.profile_photo_url) return soldier.profile_photo_url;
    if (!soldier.profile_photo) return null;
    return "/media/photos/soldiers/" + soldier.slug + "/profile/" + soldier.profile_photo;
  }

  function platoonShort(platoon) {
    return platoon ? platoon.replace(/\s*\([^)]*\)/, "") : "";
  }

  // Look up soldier display names from a space-separated slug string.
  function soldierNames(slugStr, max) {
    if (!slugStr) return [];
    max = max || 3;
    var names = [];
    slugStr.split(" ").filter(Boolean).forEach(function (slug) {
      if (names.length >= max) return;
      var r = records[slug];
      if (r && r.type === "soldier") names.push(r.name);
    });
    return names;
  }

  // Wrap a result group in a <details> element.
  // Open by default when there are fewer than 5 results.
  function detailsWrap(label, countOrNull, bodyHtml, forceOpen) {
    var count = countOrNull !== null ? countOrNull : 0;
    var isOpen = forceOpen || count < 5;
    var countBadge = countOrNull !== null
      ? '<span class="result-count">' + count + '</span>'
      : '';
    return '<details class="result-group"' + (isOpen ? ' open' : '') + '>' +
      '<summary class="result-group-label">' + label + ' ' + countBadge + '</summary>' +
      bodyHtml +
      '</details>';
  }

  var lunrIndex = null;
  var records   = {};

  fetch("/search-index.json")
    .then(function (r) { return r.json(); })
    .then(function (data) {

      data.forEach(function (s) { records[s.id] = s; });

      lunrIndex = lunr(function () {
        this.ref("id");
        this.field("name",      { boost: 10 });
        this.field("last_name", { boost: 8  });
        this.field("nickname",  { boost: 8  });
        this.field("platoon",   { boost: 4  });
        this.field("contains",  { boost: 6  });
        this.field("tagged",    { boost: 4  });
        this.field("rank",      { boost: 2  });
        this.field("mos",       { boost: 2  });
        this.field("hometown",  { boost: 2  });
        this.field("location",  { boost: 3  });
        this.field("excerpt",   { boost: 1  });

        data.forEach(function (s) { this.add(s); }, this);
      });

      var q = getParam("q");
      if (q) {
        qs("#search-input").value = q;
        runSearch(q);
      }
    })
    .catch(function (err) {
      console.error("searchIndex load failed:", err);
      qs("#search-results").innerHTML =
        '<p class="search-error">Search index could not be loaded. Try refreshing the page.</p>';
    });

  function runSearch(query) {
    var container = qs("#search-results");
    if (!query.trim()) { container.innerHTML = ""; return; }
    if (!lunrIndex)    { container.innerHTML = '<p class="search-status">Index loading…</p>'; return; }

    var hits;
    try {
      hits = lunrIndex.search(query + "*");
      if (!hits.length) hits = lunrIndex.search(query + "~1");
    } catch (e) {
      hits = [];
    }

    var allHits   = hits.map(function (h) { return records[h.ref]; }).filter(Boolean);
    var soldiers  = allHits.filter(function (r) { return r.type === "soldier"; });
    var events    = allHits.filter(function (r) { return r.type === "event"; });
    var documents = allHits.filter(function (r) { return r.type === "document"; });
    var anecdotes = allHits.filter(function (r) { return r.type === "anecdote"; });
    var letters   = allHits.filter(function (r) { return r.type === "letter"; });

    renderResults(query, soldiers, events, documents, anecdotes, letters, container);
  }

  // ── Renderers ─────────────────────────────────────────────────────────────

  function renderResults(query, soldiers, events, documents, anecdotes, letters, container) {
    var total = soldiers.length + events.length + documents.length + anecdotes.length + letters.length;
    if (!total) {
      container.innerHTML =
        '<p class="search-no-results">No records found for <strong>' +
        escHtml(query) + '</strong>.</p>';
      return;
    }

    // Identify the top soldier match for the contribute footer
    var topSoldier = soldiers.length ? soldiers[0] : null;

    var html = "";
    if (soldiers.length)  html += renderProfileGroup(soldiers);
    if (letters.length)   html += renderLetterGroup(letters);
    if (events.length)    html += renderEventGroup(events);
    if (documents.length) html += renderDocumentGroup(documents);
    if (anecdotes.length) html += renderAnecdoteGroup(anecdotes);
    html += renderContribute(topSoldier);

    container.innerHTML = html;
  }

  function renderLetterGroup(letters) {
    var body = '<ul class="result-list">';
    letters.forEach(function (lt) {
      var meta      = [lt.date, lt.contributor].filter(Boolean).join(" · ");
      var mentioned = soldierNames(lt.contains, 3);
      var context   = mentioned.length ? "Soldiers: " + mentioned.join(", ") : "";
      body += '<li class="result-item">';
      body += '<a href="' + escHtml(lt.url) + '" class="result-link">';
      body += '<div class="result-photo result-photo--placeholder result-photo--square"><span>LE</span></div>';
      body += '<div class="result-body">';
      body += '<p class="result-name">' + escHtml(lt.name) + '</p>';
      if (meta)    body += '<p class="result-meta">' + escHtml(meta) + '</p>';
      if (context) body += '<p class="result-context">' + escHtml(context) + '</p>';
      else if (lt.excerpt) body += '<p class="result-excerpt">' + escHtml(truncate(lt.excerpt, 120)) + '</p>';
      body += '</div>';
      body += '</a>';
      body += '</li>';
    });
    body += '</ul>';
    return detailsWrap("Letters", letters.length, body);
  }

  function renderProfileGroup(soldiers) {
    var body = '<ul class="result-list">';

    soldiers.forEach(function (s) {
      var photo   = photoPath(s);
      var platoon = platoonShort(s.platoon);
      var meta    = [s.rank, platoon, s.hometown].filter(Boolean).join(" · ");

      body += '<li class="result-item">';
      body += '<a href="' + escHtml(s.url) + '" class="result-link">';

      if (photo) {
        body += '<div class="result-photo">';
        body += '<img src="' + escHtml(photo) + '" alt="' + escHtml(s.name) + '" loading="lazy" />';
        body += '</div>';
      } else {
        body += '<div class="result-photo result-photo--placeholder">';
        body += '<span>' + initials(s) + '</span>';
        body += '</div>';
      }

      body += '<div class="result-body">';
      body += '<p class="result-name">' + escHtml(s.name) + '</p>';
      if (meta) body += '<p class="result-meta">' + escHtml(meta) + '</p>';
      if (s.excerpt) body += '<p class="result-excerpt">' + escHtml(truncate(s.excerpt, 120)) + '</p>';

      // Photos button or contribute CTA — always shown
      if (s.photo_count > 0) {
        body += '<p class="result-photos">';
        body += '<a href="' + escHtml(s.url) + '#photos" class="result-photos-btn">';
        body += 'Photos (' + s.photo_count + ')';
        body += '</a></p>';
      } else {
        body += '<p class="result-photos">';
        body += '<a href="/contribute/?soldier=' + escHtml(s.slug) + '&amp;type=photos" class="result-photos-btn result-photos-btn--cta">';
        body += 'Have a photo of ' + escHtml(s.first_name || s.name) + '? Add it here';
        body += '</a></p>';
      }

      body += '</div>';
      body += '</a>';
      body += '</li>';
    });

    body += '</ul>';
    return detailsWrap("Profile", soldiers.length, body);
  }

  function renderEventGroup(events) {
    var body = '<ul class="result-list">';

    events.forEach(function (ev) {
      var meta      = [ev.date, ev.location].filter(Boolean).join(" · ");
      var mentioned = soldierNames(ev.contains, 3);
      var context   = mentioned.length ? "Soldiers: " + mentioned.join(", ") : "";

      body += '<li class="result-item">';
      body += '<a href="' + escHtml(ev.url) + '" class="result-link">';
      body += '<div class="result-photo result-photo--placeholder result-photo--square"><span>EV</span></div>';
      body += '<div class="result-body">';
      body += '<p class="result-name">' + escHtml(ev.name) + '</p>';
      if (meta)    body += '<p class="result-meta">' + escHtml(meta) + '</p>';
      if (context) body += '<p class="result-context">' + escHtml(context) + '</p>';
      else if (ev.excerpt) body += '<p class="result-excerpt">' + escHtml(truncate(ev.excerpt, 120)) + '</p>';
      body += '</div>';
      body += '</a>';
      body += '</li>';
    });

    body += '</ul>';
    return detailsWrap("Events", events.length, body);
  }

  function renderDocumentGroup(documents) {
    var body = '<ul class="result-list">';

    documents.forEach(function (doc) {
      var meta      = [doc.date, doc.contributor].filter(Boolean).join(" · ");
      var mentioned = soldierNames(doc.contains, 3);
      var context   = mentioned.length ? "Soldiers: " + mentioned.join(", ") : "";

      body += '<li class="result-item">';
      body += '<a href="' + escHtml(doc.url) + '" class="result-link">';
      body += '<div class="result-photo result-photo--placeholder result-photo--square"><span>DC</span></div>';
      body += '<div class="result-body">';
      body += '<p class="result-name">' + escHtml(doc.name) + '</p>';
      if (meta)    body += '<p class="result-meta">' + escHtml(meta) + '</p>';
      if (context) body += '<p class="result-context">' + escHtml(context) + '</p>';
      else if (doc.excerpt) body += '<p class="result-excerpt">' + escHtml(truncate(doc.excerpt, 120)) + '</p>';
      body += '</div>';
      body += '</a>';
      body += '</li>';
    });

    body += '</ul>';
    return detailsWrap("Documents", documents.length, body);
  }

  function renderAnecdoteGroup(anecdotes) {
    var body = '<ul class="result-list">';

    anecdotes.forEach(function (ac) {
      var meta      = ac.date || "";
      var mentioned = soldierNames(ac.contains, 3);
      var context   = mentioned.length ? "Soldiers: " + mentioned.join(", ") : "";

      body += '<li class="result-item">';
      body += '<a href="' + escHtml(ac.url) + '" class="result-link">';
      body += '<div class="result-photo result-photo--placeholder result-photo--square"><span>VA</span></div>';
      body += '<div class="result-body">';
      body += '<p class="result-name">' + escHtml(ac.name) + '</p>';
      if (meta)    body += '<p class="result-meta">' + escHtml(meta) + '</p>';
      if (context) body += '<p class="result-context">' + escHtml(context) + '</p>';
      else if (ac.excerpt) body += '<p class="result-excerpt">' + escHtml(truncate(ac.excerpt, 120)) + '</p>';
      body += '</div>';
      body += '</a>';
      body += '</li>';
    });

    body += '</ul>';
    return detailsWrap("Verbal Accounts", anecdotes.length, body);
  }

  function renderContribute(soldier) {
    var href, text;
    if (soldier) {
      href = "/contribute/?soldier=" + encodeURIComponent(soldier.slug);
      text = "Know something we’re missing about " + escHtml(soldier.name) + "? Contribute →";
    } else {
      href = "/contribute/";
      text = "Something missing from these results? Contribute →";
    }
    return '<div class="result-contribute"><a href="' + escHtml(href) + '">' + text + '</a></div>';
  }

  // ── Helpers ────────────────────────────────────────────────────────────────

  function escHtml(str) {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function truncate(str, len) {
    if (!str || str.length <= len) return str;
    return str.slice(0, len).replace(/\s+\S*$/, "") + "…";
  }

  function initials(s) {
    var f = s.first_name ? s.first_name[0] : "";
    var l = s.last_name  ? s.last_name[0]  : "";
    return (f + l).toUpperCase();
  }

  qs("#search-form").addEventListener("submit", function (e) {
    e.preventDefault();
    var q = qs("#search-input").value.trim();
    if (!q) return;

    var url = new URL(window.location.href);
    url.searchParams.set("q", q);
    history.pushState({}, "", url);

    runSearch(q);
  });

})();
</script>
