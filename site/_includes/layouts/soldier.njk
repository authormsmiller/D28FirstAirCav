  display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 16px;
}
.cr-modal-title {
  font-family: 'Bebas Neue', sans-serif; font-size: 22px; letter-spacing: 1px; color: var(--y);
}
.cr-close {
  background: none; border: none; color: var(--dim); font-size: 14px;
  cursor: pointer; padding: 0; line-height: 1; flex-shrink: 0; margin-left: 16px;
}
.cr-close:hover { color: #f0edd8; }
.cr-notice {
  font-family: 'Crimson Pro', serif; font-size: 15px; color: var(--dim);
  line-height: 1.65; margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #1e1e1c;
}
.cr-checkgroup { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 8px; }
.cr-check-label {
  display: flex; align-items: center; gap: 8px; cursor: pointer;
  font-family: 'Space Grotesk', sans-serif; font-size: 13px; color: var(--dim);
}
.cr-check-label input { accent-color: var(--y); width: 14px; height: 14px; }
.cr-actions { margin-top: 24px; padding-top: 24px; border-top: 1px solid #1e1e1c; }
.cr-submit {
