  font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  border: none; padding: 12px 24px; cursor: pointer; width: 100%;
}
.cr-submit:hover:not(:disabled) { background: var(--y2); }
.cr-submit:disabled { opacity: 0.5; cursor: not-allowed; }
.cr-success { text-align: center; padding: 16px 0; }
.cr-success-icon { font-size: 36px; color: var(--y); margin-bottom: 12px; line-height: 1; }
.cr-success-hed {
  font-family: 'Bebas Neue', sans-serif; font-size: 26px; color: #f0edd8; margin-bottom: 8px;
}
.cr-success-body {
  font-family: 'Crimson Pro', serif; font-size: 16px; color: var(--dim); line-height: 1.6;
}
.cr-error-msg {
  font-family: 'Crimson Pro', serif; font-size: 15px; color: #c0392b; margin-bottom: 16px;
}
/* Override req-label color for dark modal context */
.cr-modal .req-label {
  color: #c8c0a0;
}
</style>

<div class="cr-overlay" id="crOverlay" style="display:none" onclick="crOverlayClick(event)">
  <div class="cr-modal" role="dialog" aria-modal="true" aria-labelledby="crModalTitle">

    <div class="cr-modal-header">
      <div class="cr-modal-title" id="crModalTitle">Request Contact Information</div>
      <button class="cr-close" onclick="closeCrModal()" aria-label="Close">✕ CLOSE</button>
    </div>

    <div class="cr-notice">
      We hold veteran and family contact details in restricted access. Submit your
      request below — we'll review it and follow up with you directly.
    </div>

    <form id="crForm" onsubmit="submitContactRequest(event)" style="display:block">

      <input type="hidden" name="soldier_slug" value="{{ slug }}">
      <input type="hidden" name="soldier_name" value="{{ first_name }} {{ last_name }}">

      <div class="req-field-group">
        <div class="req-field">
          <label class="req-label" for="crName">Your name <span class="req-req">*</span></label>
          <input class="req-input" type="text" id="crName" name="submitter_name" required autocomplete="name">
        </div>
        <div class="req-field">
          <label class="req-label" for="crEmail">Email address <span class="req-req">*</span></label>
          <input class="req-input" type="email" id="crEmail" name="submitter_contact" required autocomplete="email">
        </div>
      </div>

      <div class="req-field">
        <label class="req-label" for="crPhone">Phone <span class="req-opt">(optional)</span></label>
        <input class="req-input" type="tel" id="crPhone" name="submitter_phone"
          autocomplete="tel" oninput="crTogglePhone(this.value)">
      </div>

      <div class="req-field" id="crPreferredWrap" style="display:none">
        <div class="req-label">Preferred contact method</div>
        <div class="cr-checkgroup">
          <label class="cr-check-label">
            <input type="checkbox" name="preferred_contact" value="text"> Text
          </label>
          <label class="cr-check-label">
            <input type="checkbox" name="preferred_contact" value="call"> Call
          </label>
          <label class="cr-check-label">
            <input type="checkbox" name="preferred_contact" value="email"> Email
          </label>
        </div>
      </div>

      <div class="req-field">
        <label class="req-label" for="crReason">Reason for request <span class="req-req">*</span></label>
        <select class="req-select" id="crReason" name="reason_category" required>
          <option value="">— Select —</option>
          <option value="Family member">Family member</option>
          <option value="Fellow veteran / family of">Fellow veteran or family of</option>
          <option value="Researcher">Researcher</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div class="req-field">
        <label class="req-label" for="crDetail">
          Additional detail <span class="req-opt">(optional)</span>
        </label>
        <textarea class="req-textarea" id="crDetail" name="reason_detail" rows="3"
          placeholder="Any context that helps us prioritize your request"></textarea>
      </div>

      <div class="cr-actions">
        <button class="cr-submit" type="submit" id="crSubmitBtn">Send Request</button>
      </div>

    </form>

    <div class="cr-success" id="crSuccess" style="display:none">
      <div class="cr-success-icon">✓</div>
      <div class="cr-success-hed">Request received.</div>
      <div class="cr-success-body">We'll review it and follow up with you directly.</div>
      <div class="cr-actions" style="border-top:none; padding-top:0; margin-top:24px;">
        <button class="cr-submit" onclick="closeCrModal()">Close</button>
      </div>
    </div>

    <div id="crError" style="display:none; margin-top:16px;">
      <div class="cr-error-msg" id="crErrorMsg"></div>
      <button class="cr-submit" onclick="crClearError()">Try again</button>
    </div>

  </div>
</div>

<div class="toast" id="toastEl"></div>
<div class="lightbox" id="lightbox" onclick="lbClose(event)">
  <div class="lb-inner">
    <button class="lb-close" onclick="lbClose()">✕ CLOSE</button>
    <img id="lb-img" src="" alt="">
    <div class="lb-cap">
      <div class="lb-cap-meta">
        <span id="lb-cap-date"></span>
        <span id="lb-counter"></span>
      </div>
      <p id="lb-cap-p"></p>
      <small id="lb-cap-s"></small>
      <button type="button" class="lb-suggest" onclick="event.stopPropagation(); pidpOpenFromLightbox()">✎ Suggest a correction</button>
    </div>
    <div class="lb-nav">
      <button id="lb-prev" class="lb-arrow" onclick="event.stopPropagation();lbPrev()">← PREV</button>
      <button id="lb-next" class="lb-arrow" onclick="event.stopPropagation();lbNext()">NEXT →</button>
    </div>
  </div>
</div>

<!-- ── Photo ID Proposal modal ───────────────────────────── -->
<div class="pidp-overlay" id="pidpOverlay" onclick="pidpClose(event)">
  <div class="pidp-modal" role="dialog" aria-modal="true" aria-labelledby="pidpTitle">
    <div class="pidp-header">
      <div class="pidp-title" id="pidpTitle">Help Us Get This Right</div>
      <button type="button" class="pidp-close" onclick="pidpClose()" aria-label="Close">✕</button>
    </div>
    <div class="pidp-body">
      <div class="pidp-ctx">
        <img class="pidp-ctx-thumb" id="pidpThumb" src="" alt="">
        <div>
          <div class="pidp-ctx-label">You're correcting</div>
          <div class="pidp-ctx-cap" id="pidpCtxCap"></div>
        </div>
      </div>

      <div class="pidp-field">
        <label>What can you help with? <span class="pidp-opt">(pick any)</span></label>
        <div class="pidp-chips">
          <button type="button" class="pidp-chip" data-block="who">👤 Who's in it</button>
          <button type="button" class="pidp-chip" data-block="caption">📝 The caption</button>
          <button type="button" class="pidp-chip" data-block="date">📅 When it was taken</button>
          <button type="button" class="pidp-chip" data-block="notes">💬 Something else</button>
        </div>
      </div>

      <div class="pidp-block" id="pidpBlock-who" hidden>
        <div class="pidp-block-hed">👤 Who's in it</div>
        <div class="pidp-people" id="pidpPeople"></div>
        <div class="pidp-ta-wrap">
          <input type="text" class="pidp-input" id="pidpPersonInput" autocomplete="off" placeholder="Start typing a name…">
          <div class="pidp-ta-results" id="pidpTaResults" hidden></div>
        </div>
        <div class="pidp-help">Pick from the roster, or add a name we don't have yet.</div>
      </div>

      <div class="pidp-block" id="pidpBlock-caption" hidden>
        <div class="pidp-block-hed">📝 The caption</div>
        <div class="pidp-current" id="pidpCurrentCap"></div>
        <textarea class="pidp-textarea" id="pidpCaption" placeholder="What it should say…"></textarea>
      </div>

      <div class="pidp-block" id="pidpBlock-date" hidden>
        <div class="pidp-block-hed">📅 When it was taken</div>
        <div class="pidp-current" id="pidpCurrentDate"></div>
        <input type="text" class="pidp-input" id="pidpDate" placeholder="e.g. March 1972, or spring 1972">
        <label class="pidp-toggle-row"><input type="checkbox" id="pidpDateApprox" checked> This date is approximate</label>
      </div>

      <div class="pidp-block" id="pidpBlock-notes" hidden>
        <div class="pidp-block-hed">💬 Something else</div>
        <textarea class="pidp-textarea" id="pidpNotes" placeholder="Location, what's happening, how photos relate…"></textarea>
      </div>

      <hr class="pidp-divider">

      <div class="pidp-field">
        <label>How do you know? <span class="pidp-opt">(optional, but it helps)</span></label>
        <input type="text" class="pidp-input" id="pidpSource" placeholder='e.g. "I was there" · "my dad&apos;s album"'>
      </div>
      <div class="pidp-row">
        <div class="pidp-field">
          <label>Your name <span class="pidp-opt">(optional)</span></label>
          <input type="text" class="pidp-input" id="pidpName" placeholder="So we can credit / follow up">
        </div>
        <div class="pidp-field">
          <label>How to reach you <span class="pidp-opt">(optional)</span></label>
          <input type="text" class="pidp-input" id="pidpContact" placeholder="Phone or email">
        </div>
      </div>
      <input type="text" id="pidpHp" class="pidp-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    </div>
    <div class="pidp-footer">
      <button type="button" class="pidp-submit" id="pidpSubmit" onclick="pidpSubmit()">Submit for Review →</button>
      <div class="pidp-note" id="pidpFootNote">Nothing changes on the site right away — every suggestion is reviewed first.</div>
    </div>
  </div>
</div>

<script src="/assets/js/main.js"></script>
<script src="/assets/js/photo-proposal.js"></script>

<script>
function activateTab(name) {
  var matchingTab = document.querySelector('.tab[data-tab="' + name + '"]');
  if (!matchingTab) return;
  document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(c) { c.style.display = 'none'; });
  matchingTab.classList.add('active');
  var target = document.getElementById('tab-' + name);
  if (target) target.style.display = 'block';
}

document.querySelectorAll('.tab').forEach(function(tab) {
  tab.addEventListener('click', function() {
    activateTab(tab.dataset.tab);
    history.replaceState(null, '', '#' + tab.dataset.tab);
  });
});

// Deep-link: activate tab from URL hash on load
(function() {
  var hash = window.location.hash.replace('#', '');
  if (hash) activateTab(hash);
})();

// ── Contact request modal ─────────────────────────────────────────────────

function openContactModal() {
  var overlay = document.getElementById('crOverlay');
  overlay.style.display = 'flex';
  document.body.style.overflow = 'hidden';
  // Reset to form state each time it's opened
  document.getElementById('crForm').style.display = 'block';
  document.getElementById('crSuccess').style.display = 'none';
  document.getElementById('crError').style.display = 'none';
  document.getElementById('crSubmitBtn').disabled = false;
  document.getElementById('crSubmitBtn').textContent = 'Send Request';
}

function crOverlayClick(e) {
  if (e.target === document.getElementById('crOverlay')) closeCrModal();
}

function closeCrModal() {
  document.getElementById('crOverlay').style.display = 'none';
  document.body.style.overflow = '';
}

function crTogglePhone(val) {
  document.getElementById('crPreferredWrap').style.display = val.trim() ? 'block' : 'none';
}

async function submitContactRequest(e) {
  e.preventDefault();
  var btn = document.getElementById('crSubmitBtn');
  btn.disabled = true;
  btn.textContent = 'Sending…';

  var form = document.getElementById('crForm');
  var fd = new FormData(form);
  var data = {};
  fd.forEach(function(v, k) {
    if (k === 'preferred_contact') {
      if (!data[k]) data[k] = [];
      data[k].push(v);
    } else {
      if (v !== '') data[k] = v;
    }
  });

  var payload = Object.assign({ type: 'contact' }, data, {
    page_url:     window.location.href,
    referrer_url: document.referrer || null,
  });

  try {
    var res = await fetch('/submit/request', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(payload),
    });
    if (!res.ok) throw new Error('Server error ' + res.status);
    document.getElementById('crForm').style.display = 'none';
    document.getElementById('crError').style.display = 'none';
    document.getElementById('crSuccess').style.display = 'block';
  } catch (err) {
    document.getElementById('crErrorMsg').textContent =
      'Something went wrong. Please try again, or email admin@angryskipperarchive.org directly.';
    document.getElementById('crError').style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Send Request';
  }
}

function crClearError() {
  document.getElementById('crError').style.display = 'none';
  document.getElementById('crSubmitBtn').disabled = false;
  document.getElementById('crSubmitBtn').textContent = 'Send Request';
}
</script>

