<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ first_name }} {{ last_name }} — {{ site.title }}</title>
<meta name="description" content="Service profile for {{ rank }} {{ first_name }} {{ last_name }}, {{ platoon }}, D Co. 2/8 CAV.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/main.css">
</head>
<body{% if status %} class="status-{{ status }}"{% endif %}>

{% include "partials/masthead.njk" %}

<div class="breadcrumb show">
  <a class="bc-link" href="/">Archive</a>
  <span class="bc-sep">›</span>
  <a class="bc-link" href="/roster/">Roster</a>
  <span class="bc-sep">›</span>
  <span>{{ rank }} {{ first_name }} {{ last_name }}</span>
</div>

<main>

{# ── PROFILE HERO ── #}
<div class="prof-hero">

  {# Resolve profile photo: crawler data takes precedence over front matter field #}
  {% set _crawlerProfile = photosBySlug[slug].profile[0] if (photosBySlug[slug] and photosBySlug[slug].profile and photosBySlug[slug].profile.length) else null %}
  {% if _crawlerProfile %}
    {% set _heroPhotoSrc = "/media/photos/soldiers/" + slug + "/profile/" + _crawlerProfile.filename %}
  {% elif profile_photo %}
    {% set _heroPhotoSrc = "/media/photos/soldiers/" + slug + "/profile/" + profile_photo %}
  {% else %}
    {% set _heroPhotoSrc = null %}
  {% endif %}

  {# Photo column #}
  <div class="prof-photo-col">
    <div class="prof-photo-frame">
      {% if _heroPhotoSrc %}
        <img
          src="{{ _heroPhotoSrc }}"
          alt="{{ first_name }} {{ last_name }}"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
        >
      {% endif %}
      <div class="prof-photo-placeholder" {% if _heroPhotoSrc %}style="display:none"{% endif %}>
        {{ first_name[0] }}{{ last_name[0] }}
      </div>
    </div>
    {% if status in ["kia", "dow", "mia"] %}
    <div class="prof-kia-star">★</div>
    {% endif %}
    {% if remains == "not_recovered" %}
    <div class="prof-mia-banner" role="note" aria-label="Missing in Action — body not recovered">
      <span class="prof-mia-tag">MIA</span>
      <span class="prof-mia-sub">Body Not Recovered</span>
    </div>
    {% endif %}
  </div>

  {# Info column #}
  <div class="prof-info">

    <div class="prof-name">{{ first_name }}<br>{{ last_name }}</div>
    <div class="prof-rank">{{ rank }} &nbsp;·&nbsp; {{ platoon }} &nbsp;·&nbsp; {{ mos }}</div>

    {% if status in ["kia", "dow", "mia"] %}
    <div class="prof-kia-line">{{ status | upper }}{% if departed %} · {{ departed }}{% endif %}</div>
    {% endif %}

    {% if nickname %}
      <div class="prof-nickname">Known as <span class="prof-nickname-val">"{{ nickname }}"</span></div>
    {% endif %}

    <div class="prof-grid">
      <div class="pg-item">
        <div class="pg-label">In-Country Service</div>
        <div class="pg-value">{{ arrived }} – {{ departed }}</div>
      </div>
      <div class="pg-item">
        <div class="pg-label">Home of Record</div>
        <div class="pg-value">{{ hometown }}</div>
      </div>
      <div class="pg-item">
        <div class="pg-label">Character of Service</div>
        <div class="pg-value">{{ character_of_service | default("Honorable") }}</div>
      </div>
      <div class="pg-item">
        <div class="pg-label">Archive Status</div>
        <div class="pg-value">{{ archive_status | default("Active") }}</div>
      </div>
    </div>

    <div class="prof-actions">
      <a class="prof-btn prof-btn-primary" href="/contribute/">Share a Memory</a>
      {% if family_contact %}
        <button class="prof-btn prof-btn-ghost" onclick="openContactModal()">Family Contact on File</button>
      {% endif %}
    </div>

  </div>
</div>

{# ── TAB COUNTS ──
   Computed once here, before the tab bar, so each tab can show "(n)" records
   behind it — e.g. "Photos (10)", "Documents (0)". A zero count is shown
   deliberately rather than hidden: an empty tab is a signal the archive still
   needs something for this person, the same way a missing profile photo or a
   wrong rank was a signal for McGrew to reach out. This logic mirrors — but
   is kept separate (tc_ prefix) from — the per-tab computations further down
   this file, so it doesn't disturb that already-tested rendering code.
   External Resources is the one deliberate exception: it keeps hiding
   entirely when empty rather than showing "(0)" — a soldier having no Wall
   of Faces entry or outside link isn't a research gap the way an empty
   Photos or Timeline tab is. #}

{% set tc_coveredEvents = [] %}
{% if timeline %}
  {% for entry in timeline %}
    {% if entry.event_slug %}{% set tc_coveredEvents = (tc_coveredEvents.push(entry.event_slug), tc_coveredEvents) %}{% endif %}
  {% endfor %}
{% endif %}
{% set tc_injectedEvents = [] %}
{% for event in collections.events %}
  {% if event.data.status == "published" %}
    {% set tc_matched = false %}
    {% if event.data.casualties %}
      {% for tier in ["kia","dow","wia","mia"] %}
        {% if event.data.casualties[tier] %}
          {% for p in event.data.casualties[tier] %}
            {% set pSlug = p.slug if p.slug else p %}
            {% if pSlug == slug %}{% set tc_matched = true %}{% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if event.data.contains %}
      {% for p in event.data.contains %}
        {% set pSlug = p.slug if p.slug else p %}
        {% if pSlug == slug %}{% set tc_matched = true %}{% endif %}
      {% endfor %}
    {% endif %}
    {% if event.data.tagged %}
      {% for p in event.data.tagged %}
        {% set pSlug = p.slug if p.slug else p %}
        {% if pSlug == slug %}{% set tc_matched = true %}{% endif %}
      {% endfor %}
    {% endif %}
    {% if tc_matched and not (event.data.slug in tc_coveredEvents) %}
      {% set tc_injectedEvents = (tc_injectedEvents.push(event), tc_injectedEvents) %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set timelineCount = (timeline.length if timeline else 0) + tc_injectedEvents.length %}

{% set tc_crawlerEntry = photosBySlug[slug] %}
{% set tc_allPhotos = [] %}
{% if tc_crawlerEntry %}
  {% for subfolderKey, photoArr in tc_crawlerEntry %}
    {% for p in photoArr %}{% set tc_allPhotos = (tc_allPhotos.push(p), tc_allPhotos) %}{% endfor %}
  {% endfor %}
{% else %}
  {% set tc_allPhotos = photos if photos else [] %}
{% endif %}
{% set tc_photosOfMe = [] %}
{% if photosBySlug.byContains and photosBySlug.byContains[slug] %}
  {% for photo in photosBySlug.byContains[slug] %}
    {% if photo.photographer != slug %}{% set tc_photosOfMe = (tc_photosOfMe.push(photo), tc_photosOfMe) %}{% endif %}
  {% endfor %}
{% endif %}
{% set tc_photosByMe = [] %}
{% for photo in tc_allPhotos %}
  {% if photo.photographer == slug %}{% set tc_photosByMe = (tc_photosByMe.push(photo), tc_photosByMe) %}{% endif %}
{% endfor %}
{% set tc_relatedPhotos = photosBySlug.byTagged[slug] if (photosBySlug.byTagged and photosBySlug.byTagged[slug]) else [] %}
{% set photosCount = tc_photosOfMe.length + tc_photosByMe.length + tc_relatedPhotos.length %}

{% set tc_t1 = alongside[slug].tier1 if alongside[slug] else [] %}
{% set tc_t2 = alongside[slug].tier2 if alongside[slug] else [] %}
{% set tc_t3 = alongside[slug].tier3 if alongside[slug] else [] %}
{% set tc_t4 = alongside[slug].tier4 if alongside[slug] else [] %}
{% set alongsideCount = tc_t1.length + tc_t2.length + tc_t3.length + tc_t4.length %}

{% set tc_soldierAnecdotes = [] %}
{% for anecdote in collections.anecdotes %}
  {% if anecdote.data.contains and slug in anecdote.data.contains %}{% set tc_soldierAnecdotes = tc_soldierAnecdotes.concat([anecdote]) %}{% endif %}
{% endfor %}
{% set tc_soldierDocs = documentsBySlug[slug] %}
{% set tc_verbalDocs = [] %}
{% set tc_referencedVerbalDocs = [] %}
{% if tc_soldierDocs %}
  {% for doc in tc_soldierDocs.authored %}{% if doc.type == "verbal" %}{% set tc_verbalDocs = tc_verbalDocs.concat([doc]) %}{% endif %}{% endfor %}
  {% for doc in tc_soldierDocs.referenced %}{% if doc.type == "verbal" %}{% set tc_referencedVerbalDocs = tc_referencedVerbalDocs.concat([doc]) %}{% endif %}{% endfor %}
{% endif %}
{% set accountsCount = tc_soldierAnecdotes.length + tc_verbalDocs.length + tc_referencedVerbalDocs.length %}

{% set tc_authored = [] %}
{% if tc_soldierDocs %}
  {% for doc in tc_soldierDocs.authored %}{% if doc.type != "letter" and doc.type != "verbal" %}{% set tc_authored = tc_authored.concat([doc]) %}{% endif %}{% endfor %}
{% endif %}
{% set tc_referenced = tc_soldierDocs.referenced if tc_soldierDocs else [] %}
{% set tc_tagged = tc_soldierDocs.tagged if tc_soldierDocs else [] %}
{% set documentsCount = tc_authored.length + tc_referenced.length + tc_tagged.length %}

{% set tc_soldierLetters = [] %}
{% for letter in collections.letters %}
  {% if letter.data.contains and slug in letter.data.contains %}{% set tc_soldierLetters = tc_soldierLetters.concat([letter]) %}{% endif %}
{% endfor %}
{% set lettersCount = tc_soldierLetters.length %}

{% set externalCount = (1 if (links and links.wall) else 0) + (links.other.length if (links and links.other) else 0) %}

{# ── TAB BAR ── #}
<div class="tabs-bar">
  <div class="tab active" data-tab="timeline">Timeline <span class="tab-count">({{ timelineCount }})</span></div>
  <div class="tab" data-tab="photos">Photos <span class="tab-count">({{ photosCount }})</span></div>
  <div class="tab" data-tab="alongside">Served alongside <span class="tab-count">({{ alongsideCount }})</span></div>
  <div class="tab" data-tab="accounts">Verbal accounts <span class="tab-count">({{ accountsCount }})</span></div>
  <div class="tab" data-tab="documents">Documents <span class="tab-count">({{ documentsCount }})</span></div>
  <div class="tab" data-tab="letters">Letters <span class="tab-count">({{ lettersCount }})</span></div>
  <div class="tab" data-tab="service">Service record <span class="tab-count">(1)</span></div>
  {% if links and (links.wall or (links.other and links.other.length)) %}<div class="tab" data-tab="external">External resources <span class="tab-count">({{ externalCount }})</span></div>{% endif %}
</div>

{# ── TAB: TIMELINE ── #}
<div class="tab-content" id="tab-timeline">
  {# ── Build event-injected entries from collections.events ── #}
  {# Events already covered by a hand-authored timeline entry (entry.event_slug) are skipped to avoid duplicates #}
  {% set coveredEvents = [] %}
  {% if timeline %}
    {% for entry in timeline %}
      {% if entry.event_slug %}{% set coveredEvents = (coveredEvents.push(entry.event_slug), coveredEvents) %}{% endif %}
    {% endfor %}
  {% endif %}
  {% set injectedEvents = [] %}
  {% for event in collections.events %}
    {% if event.data.status == "published" %}
      {% set matched = false %}
      {% set matchTier = "" %}

      {# Check casualties (all sub-arrays) #}
      {% if event.data.casualties %}
        {% for tier in ["kia","dow","wia","mia"] %}
          {% if event.data.casualties[tier] %}
            {% for p in event.data.casualties[tier] %}
              {% set pSlug = p.slug if p.slug else p %}
              {% if pSlug == slug %}{% set matched = true %}{% set matchTier = "casualty" %}{% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endif %}

      {# Check contains #}
      {% if event.data.contains %}
        {% for p in event.data.contains %}
          {% set pSlug = p.slug if p.slug else p %}
          {% if pSlug == slug %}{% set matched = true %}{% set matchTier = "confirmed" %}{% endif %}
        {% endfor %}
      {% endif %}

      {# Check tagged #}
      {% if event.data.tagged %}
        {% for p in event.data.tagged %}
          {% set pSlug = p.slug if p.slug else p %}
          {% if pSlug == slug %}{% set matched = true %}{% set matchTier = "probable" %}{% endif %}
        {% endfor %}
      {% endif %}

      {% if matched and not (event.data.slug in coveredEvents) %}
        {% set injectedEvents = (injectedEvents.push({
          date: event.data.date,
          headline: event.data.title,
          body: event.data.location if event.data.location else "",
          type: "event",
          tier: matchTier,
          url: event.url
        }), injectedEvents) %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% set hasTimeline = (timeline and timeline.length) or injectedEvents.length %}

  {% if hasTimeline %}
    {% if timeline_source %}
      <p class="timeline-intro">{{ timeline_source }}</p>
    {% endif %}
    <div class="tl">

      {# ── Unified chronological timeline ──
         Hand-authored entries and event-injected entries are merged and
         sorted by date here (rather than hand-authored-then-injected, which
         stranded auto-injected entries at the bottom regardless of when
         they actually happened). mergeTimeline normalizes both ISO and
         prose date formats before sorting — see timelineSortKey in
         .eleventy.js. #}
      {% set mergedTimeline = timeline | mergeTimeline(injectedEvents) %}
      {% for entry in mergedTimeline %}
        {% if entry._source == "hand" %}
          <div class="tl-entry">
            <div class="tl-dot {{ entry.type | default('move') }}"></div>
            <div class="tl-date">{{ entry.date }}</div>
            {% if entry.tags %}
              {% for tag in entry.tags %}
                <span class="tl-tag tl-tag-{{ tag.type }}">{{ tag.label }}</span>
              {% endfor %}
            {% endif %}
            {% if entry.event_slug %}
              <div class="tl-hed"><a href="/events/{{ entry.event_slug }}/" style="color:inherit;">{{ entry.headline }}</a></div>
            {% else %}
              <div class="tl-hed">{{ entry.headline }}</div>
            {% endif %}
            <div class="tl-body">{{ entry.body }}</div>
            {% if entry.source_notice %}
              <div class="source-notice">
                <div class="sn-head">⚠ Source Notice — Multiple Accounts Exist</div>
                <div class="sn-body">{{ entry.source_notice }}</div>
              </div>
            {% endif %}
          </div>
        {% else %}
          <div class="tl-entry">
            <div class="tl-dot event"></div>
            <div class="tl-date">{{ entry.date }}</div>
            <span class="tl-tag tl-tag-{{ entry.tier }}">
              {% if entry.tier == "casualty" %}Casualty record
              {% elif entry.tier == "confirmed" %}Confirmed present
              {% elif status == "kia" or status == "dow" or status == "mia" %}Commemorated
              {% else %}Probably present
              {% endif %}
            </span>
            <div class="tl-hed">
              <a href="{{ entry.url }}" style="color:inherit;">{{ entry.headline }}</a>
            </div>
            {% if entry.body %}
              <div class="tl-body">{{ entry.body }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

    </div>
  {% else %}
    <div class="tab-empty">
      No timeline on record yet.<br>
      <a href="/contribute/">Know something about {{ first_name }}'s service? Tell us →</a>
    </div>
  {% endif %}
</div>
{# ── TAB: PHOTOS ── #}
<div class="tab-content" id="tab-photos" style="display:none">

  {#
    Own photos — flatten all subfolders into allPhotos.
    Used as the source for Gallery 2 (photos taken by this soldier).
    Fallback to front matter photos array if no index.md files exist yet.
  #}
  {# Iterate every subfolder key the crawler produced (profile, field,
     field/events, and any locations/[loc-slug] keys — one per FSB/location
     a contributor has photos filed under) rather than hardcoding a fixed
     list. The hardcoded profile/field/field-events list previously missed
     locations/* entirely, so any photo filed under photos/locations/[slug]/
     could never appear in Gallery 2 even with photographer set correctly. #}
  {% set crawlerEntry = photosBySlug[slug] %}
  {% set allPhotos = [] %}
  {% if crawlerEntry %}
    {% for subfolderKey, photoArr in crawlerEntry %}
      {% for p in photoArr %}{% set allPhotos = (allPhotos.push(p), allPhotos) %}{% endfor %}
    {% endfor %}
  {% else %}
    {% set allPhotos = photos %}
  {% endif %}

  {#
    Gallery 1 — "Photos of [First]"
    Source: byContains reverse map — every photo in the archive where this
    soldier's slug appears in contains:, EXCEPT photos he took himself
    (photographer == slug). Those are selfies and belong in Gallery 2.
    Covers own collection + any other soldier's folder automatically.
  #}
  {% set photosOfMe = [] %}
  {% if photosBySlug.byContains and photosBySlug.byContains[slug] %}
    {% for photo in photosBySlug.byContains[slug] %}
      {% if photo.photographer != slug %}
        {% set photosOfMe = (photosOfMe.push(photo), photosOfMe) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {#
    Gallery 2 — "Photos Taken By [First]"
    Source: own photos only, where photographer == slug.
    Includes photos with no soldiers in the frame (he's behind the camera)
    and selfies (photographer == slug AND slug also in contains).
    Hidden entirely if no photos qualify.
  #}
  {% set photosByMe = [] %}
  {% for photo in allPhotos %}
    {% if photo.photographer == slug %}
      {% set photosByMe = (photosByMe.push(photo), photosByMe) %}
    {% endif %}
  {% endfor %}

  {#
    Gallery 3 — "Related Photographs"
    Source: byTagged reverse map — photos where this soldier has a meaningful,
    documentable connection but does not appear in the frame.
    Displayed after Galleries 1 and 2 so wreckage/aftermath follows the person.
  #}
  {% set relatedPhotos = [] %}
  {% if photosBySlug.byTagged and photosBySlug.byTagged[slug] %}
    {% set relatedPhotos = photosBySlug.byTagged[slug] %}
  {% endif %}

  {% if photosOfMe.length or photosByMe.length or relatedPhotos.length %}

    {% if photo_intro %}
      <p class="timeline-intro" style="font-style:italic;">{{ photo_intro }}</p>
    {% endif %}

    {# ── Gallery 1: Photos of [First] ── #}
    {% if photosOfMe.length %}
    <script>
      var PHOTO_SLIDES_1 = [
        {% for photo in photosOfMe %}
        {
          src: {{ photo.url | dump | safe }},
          caption: {{ (photo.caption or photo.caption_short or photo.filename) | dump | safe }},
          credit: {{ (photo.credit or "") | dump | safe }},
          date: {{ (photo.date or "") | dump | safe }},
          soldier_slug: {{ photo.soldier_slug | dump | safe }},
          subfolder: {{ photo.subfolder | dump | safe }},
          filename: {{ photo.filename | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ];
    </script>
    <div class="gallery-sublabel">Photos of {{ first_name }}</div>
    <div class="photo-grid">
      {% for photo in photosOfMe %}
        <div class="photo-card {{ 'wide' if photo.wide }}"
             onclick="lbOpen({{ loop.index0 }}, PHOTO_SLIDES_1)">
          <img src="{{ photo.url }}"
               alt="{{ photo.caption_short if photo.caption_short else photo.filename }}"
               loading="lazy">
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {# ── Gallery 2: Photos Taken By [First] — hidden if empty ── #}
    {% if photosByMe.length %}
    <script>
      var PHOTO_SLIDES_2 = [
        {% for photo in photosByMe %}
        {
          src: {{ photo.url | dump | safe }},
          caption: {{ (photo.caption or photo.caption_short or photo.filename) | dump | safe }},
          credit: {{ (photo.credit or "") | dump | safe }},
          date: {{ (photo.date or "") | dump | safe }},
          soldier_slug: {{ photo.soldier_slug | dump | safe }},
          subfolder: {{ photo.subfolder | dump | safe }},
          filename: {{ photo.filename | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ];
    </script>
    <div class="gallery-sublabel">Photos Taken by {{ first_name }}</div>
    <div class="photo-grid">
      {% for photo in photosByMe %}
        <div class="photo-card {{ 'wide' if photo.wide }}"
             onclick="lbOpen({{ loop.index0 }}, PHOTO_SLIDES_2)">
          <img src="{{ photo.url }}"
               alt="{{ photo.caption_short if photo.caption_short else photo.filename }}"
               loading="lazy">
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {# ── Gallery 3: Related Photographs — hidden if empty ── #}
    {% if relatedPhotos.length %}
    <script>
      var PHOTO_SLIDES_3 = [
        {% for photo in relatedPhotos %}
        {
          src: {{ photo.url | dump | safe }},
          caption: {{ (photo.caption or photo.caption_short or photo.filename) | dump | safe }},
          credit: {{ (photo.credit or "") | dump | safe }},
          date: {{ (photo.date or "") | dump | safe }},
          soldier_slug: {{ photo.soldier_slug | dump | safe }},
          subfolder: {{ photo.subfolder | dump | safe }},
          filename: {{ photo.filename | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ];
    </script>
    <div class="gallery-sublabel">Related Photographs</div>
    <p class="timeline-intro" style="font-style:italic;">These photographs are connected to {{ first_name }}'s service but do not show {{ first_name }} directly.</p>
    <div class="photo-grid">
      {% for photo in relatedPhotos %}
        <div class="photo-card {{ 'wide' if photo.wide }}"
             onclick="lbOpen({{ loop.index0 }}, PHOTO_SLIDES_3)">
          <img src="{{ photo.url }}"
               alt="{{ photo.caption_short if photo.caption_short else photo.filename }}"
               loading="lazy">
        </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if wartime_content_notice %}
      <div class="content-notice">
        <div>
          <strong>Note on Wartime Content</strong>
          <p>This gallery includes photographs taken in a combat zone. Some images depict the realities of war. They are preserved here as historical documentation.</p>
        </div>
      </div>
    {% endif %}

  {% else %}
    <div class="tab-empty">
      No photographs on record yet.<br>
      <a href="/contribute/">Have a photo to contribute? →</a>
    </div>
  {% endif %}
</div>

{# ── TAB: SERVED ALONGSIDE ── #}
{#
  Data source: site/_data/alongside.js
  alongside[slug] = { tier1: [], tier2: [], tier3: [], tier4: [] }

  Tier 1 — auto-detected from photo/document contains[] arrays (build-time, never persisted)
  Tier 2 — same-platoon manual links (from _alongside.json or relationships.json)
  Tier 3 — broader peer links: verbal-account, same-company/tour, etc.
  Tier 4 — commanding officer: the battalion LTC ("Stone Mountain 6")

  Admin tool writes to soldiers/{slug}/_alongside.json for Tier 2/3/4 entries.
  Empty state: always show tab; display "Researching connections..." when no data.
#}
<div class="tab-content" id="tab-alongside" style="display:none">

  {# ── Pull tiers from data (default to empty arrays if soldier has no entry) ── #}
  {% set t1 = alongside[slug].tier1 if alongside[slug] else [] %}
  {% set t2 = alongside[slug].tier2 if alongside[slug] else [] %}
  {% set t3 = alongside[slug].tier3 if alongside[slug] else [] %}
  {% set t4 = alongside[slug].tier4 if alongside[slug] else [] %}

  {% if t1.length or t2.length or t3.length or t4.length %}

    {# ── Tier 4: Commanding officer — the battalion LTC ("Stone Mountain 6") ── #}
    {% if t4.length %}
      <details class="alongside-section" open>
        <summary>
          <span class="alongside-tier-heading">Commanding officer &mdash; &ldquo;Stone Mountain 6&rdquo;</span>
          <span class="alongside-count">{{ t4.length }}</span>
        </summary>
        <table class="rtable">
          <thead><tr><th>Name</th><th>Role</th><th>Notes</th></tr></thead>
          <tbody>
          {% for rel in t4 %}
            {% set op = null %}
            {% for page in collections.all %}{% if page.data.slug == rel.slug %}{% set op = page.data %}{% endif %}{% endfor %}
            <tr>
              <td><div class="rname"><a href="/soldiers/{{ rel.slug }}/">{% if op %}{% if op.rank %}{{ op.rank }} {% endif %}{{ op.last_name }}, {{ op.first_name }}{% else %}{{ rel.slug }}{% endif %}</a></div></td>
              <td><span class="plt-badge plt-hq">Battalion CO</span></td>
              <td>{{ rel.notes if rel.notes else "" }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </details>
    {% endif %}

    {# ── Tier 1: In the same photos or documents ── #}
    {% if t1.length %}
      <details class="alongside-section" open>
        <summary>
          <span class="alongside-tier-heading">In the same photos or documents</span>
          <span class="alongside-count">{{ t1.length }}</span>
        </summary>
        <div class="alongside-grid">
          {% for rel in t1 %}
            {% set op = null %}
            {% for page in collections.all %}{% if page.data.slug == rel.slug %}{% set op = page.data %}{% endif %}{% endfor %}
            {# Resolve card photo the same way the hero does: crawler data takes precedence over front matter #}
            {% set _relCrawlerProfile = photosBySlug[rel.slug].profile[0] if (photosBySlug[rel.slug] and photosBySlug[rel.slug].profile and photosBySlug[rel.slug].profile.length) else null %}
            {% if _relCrawlerProfile %}
              {% set _relPhotoSrc = "/media/photos/soldiers/" + rel.slug + "/profile/" + _relCrawlerProfile.filename %}
            {% elif op and op.profile_photo %}
              {% set _relPhotoSrc = "/media/photos/soldiers/" + rel.slug + "/profile/" + op.profile_photo %}
            {% else %}
              {% set _relPhotoSrc = null %}
            {% endif %}
            <div class="alongside-card">
              <a href="/soldiers/{{ rel.slug }}/" style="text-decoration:none;">
                <div class="alongside-photo">
                  {% if _relPhotoSrc %}
                    <img src="{{ _relPhotoSrc }}"
                         alt="{{ rel.slug }}" style="width:100%;height:100%;object-fit:cover;"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <span style="display:none">{% if op %}{{ op.first_name[0] }}{{ op.last_name[0] }}{% else %}?{% endif %}</span>
                  {% else %}
                    {% if op %}{{ op.first_name[0] }}{{ op.last_name[0] }}{% else %}?{% endif %}
                  {% endif %}
                </div>
              </a>
              <div class="alongside-name">
                <a href="/soldiers/{{ rel.slug }}/" style="color:inherit;text-decoration:none;">
                  {% if op %}{{ op.first_name }} {{ op.last_name }}{% else %}{{ rel.slug }}{% endif %}
                </a>
              </div>
              {% if op and op.platoon %}<div class="alongside-meta">{{ op.platoon }}</div>{% endif %}
            </div>
          {% endfor %}
        </div>
      </details>
    {% endif %}

    {# ── Tier 2: Same platoon — row list ── #}
    {% if t2.length %}
      <details class="alongside-section" open>
        <summary>
          <span class="alongside-tier-heading">Same platoon</span>
          <span class="alongside-count">{{ t2.length }}</span>
        </summary>
        <table class="rtable">
          <thead><tr><th>Name</th><th>Platoon</th><th>Notes</th></tr></thead>
          <tbody>
          {% for rel in t2 %}
            {% set op = null %}
            {% for page in collections.all %}{% if page.data.slug == rel.slug %}{% set op = page.data %}{% endif %}{% endfor %}
            {% set platoonKey = op.platoon | lower if op.platoon else "" %}
            <tr>
              <td><div class="rname"><a href="/soldiers/{{ rel.slug }}/">{% if op %}{% if op.rank %}{{ op.rank }} {% endif %}{{ op.last_name }}, {{ op.first_name }}{% else %}{{ rel.slug }}{% endif %}</a></div></td>
              <td>
                {% if op and op.platoon %}
                  {% if "cat" in platoonKey %}<span class="plt-badge plt-cat">Cat</span>
                  {% elif "range" in platoonKey %}<span class="plt-badge plt-range">Range</span>
                  {% elif "recon" in platoonKey %}<span class="plt-badge plt-recon">Recon</span>
                  {% elif "hq" in platoonKey or "skipper" in platoonKey %}<span class="plt-badge plt-hq">HQ</span>
                  {% else %}<span class="plt-badge plt-other">{{ op.platoon }}</span>{% endif %}
                {% endif %}
              </td>
              <td>{{ rel.notes if rel.notes else "" }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </details>
    {% endif %}

    {# ── Tier 3: Also in the company — row list, collapsed by default ── #}
    {% if t3.length %}
      <details class="alongside-section">
        <summary>
          <span class="alongside-tier-heading">Also in the company</span>
          <span class="alongside-count">{{ t3.length }}</span>
        </summary>
        <table class="rtable">
          <thead><tr><th>Name</th><th>Platoon</th><th>Notes</th></tr></thead>
          <tbody>
          {% for rel in t3 %}
            {% set op = null %}
            {% for page in collections.all %}{% if page.data.slug == rel.slug %}{% set op = page.data %}{% endif %}{% endfor %}
            {% set platoonKey = op.platoon | lower if op.platoon else "" %}
            <tr>
              <td><div class="rname"><a href="/soldiers/{{ rel.slug }}/">{% if op %}{% if op.rank %}{{ op.rank }} {% endif %}{{ op.last_name }}, {{ op.first_name }}{% else %}{{ rel.slug }}{% endif %}</a></div></td>
              <td>
                {% if op and op.platoon %}
                  {% if "cat" in platoonKey %}<span class="plt-badge plt-cat">Cat</span>
                  {% elif "range" in platoonKey %}<span class="plt-badge plt-range">Range</span>
                  {% elif "recon" in platoonKey %}<span class="plt-badge plt-recon">Recon</span>
                  {% elif "hq" in platoonKey or "skipper" in platoonKey %}<span class="plt-badge plt-hq">HQ</span>
                  {% else %}<span class="plt-badge plt-other">{{ op.platoon }}</span>{% endif %}
                {% endif %}
              </td>
              <td>{{ rel.notes if rel.notes else "" }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </details>
    {% endif %}

    {# ── Contribute prompt ── #}
    <div style="margin-top:0.5rem;font-size:0.85rem;color:var(--dim);">
      Know someone else who served alongside {{ first_name }}?
      <a href="/contribute/">Tell us →</a>
    </div>

  {% else %}
    <div class="tab-empty">
      Researching connections…<br>
      <a href="/contribute/">Know someone who served alongside {{ first_name }}? Tell us →</a>
    </div>
  {% endif %}

</div>

{# ── TAB: VERBAL ACCOUNTS ── #}
<div class="tab-content" id="tab-accounts" style="display:none">

  {# ── Archive-assembled anecdotes (collections.anecdotes) ── #}
  {% set soldierAnecdotes = [] %}
  {% for anecdote in collections.anecdotes %}
    {% if anecdote.data.contains and slug in anecdote.data.contains %}
      {% set soldierAnecdotes = soldierAnecdotes.concat([anecdote]) %}
    {% endif %}
  {% endfor %}

  {# ── First-person verbal documents (documentsBySlug crawler) ── #}
  {% set verbalDocs = [] %}
  {% set referencedVerbalDocs = [] %}
  {% set soldierDocs = documentsBySlug[slug] %}
  {% if soldierDocs %}
    {% for doc in soldierDocs.authored %}
      {% if doc.type == "verbal" %}
        {% set verbalDocs = verbalDocs.concat([doc]) %}
      {% endif %}
    {% endfor %}
    {% for doc in soldierDocs.referenced %}
      {% if doc.type == "verbal" %}
        {% set referencedVerbalDocs = referencedVerbalDocs.concat([doc]) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% if soldierAnecdotes.length or verbalDocs.length or referencedVerbalDocs.length %}

    {% if verbalDocs.length %}
      <div class="section-header">
        <div class="section-title" style="font-size:13px;">In {{ first_name }}'s Own Words</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ verbalDocs.length }} Account{% if verbalDocs.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for doc in verbalDocs %}
          <div class="doc-item">
            <div class="doc-icon">✍️</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="/documents/{{ doc.path }}/">{{ doc.title if doc.title else doc.slug }}</a>
              <div class="doc-meta">
                {% if doc.doc_date %}{{ doc.doc_date }}{% endif %}
                {% if not doc.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
              </div>
              {% if doc.source %}<div class="doc-meta">{{ doc.source }}</div>{% endif %}
            </div>
            <div class="doc-type">Verbal</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if referencedVerbalDocs.length %}
      <div class="section-header" {% if verbalDocs.length %}style="margin-top:24px;"{% endif %}>
        <div class="section-title" style="font-size:13px;">Accounts Mentioning {{ first_name }}</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ referencedVerbalDocs.length }} Account{% if referencedVerbalDocs.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for doc in referencedVerbalDocs %}
          <div class="doc-item">
            <div class="doc-icon">📜</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="/documents/{{ doc.path }}/">{{ doc.title if doc.title else doc.slug }}</a>
              <div class="doc-meta">
                {% if doc.date %}{{ doc.date }}{% endif %}
                {% if not doc.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
              </div>
              {% if doc.source %}<div class="doc-meta">{{ doc.source }}</div>{% endif %}
            </div>
            <div class="doc-type">Verbal</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if soldierAnecdotes.length %}
      <div class="section-header" {% if verbalDocs.length or referencedVerbalDocs.length %}style="margin-top:24px;"{% endif %}>
        <div class="section-title" style="font-size:13px;">Archive Accounts</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ soldierAnecdotes.length }} Account{% if soldierAnecdotes.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for anecdote in soldierAnecdotes %}
          <div class="doc-item">
            <div class="doc-icon">💬</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="{{ anecdote.data.permalink }}">{{ anecdote.data.title }}</a>
              <div class="doc-meta">{{ anecdote.data.date_approx }} · {{ anecdote.data.source_short }}</div>
              {% if anecdote.data.summary %}
                <div class="doc-meta" style="margin-top:0.25rem;">{{ anecdote.data.summary }}</div>
              {% endif %}
            </div>
            <div class="doc-type">{{ anecdote.data.type }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  {% else %}
    <div class="tab-empty">
      No verbal accounts on record.<br>
      <a href="/contribute/">Share a memory →</a>
    </div>
  {% endif %}
</div>

{# ── TAB: DOCUMENTS ── #}
<div class="tab-content" id="tab-documents" style="display:none">
  {% set soldierDocs = documentsBySlug[slug] %}

  {% if soldierDocs %}

    {# ── Authored by ── #}
    {% set authored = [] %}
    {% for doc in soldierDocs.authored %}
      {% if doc.type != "letter" and doc.type != "verbal" %}
        {% set authored = authored.concat([doc]) %}
      {% endif %}
    {% endfor %}
    {% if authored.length %}
      <div class="section-header">
        <div class="section-title" style="font-size:13px;">Authored by {{ first_name }}</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ authored.length }} Record{% if authored.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for doc in authored %}
          <div class="doc-item">
            <div class="doc-icon">📄</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="/documents/{{ doc.path }}/">{{ doc.title if doc.title else doc.slug }}</a>
              <div class="doc-meta">
                {{ doc.type }}
                {% if doc.doc_date %} · {{ doc.doc_date }}{% endif %}
                {% if not doc.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
              </div>
              {% if doc.source %}<div class="doc-meta">{{ doc.source }}</div>{% endif %}
            </div>
            <div class="doc-type">{{ doc.type }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Explicitly referenced ── #}
    {% set referenced = soldierDocs.referenced %}
    {% if referenced.length %}
      <div class="section-header" style="margin-top:24px;">
        <div class="section-title" style="font-size:13px;">Explicitly Referenced</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ referenced.length }} Record{% if referenced.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for doc in referenced %}
          <div class="doc-item">
            <div class="doc-icon">📄</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="/documents/{{ doc.path }}/">{{ doc.title if doc.title else doc.slug }}</a>
              <div class="doc-meta">
                {{ doc.type }}
                {% if doc.doc_date %} · {{ doc.doc_date }}{% endif %}
                {% if not doc.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
              </div>
              {% if doc.source %}<div class="doc-meta">{{ doc.source }}</div>{% endif %}
            </div>
            <div class="doc-type">{{ doc.type }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Tagged ── #}
    {% set tagged = soldierDocs.tagged %}
    {% if tagged.length %}
      <div class="section-header" style="margin-top:24px;">
        <div class="section-title" style="font-size:13px;">Also Present</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ tagged.length }} Record{% if tagged.length != 1 %}s{% endif %}</div>
      </div>
      <div class="doc-list">
        {% for doc in tagged %}
          <div class="doc-item">
            <div class="doc-icon">📄</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="/documents/{{ doc.path }}/">{{ doc.title if doc.title else doc.slug }}</a>
              <div class="doc-meta">
                {{ doc.type }}
                {% if doc.doc_date %} · {{ doc.doc_date }}{% endif %}
                {% if not doc.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
              </div>
              {% if doc.source %}<div class="doc-meta">{{ doc.source }}</div>{% endif %}
            </div>
            <div class="doc-type doc-type-tagged">Also present</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Nothing found ── #}
    {% if not authored.length and not referenced.length and not tagged.length %}
      <div class="tab-empty">
        No documents on record.<br>
        <a href="/contribute/">Have something to contribute? →</a>
      </div>
    {% endif %}

  {% else %}
    <div class="tab-empty">
      No documents on record.<br>
      <a href="/contribute/">Have something to contribute? →</a>
    </div>
  {% endif %}
</div>

{# ── TAB: LETTERS ── #}
<div class="tab-content" id="tab-letters" style="display:none">
  {% set soldierLetters = [] %}
  {% for letter in collections.letters %}
    {% if letter.data.contains and slug in letter.data.contains %}
      {% set soldierLetters = soldierLetters.concat([letter]) %}
    {% endif %}
  {% endfor %}

  {% if soldierLetters.length %}
    <div class="doc-list">
      {% for letter in soldierLetters | sortByData('doc_date') | reverse %}
        <div class="doc-item">
          <div class="doc-icon">✉️</div>
          <div style="flex:1;">
            <a class="doc-title doc-link" href="{{ letter.data.permalink }}">{{ letter.data.title if letter.data.title else letter.data.slug }}</a>
            <div class="doc-meta">
              {% if letter.data.doc_date %}{{ letter.data.doc_date }}{% endif %}
              {% if not letter.data.date_known %}<span class="doc-badge doc-badge-pending">Date unknown</span>{% endif %}
            </div>
            {% if letter.data.source %}<div class="doc-meta">{{ letter.data.source }}</div>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="tab-empty">
      No letters on record.<br>
      <a href="/contribute/">Have a letter to contribute? →</a>
    </div>
  {% endif %}
</div>

{# ── TAB: SERVICE RECORD ── #}
<div class="tab-content" id="tab-service" style="display:none">

  <div class="prof-grid" style="margin-bottom:24px;">
    <div class="pg-item">
      <div class="pg-label">MOS</div>
      <div class="pg-value">{{ mos }}</div>
    </div>
    <div class="pg-item">
      <div class="pg-label">Component</div>
      <div class="pg-value">{{ component | default("U.S. Army") }}</div>
    </div>
    <div class="pg-item">
      <div class="pg-label">Unit</div>
      <div class="pg-value">D Co. 2/8 CAV, 1st Air Cavalry Division</div>
    </div>
    <div class="pg-item">
      <div class="pg-label">Character of Service</div>
      <div class="pg-value">{{ character_of_service | default("Honorable") }}</div>
    </div>
  </div>

  {% if decorations and decorations.length %}
    <div class="section-header">
      <div class="section-title" style="font-size:13px;">Decorations &amp; Awards</div>
      <div class="section-rule"></div>
    </div>
    <div class="awards-list">
      {% for medal in decorations %}
        <div class="award-row">
          <span class="award-name {% if medal.distinguished %}{% else %}dim{% endif %}">{{ medal }}</span>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="tab-empty" style="padding-top:16px;">
      No decoration records on file.<br>
      <a href="/contribute/">Know of awards earned? Tell us →</a>
    </div>
  {% endif %}
</div>

{# ── TAB: EXTERNAL RESOURCES ── #}
<div class="tab-content" id="tab-external" style="display:none">

  {% set hasExternal = (links and (links.wall or (links.other and links.other.length))) %}

  {% if hasExternal %}

    {% if links.wall %}
      <div class="section-header">
        <div class="section-title" style="font-size:13px;">Vietnam Veterans Memorial</div>
        <div class="section-rule"></div>
      </div>
      <div class="doc-list">
        <div class="doc-item">
          <div class="doc-icon">🪨</div>
          <div style="flex:1;">
            <a class="doc-title doc-link" href="{{ links.wall }}" target="_blank" rel="noopener">
              Wall of Faces — {{ first_name }} {{ last_name }}
            </a>
            <div class="doc-meta">Vietnam Veterans Memorial Fund</div>
          </div>
          <div class="doc-type">VVMF</div>
        </div>
      </div>
    {% endif %}

    {% if links.other and links.other.length %}
      <div class="section-header" {% if links.wall %}style="margin-top:24px;"{% endif %}>
        <div class="section-title" style="font-size:13px;">Other Records</div>
        <div class="section-rule"></div>
        <div class="section-meta">{{ links.other.length }}</div>
      </div>
      <div class="doc-list">
        {% for link in links.other %}
          <div class="doc-item">
            <div class="doc-icon">🔗</div>
            <div style="flex:1;">
              <a class="doc-title doc-link" href="{{ link.url }}" target="_blank" rel="noopener">
                {{ link.label }}
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  {% else %}
    <div class="tab-empty">
      No external resources on record.<br>
      <a href="/contribute/">Know of something that should be here? →</a>
    </div>
  {% endif %}

</div>

{# ── PROFILE CTA ── #}
<div class="prof-cta">
  <div>
    <h3>Did You Know {{ first_name }}, or Serve Alongside {{ first_name }}?</h3>
    <p>We are actively collecting photographs, letters, and memories for this profile. Submissions are reviewed before publication. If you served with {{ first_name }} — or are a family member with materials — we'd be grateful to hear from you.</p>
  </div>
  <div class="prof-cta-btns">
    <a class="land-cta" href="/contribute/">Submit Materials</a>
  </div>
  <p class="prof-cta-records">Looking for official service or casualty records? <a href="/records/">See our guide →</a></p>
</div>

{% include "partials/footer.njk" %}

</main>

