---
layout: base.njk
title: Overview
---

<div class="ov-hero">
  <div class="ov-hero-text">
    <div class="ov-dateline">Primary Source Archive · Initiated April 2026 · Active Collection · D Co. 2nd Bn. 8th Cavalry · 1st Cav Div (Airmobile)</div>
    <div class="ov-headline">Delta<br><span>Company</span><br>Archive</div>
    <div class="ov-deck">A permanent record of the men of D Co., 2/8 CAV — built one soldier at a time from the materials families have kept.</div>
    <div class="ov-body">This archive collects primary source materials — letters, photographs, documents, firsthand accounts — from veterans and families of Delta Company. Compiled by the son of SGT Marvin Dale Miller, Cat Platoon, December 1970–1971.</div>
  </div>

  <div class="ov-hero-side">
    <div class="ov-side-label">Recently Added</div>

    {# ── Skipper Stories — loaded client-side ── #}
    <div class="ov-recent-section" id="ov-stories-section" style="display:none">
      <div class="ov-recent-type">Stories</div>
      <div id="ov-stories-list"></div>
    </div>

    {# ── Recent Profiles ── #}
    {% set recentSoldiers = collections.soldiers | sortByData("date_added") | limit(3) %}
    {% if recentSoldiers | length %}
    <div class="ov-recent-section">
      <div class="ov-recent-type">Profiles</div>
      {% for soldier in recentSoldiers %}
        {% if soldier.data.date_added %}
        <a class="ov-recent-card" href="{{ soldier.url }}">
          <div class="ov-recent-card-name">{{ soldier.data.first_name }} {{ soldier.data.last_name }}</div>
          <div class="ov-recent-card-meta">{{ soldier.data.platoon }}{% if soldier.data.rank %} · {{ soldier.data.rank }}{% endif %}</div>
          <div class="ov-recent-card-date">Added {{ soldier.data.date_added | isoDate }}</div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    {# ── Contact Info Now on File ── #}
    {% set contactSoldiers = collections.soldiers | whereData("share_contact", true) | sortByData("date_added") | limit(3) %}
    {% if contactSoldiers | length %}
    <div class="ov-recent-section">
      <div class="ov-recent-type">Contact Info on File</div>
      {% for soldier in contactSoldiers %}
        <a class="ov-recent-card ov-recent-card--contact" href="{{ soldier.url }}">
          <div class="ov-recent-card-name">{{ soldier.data.first_name }} {{ soldier.data.last_name }}</div>
          <div class="ov-recent-card-meta">{{ soldier.data.platoon }}</div>
          <div class="ov-recent-card-contact-note">✉ Contact info now available — request via archive</div>
        </a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="ov-side-notice">Contact details for living veterans are held in restricted access only and do not appear in any public view.</div>
  </div>
</div>

<div class="ov-body-grid">
  <div class="ov-col">
    <div class="ov-col-head">Documented Events</div>
    {% set recentEvents = collections.events | whereData("status", "published") | sortByData("archivist_notes.created") | limit(3) %}
    {% for event in recentEvents %}
    <div class="ov-event">
      <div class="ov-event-date">{{ event.data.date | locDate }}{% if event.data.location %} · {{ event.data.location }}{% endif %}</div>
      <div class="ov-event-title"><a href="{{ event.url }}">{{ event.data.title }}</a></div>
      <div class="ov-event-body">
        {%- set eventKiaList = event.data.casualties.kia if event.data.casualties else null -%}
        {%- set eventWiaList = event.data.casualties.wia if event.data.casualties else null -%}
        {%- if eventKiaList and eventKiaList.length -%}
          <em class="ov-hl">{{ eventKiaList.length }} KIA.</em>
          {%- for k in eventKiaList %} {{ k.name or k.slug }}{% if not loop.last %},{% endif %}{% endfor -%}.
        {%- elif eventWiaList and eventWiaList.length -%}
          <em class="ov-hl">{{ eventWiaList.length }} WIA.</em>
        {%- endif -%}
        {% if event.data.units.primary and event.data.units.primary.length %} {{ event.data.units.primary[0].role }}{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <div class="ov-col">
    <div class="ov-col-head">Primary Sources</div>
    <div class="ov-source">
      <div class="ov-source-title">McGrew Field Calendar, 1971</div>
      <div class="ov-source-meta">SP4 Howard McGrew · Handwritten · Jan–Dec 1971</div>
    </div>
    <div class="ov-source">
      <div class="ov-source-title">ASA Newsletters, 1988–2026</div>
      <div class="ov-source-meta">Association of Survivors · 38 years of unit correspondence</div>
    </div>
    <div class="ov-source">
      <div class="ov-source-title">Skipper Journal, 1968</div>
      <div class="ov-source-meta">D Co. Daily Log · Angry Skipper Association transcription · Jun–Jul 1968</div>
    </div>
    <div class="ov-source">
      <div class="ov-source-title">1967 Division ORLLs</div>
      <div class="ov-source-meta">1st Cavalry Division Operational Reports · NARA · Feb–Oct 1967</div>
    </div>
  </div>

  <div class="ov-col">
    <div class="ov-col-head">About This Archive</div>
    <div class="ov-about-text">
      All records are works in progress. Personal contact details for living veterans are maintained in restricted access only. Submissions from veterans, family members, and researchers are welcomed — all materials are reviewed before publication.
      <br><br>
      If you served with D Co. 2/8 CAV or have materials from a family member who did, this archive wants to hear from you.
    </div>
    <div style="margin-top:20px;">
      <a class="land-cta" style="font-size:14px;padding:9px 20px;display:inline-block;" href="/contribute/">Contribute →</a>
    </div>
  </div>
</div>

<script>
(async function loadRecentStories() {
  try {
    const res = await fetch('/api/skipper-stories/published');
    if (!res.ok) return;
    const { stories } = await res.json();
    if (!stories || !stories.length) return;

    const recent = stories.slice(0, 2);
    const section = document.getElementById('ov-stories-section');
    const list    = document.getElementById('ov-stories-list');
    if (!section || !list) return;

    list.innerHTML = recent.map(s => {
      const name    = s.publication === 'anonymous' ? 'Anonymous' : (s.name || 'Anonymous');
      const preview = (s.response || '').slice(0, 120).trim();
      const ellipsis = s.response && s.response.length > 120 ? '…' : '';
      return `<a class="ov-recent-card ov-recent-card--story" href="/skipper-stories/?tab=${encodeURIComponent(s.tab_id || '')}">
        <div class="ov-recent-card-story-prompt">${escOv(s.tab_label || s.tab_id || 'Skipper Stories')}</div>
        <div class="ov-recent-card-story-preview">${escOv(preview)}${ellipsis}</div>
        <div class="ov-recent-card-meta">${escOv(name)}</div>
      </a>`;
    }).join('');

    section.style.display = 'block';
  } catch (e) { /* fail silently */ }
})();

function escOv(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>

