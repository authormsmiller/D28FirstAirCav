        </div>
        <details style="margin-top:1.5rem;">
          <summary style="cursor:pointer;font-weight:600;padding:0.5rem 0;">Published &amp; Withdrawn</summary>
          <div class="ph-submissions-toolbar" style="margin-top:0.5rem;">
            <button class="btn btn-secondary btn-sm" onclick="fbLoadPublishedStories()">↻ Load</button>
            <span class="ph-toolbar-hint">Withdraw removes a story from the public feed but keeps it in R2. Restore puts it back.</span>
          </div>
