<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>D Co. Archive — Admin</title>
<style>
  /* ── reset & tokens ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:       #1a1a18;
    --paper:     #f5f0e8;
    --cream:     #ede8da;
    --rule:      #c8c0a8;
    --yellow:    #e8c830;
    --red:       #8b1a1a;
    --green:     #2d6a2d;
    --blue:      #1a3a5c;
    --muted:     #6b6456;
    --font-ui:   'Space Grotesk', system-ui, sans-serif;
    --font-body: 'Crimson Pro', Georgia, serif;
    --font-disp: 'Bebas Neue', 'Impact', sans-serif;
  }

  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap');

  html, body {
    height: 100%;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.5;
  }

  /* ── layout ── */
  .app {
    display: grid;
    grid-template-rows: auto auto 1fr;
    height: 100vh;
  }

  /* ── masthead ── */
  .masthead {
    background: var(--ink);
    color: var(--paper);
    padding: 10px 20px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-bottom: 4px solid var(--yellow);
  }
  .masthead-title {
    font-family: var(--font-disp);
    font-size: 22px;
    letter-spacing: 0.04em;
    color: var(--yellow);
  }
  .masthead-sub {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--rule);
  }

  /* ── session bar ── */
  .session-bar {
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    padding: 8px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 12px;
  }
  .session-branch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--blue);
  }
  .session-branch::before {
    content: '⎇';
    font-size: 13px;
  }
  .session-changes {
    color: var(--muted);
    flex: 1;
  }
  .session-changes.has-changes { color: var(--red); font-weight: 500; }
  .session-actions { display: flex; gap: 8px; }

  /* ── tabs ── */
  .tab-nav {
    display: flex;
    gap: 0;
    padding: 0 20px;
    background: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .tab-btn {
    background: none;
    border: none;
    padding: 10px 18px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--rule);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover { color: var(--paper); }
  .tab-btn.active { color: var(--yellow); border-bottom-color: var(--yellow); }
  .tab-btn.disabled { opacity: 0.35; cursor: not-allowed; }

  /* ── main content area ── */
  .content {
    overflow-y: auto;
    padding: 24px 20px;
    max-width: 860px;
  }

  /* ── panels ── */
  .panel { display: none; }
  .panel.active { display: block; }

  /* ── section headers ── */
  .section-head {
    font-family: var(--font-disp);
    font-size: 18px;
    letter-spacing: 0.05em;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .section-desc {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 20px;
    font-family: var(--font-body);
    font-style: italic;
  }

  /* ── form ── */
  .form-grid {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 12px 16px;
    align-items: start;
    margin-bottom: 20px;
  }
  .form-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--muted);
    padding-top: 8px;
  }
  .form-field { display: flex; flex-direction: column; gap: 4px; }
  .form-hint { font-size: 11px; color: var(--muted); }

  select, input[type="text"] {
    width: 100%;
    padding: 7px 10px;
    border: 1px solid var(--rule);
    background: #fff;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink);
    border-radius: 2px;
    appearance: none;
  }
  select:focus, input:focus {
    outline: 2px solid var(--blue);
    outline-offset: 1px;
  }

  /* ── field-type pill ── */
  .field-type-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 6px;
    border-radius: 2px;
    margin-left: 6px;
    vertical-align: middle;
  }
  .pill-array { background: #dbeafe; color: #1e40af; }
  .pill-scalar { background: #fef3c7; color: #92400e; }

  /* ── multi-select value list ── */
  select[multiple] {
    height: auto;
    min-height: 120px;
    padding: 4px;
  }
  select[multiple] option { padding: 4px 8px; border-radius: 2px; }
  select[multiple] option:checked { background: var(--blue); color: #fff; }
  .value-field.is-scalar select[multiple] { display: none; }
  .value-field.is-scalar input[type="text"] { display: block; }
  .value-field.is-multi input[type="text"] { display: none; }
  .value-field.is-multi select[multiple] { display: block; }

  /* ── action row ── */
  .action-row { display: flex; gap: 10px; align-items: center; padding-top: 4px; flex-wrap: wrap; }

  /* ── buttons ── */
  .btn {
    padding: 7px 16px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid transparent;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .btn-primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn-primary:hover { background: var(--blue); border-color: var(--blue); }
  .btn-secondary { background: transparent; color: var(--ink); border-color: var(--rule); }
  .btn-secondary:hover { background: var(--cream); }
  .btn-danger { background: transparent; color: var(--red); border-color: var(--red); }
  .btn-danger:hover { background: var(--red); color: #fff; }
  .btn-commit { background: var(--green); color: #fff; border-color: var(--green); }
  .btn-commit:hover { background: #1e4d1e; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── record preview ── */
  .record-preview {
    margin-top: 20px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    overflow: hidden;
  }
  .preview-header {
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .preview-body { padding: 12px; }
  .fm-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2px 12px;
    font-size: 12px;
    padding: 4px 0;
    border-bottom: 1px solid var(--cream);
  }
  .fm-row:last-child { border-bottom: none; }
  .fm-key { color: var(--muted); font-weight: 500; }
  .fm-val { font-family: 'Courier New', monospace; word-break: break-all; }
  .fm-val.is-array { color: var(--blue); }
  .fm-val.is-empty { color: var(--rule); font-style: italic; }
  .fm-val.just-changed { background: #fef9c3; border-radius: 2px; padding: 0 3px; }

  /* ── clickable preview rows ── */
  .fm-row-clickable { cursor: pointer; border-radius: 2px; }
  .fm-row-clickable:hover { background: #ede8da; }
  .fm-row-clickable:hover .fm-editable { text-decoration: underline; text-decoration-style: dashed; text-decoration-color: var(--muted); }
  .fm-edit-hint { font-size: 10px; color: var(--muted); margin-left: 6px; opacity: 0; transition: opacity 0.1s; }
  .fm-row-clickable:hover .fm-edit-hint { opacity: 1; }
  .fm-lock { font-size: 10px; color: var(--rule); margin-left: 4px; }
  .fm-inline-input {
    font-family: 'Courier New', monospace;
    font-size: 13px;
    width: 100%;
    padding: 1px 5px;
    border: 1px solid var(--blue);
    border-radius: 2px;
    background: #fff;
    outline: none;
  }

  /* ── array / scalar popover ── */
  .fm-popover {
    position: fixed;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.18);
    padding: 12px;
    width: 340px;
    z-index: 200;
    display: none;
  }
  .fm-popover.open { display: block; }
  .fm-popover-title {
    font-family: var(--font-disp);
    font-size: 15px;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }
  .fm-popover-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    min-height: 28px;
    padding: 5px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--cream);
    margin-bottom: 8px;
  }
  .fm-chip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 6px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 2px;
    font-size: 11px;
    font-family: monospace;
  }
  .fm-chip-remove { cursor: pointer; color: var(--muted); font-size: 13px; line-height: 1; padding: 0 1px; }
  .fm-chip-remove:hover { color: var(--red); }
  .fm-popover-footer { display: flex; justify-content: flex-end; gap: 6px; margin-top: 10px; }

  /* ── profile photo modal ── */
  .pph-drop-zone {
    border: 2px dashed var(--rule);
    border-radius: 3px;
    padding: 36px 24px;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    margin-bottom: 12px;
  }
  .pph-drop-zone:hover, .pph-drop-zone.drag-over { border-color: var(--blue); background: rgba(26,58,92,0.04); }
  .pph-crop-wrap {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin-bottom: 8px;
    line-height: 0;
  }
  .pph-crop-img { display: block; max-width: 100%; max-height: 320px; user-select: none; }
  .pph-crop-overlay { position: absolute; inset: 0; cursor: crosshair; }
  .pph-crop-rect {
    position: absolute;
    border: 2px solid var(--yellow);
    box-shadow: 0 0 0 9999px rgba(0,0,0,0.45);
    pointer-events: none;
    display: none;
  }
  .pph-step { display: none; }
  .pph-step.active { display: block; }
  .pph-meta-grid {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 8px 12px;
    align-items: center;
    margin: 12px 0 16px;
  }
  .pph-meta-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }

  /* ── changelog ── */
  .changelog {
    margin-top: 20px;
  }
  .changelog-head {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .changelog-entry {
    padding: 8px 12px;
    border-left: 3px solid var(--green);
    background: #f0fdf0;
    margin-bottom: 6px;
    font-size: 12px;
    font-family: 'Courier New', monospace;
  }
  .changelog-entry.warn { border-color: var(--yellow); background: #fefce8; }

  /* ── new profile panel ── */
  .np-mode-row {
    margin-bottom: 20px;
  }
  .np-mode-toggle {
    display: inline-flex;
    border: 1px solid var(--rule);
    border-radius: 2px;
    overflow: hidden;
  }
  .np-mode-btn {
    padding: 6px 18px;
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: transparent;
    color: var(--muted);
    border: none;
    cursor: pointer;
  }
  .np-mode-btn.active {
    background: var(--ink);
    color: var(--yellow);
  }
  .np-slug-block {
    margin-bottom: 4px;
  }
  .np-section {
    border: 1px solid var(--rule);
    border-radius: 2px;
    margin-bottom: 16px;
    overflow: hidden;
  }
  .np-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .np-section .form-grid {
    padding: 14px 14px 8px;
    margin-bottom: 0;
  }
  .np-save-btn {
    font-size: 11px;
    padding: 4px 12px;
  }
  .np-status-bar {
    min-height: 0;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--green);
  }
  .np-status-bar.error { color: var(--red); }
  .np-status-bar.info  { color: var(--blue); }
  .np-section-msg {
    font-size: 11px;
    padding: 4px 14px 10px;
    color: var(--green);
  }
  .np-section-msg.error { color: var(--red); }

  /* ── toast ── */
  .toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: var(--ink);
    color: var(--paper);
    padding: 10px 16px;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 500;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
    pointer-events: none;
    z-index: 100;
    max-width: 340px;
  }
  .toast.show { opacity: 1; transform: translateY(0); }
  .toast.error { background: var(--red); }
  .toast.success { background: var(--green); }

  /* ── commit modal ── */
  .modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 50;
    display: none;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 24px;
    width: 480px;
    max-width: 95vw;
  }
  .modal h2 {
    font-family: var(--font-disp);
    font-size: 20px;
    margin-bottom: 12px;
  }
  .modal textarea {
    width: 100%;
    padding: 8px 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    resize: vertical;
    min-height: 80px;
    margin-bottom: 12px;
  }
  .modal-changes {
    background: var(--cream);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 10px;
    font-size: 11px;
    font-family: 'Courier New', monospace;
    margin-bottom: 16px;
    max-height: 160px;
    overflow-y: auto;
    color: var(--muted);
  }
  .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }

  /* ── loading ── */
  .loading { color: var(--muted); font-style: italic; font-size: 13px; }

  /* ── separator ── */
  hr.rule { border: none; border-top: 1px solid var(--rule); margin: 20px 0; }
</style>
</head>
<body>
<div class="app">

  <!-- Masthead -->
  <header class="masthead">
    <span class="masthead-title">D Co. 2/8 CAV — Archive Admin</span>
    <span class="masthead-sub">D28FirstAirCav</span>
  </header>

  <!-- Session bar -->
  <div class="session-bar" id="sessionBar">
    <span class="session-branch" id="branchName">loading…</span>
    <span class="session-changes" id="changeCount">checking status…</span>
    <div class="session-actions">
      <button class="btn btn-commit" id="btnCommit" disabled onclick="openCommitModal()">Commit</button>
      <button class="btn btn-secondary" id="btnPush" disabled onclick="pushBranch()">Push</button>
    </div>
  </div>

  <!-- Tab nav -->
  <nav class="tab-nav">
    <button class="tab-btn active" onclick="switchTab('attach')">Attach Record</button>
    <button class="tab-btn" onclick="switchTab('edit')">Edit Record</button>
    <button class="tab-btn" onclick="switchTab('photos')" id="tab-btn-photos">
      Photo Intake
      <span class="tab-badge" id="ph-tab-badge" style="display:none"></span>
    </button>
    <button class="tab-btn" onclick="switchTab('newprofile')" id="tab-btn-newprofile">New Profile</button>
    <button class="tab-btn" onclick="switchTab('todo')" id="tab-btn-todo">
      Todo / Flags
      <span class="tab-badge" id="todo-badge" style="display:none"></span>
    </button>
    <button class="tab-btn" onclick="switchTab('feedback')" id="tab-btn-feedback">
      Site Feedback
      <span class="tab-badge" id="fb-tab-badge" style="display:none"></span>
    </button>
    <button class="tab-btn add-issue-btn" onclick="openAddIssueModal()" id="btn-add-issue"
      title="Log a new issue or task">
      + Add Issue
    </button>
  </nav>

  <!-- Content -->
  <main class="content">

    <!-- Tab 1: Attach Record -->
    <div class="panel active" id="panel-attach">
      <h1 class="section-head">Attach Record</h1>
      <p class="section-desc">Connect a value to a front matter field. Array fields (contains, tagged…) append the value. Scalar fields (author, event…) set it.</p>

      <div class="form-grid">

        <label class="form-label">Record type</label>
        <div class="form-field">
          <select id="recType" onchange="onTypeChange()">
            <option value="">— select type —</option>
            <option value="document">Document</option>
            <option value="soldier">Soldier</option>
            <option value="event">Event</option>
            <option value="anecdote">Anecdote</option>
          </select>
        </div>

        <label class="form-label">Slug</label>
        <div class="form-field">
          <select id="recSlug" onchange="onSlugChange()" disabled>
            <option value="">— select a type first —</option>
          </select>
          <span class="form-hint" id="slugHint"></span>
        </div>

        <label class="form-label">Field</label>
        <div class="form-field">
          <select id="recField" onchange="onFieldChange()">
            <option value="">— select field —</option>
          </select>
          <span class="form-hint" id="fieldHint"></span>
        </div>

        <label class="form-label">Value</label>
        <div class="form-field value-field is-scalar" id="valueField">
          <input type="text" id="recValueScalar" placeholder="slug or string value" list="valueList">
          <select multiple id="recValueMulti" size="6"></select>
          <datalist id="valueList"></datalist>
          <span class="form-hint" id="valueHint"></span>
        </div>

      </div>

      <div class="action-row">
        <button class="btn btn-primary" id="btnAttachContinue" onclick="doAttach('continue')" disabled>Attach &amp; Continue</button>
        <button class="btn btn-primary" id="btnAttachDone" onclick="doAttach('done')" disabled>Done</button>
        <button class="btn btn-danger" id="btnDetach" onclick="doDetach()" disabled style="margin-left: auto;">Detach</button>
      </div>

      <!-- Record preview -->
      <div id="previewArea"></div>

      <!-- Changelog for this session -->
      <div class="changelog" id="changelogArea" style="display:none">
        <div class="changelog-head">Changes this session</div>
        <div id="changelogEntries"></div>
      </div>
    </div>

    <!-- Tab 2: Edit Record -->
    <div class="panel" id="panel-edit">
      <h1 class="section-head">Edit Record</h1>
      <p class="section-desc">Select a record, choose a tab, pick a field. Current value shown on the left — enter new value on the right.</p>

      <div class="form-grid">

        <label class="form-label">Record type</label>
        <div class="form-field">
          <select id="editType" onchange="onEditTypeChange()">
            <option value="">— select type —</option>
            <option value="document">Document</option>
            <option value="soldier">Soldier</option>
            <option value="event">Event</option>
            <option value="anecdote">Anecdote</option>
          </select>
        </div>

        <label class="form-label">Slug</label>
        <div class="form-field">
          <select id="editSlug" onchange="onEditSlugChange()" disabled>
            <option value="">— select a type first —</option>
          </select>
          <span class="form-hint" id="editSlugHint"></span>
        </div>

        <label class="form-label">Tab</label>
        <div class="form-field">
          <select id="editTab" onchange="onEditTabChange()" disabled>
            <option value="">— select a record first —</option>
          </select>
        </div>

        <label class="form-label">Field</label>
        <div class="form-field">
          <select id="editField" onchange="onEditFieldChange()" disabled>
            <option value="">— select a tab first —</option>
          </select>
          <span class="form-hint" id="editFieldHint"></span>
        </div>

        <label class="form-label">Value</label>
        <div class="form-field" id="editValueArea" style="display:none">
          <!-- Scalar: current + new side by side -->
          <div id="editScalarArea" style="display:none">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
              <div>
                <div id="editCurrentVal" style="padding:7px 10px;border:1px solid var(--rule);border-radius:2px;background:var(--cream);font-size:13px;font-family:'Courier New',monospace;min-height:32px;word-break:break-all;color:var(--muted);"></div>
                <span class="form-hint" style="margin-top:3px;display:block;">Current value</span>
              </div>
              <div>
                <input type="text" id="editNewVal" placeholder="New value…" list="editValueList">
                <datalist id="editValueList"></datalist>
                <span class="form-hint" style="margin-top:3px;display:block;">New value</span>
              </div>
            </div>
          </div>
          <!-- Array: current list + add new -->
          <div id="editArrayArea" style="display:none">
            <div style="margin-bottom:10px;">
              <div class="form-hint" style="margin-bottom:4px;">Current entries — click to select for removal</div>
              <div id="editArrayCurrent" style="border:1px solid var(--rule);border-radius:2px;background:var(--cream);min-height:40px;padding:6px;display:flex;flex-wrap:wrap;gap:4px;"></div>
            </div>
            <!-- Slug-backed add (source array fields) -->
            <div id="editArrayAddSelect">
              <div class="form-hint" style="margin-bottom:4px;">Add entries</div>
              <select multiple id="editArrayAdd" size="6" style="width:100%"></select>
              <span class="form-hint" id="editArrayHint" style="margin-top:3px;display:block;"></span>
            </div>
            <!-- Free-text add (array_text fields: decorations, etc.) -->
            <div id="editArrayAddText" style="display:none">
              <div class="form-hint" style="margin-bottom:4px;">Add entry</div>
              <input type="text" id="editArrayTextVal" placeholder="Enter value…" style="width:100%">
              <span class="form-hint" style="margin-top:3px;display:block;">Press Apply &amp; Continue to add, then enter the next.</span>
            </div>
          </div>
        </div>

      </div>

      <div class="action-row" id="editActionRow" style="display:none">
        <button class="btn btn-primary" id="btnEditApply" onclick="doEdit('continue')" disabled>Apply &amp; Continue</button>
        <button class="btn btn-primary" id="btnEditDone" onclick="doEdit('done')" disabled>Done</button>
        <button class="btn btn-danger" id="btnEditRemove" onclick="doRemove()" disabled style="margin-left:auto;display:none">Remove</button>
      </div>

      <div id="editPreviewArea"></div>

    </div>

    <!-- Tab 3: New Profile -->
    <div class="panel" id="panel-newprofile">
      <h1 class="section-head">New Profile</h1>
      <p class="section-desc">Create a new soldier profile or edit an existing one. Each section saves independently — fill what you have and come back for the rest.</p>

      <!-- Mode toggle + slug row -->
      <div class="np-mode-row">
        <div class="np-mode-toggle">
          <button class="np-mode-btn active" id="np-btn-new" onclick="npSetMode('new')">New Profile</button>
          <button class="np-mode-btn" id="np-btn-edit" onclick="npSetMode('edit')">Edit Existing</button>
        </div>
      </div>

      <!-- Slug entry (New mode) -->
      <div id="np-slug-new" class="np-slug-block">
        <div class="form-grid">
          <label class="form-label">Slug</label>
          <div class="form-field">
            <input type="text" id="np-slug-input" placeholder="lastname-firstname  e.g. miller-marvin" oninput="npSlugInput()" autocomplete="off">
            <span class="form-hint" id="np-slug-hint">lowercase letters, numbers, and hyphens only</span>
          </div>
          <label class="form-label"></label>
          <div class="form-field">
            <button class="btn btn-primary" id="np-create-btn" onclick="npCreate()" disabled>Create Profile</button>
          </div>
        </div>
      </div>

      <!-- Slug picker (Edit mode) -->
      <div id="np-slug-edit" class="np-slug-block" style="display:none">
        <div class="form-grid">
          <label class="form-label">Soldier</label>
          <div class="form-field">
            <select id="np-slug-select" onchange="npLoadExisting()">
              <option value="">— select soldier —</option>
            </select>
          </div>
        </div>
      </div>

      <!-- All sections — hidden until profile is active -->
      <div id="np-sections" style="display:none">

        <!-- Status bar -->
        <div class="np-status-bar" id="np-status-bar"></div>

        <!-- ── IDENTITY ── -->
        <div class="np-section">
          <div class="np-section-head">
            <span>Identity</span>
            <button class="btn btn-secondary np-save-btn" onclick="npSaveSection('identity')">Save</button>
          </div>
          <div class="form-grid">
            <label class="form-label">First name</label>
            <div class="form-field"><input type="text" id="np-first_name" placeholder="Marvin Dale"></div>
            <label class="form-label">Last name</label>
            <div class="form-field"><input type="text" id="np-last_name" placeholder="Miller"></div>
            <label class="form-label">Middle name</label>
            <div class="form-field"><input type="text" id="np-middle_name"></div>
            <label class="form-label">Suffix</label>
            <div class="form-field">
              <select id="np-suffix">
                <option value=""></option>
                <option>Jr.</option><option>Sr.</option><option>II</option><option>III</option><option>IV</option>
              </select>
            </div>
            <label class="form-label">Nickname</label>
            <div class="form-field"><input type="text" id="np-nickname"></div>
            <label class="form-label">Birth year</label>
            <div class="form-field"><input type="text" id="np-birth_year" placeholder="1950"></div>
          </div>
        </div>

        <!-- ── RANK & ASSIGNMENT ── -->
        <div class="np-section">
          <div class="np-section-head">
            <span>Rank &amp; Assignment</span>
            <button class="btn btn-secondary np-save-btn" onclick="npSaveSection('rank')">Save</button>
          </div>
          <div class="form-grid">
            <label class="form-label">Rank</label>
            <div class="form-field">
              <select id="np-rank">
                <option value=""></option>
                <option>PVT</option><option>PFC</option><option>SP4</option><option>SP5</option><option>SP6</option>
                <option>SGT</option><option>SSG</option><option>SFC</option><option>MSG</option><option>1SG</option><option>SGM</option>
                <option>WO1</option><option>WO2</option><option>WO3</option><option>WO4</option>
                <option>2LT</option><option>1LT</option><option>CPT</option><option>MAJ</option><option>LTC</option><option>COL</option>
              </select>
            </div>
            <label class="form-label">MOS</label>
            <div class="form-field"><input type="text" id="np-mos" placeholder="67N20"></div>
            <label class="form-label">Platoon</label>
            <div class="form-field">
              <select id="np-platoon">
                <option value=""></option>
                <option>Range</option><option>Cat</option><option>Skull</option><option>HQ</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ── SERVICE ── -->
        <div class="np-section">
          <div class="np-section-head">
            <span>Service</span>
            <button class="btn btn-secondary np-save-btn" onclick="npSaveSection('service')">Save</button>
          </div>
          <div class="form-grid">
            <label class="form-label">Arrived</label>
            <div class="form-field"><input type="text" id="np-arrived" placeholder="1971-03"></div>
            <label class="form-label">Departed</label>
            <div class="form-field"><input type="text" id="np-departed" placeholder="1972-03"></div>
            <label class="form-label">Status</label>
            <div class="form-field">
              <select id="np-status">
                <option value="researching">researching</option>
                <option value="veteran">veteran</option>
                <option value="deceased">deceased</option>
                <option value="kia">kia</option>
                <option value="mia">mia</option>
              </select>
            </div>
            <label class="form-label">Character of service</label>
            <div class="form-field">
              <select id="np-character_of_service">
                <option value="Honorable">Honorable</option>
                <option value="General">General</option>
                <option value="Other Than Honorable">Other Than Honorable</option>
                <option value="Bad Conduct">Bad Conduct</option>
                <option value="Dishonorable">Dishonorable</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ── POST-SERVICE ── -->
        <div class="np-section">
          <div class="np-section-head">
            <span>Post-service</span>
            <button class="btn btn-secondary np-save-btn" onclick="npSaveSection('postservice')">Save</button>
          </div>
