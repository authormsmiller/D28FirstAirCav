</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<!-- Commit modal -->
<div class="modal-overlay" id="commitModal">
  <div class="modal">
    <h2>Commit Changes</h2>
    <div class="modal-changes" id="modalChangesList">Loading…</div>
    <label style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;display:block;margin-bottom:6px;">Commit message</label>
    <textarea id="commitMsg" placeholder="Describe what you changed…"></textarea>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="closeCommitModal()">Cancel</button>
      <button class="btn btn-commit" onclick="doCommit()">Commit</button>
    </div>
  </div>
</div>

<script>
// ── state ──────────────────────────────────────────────────────────────────
const API = '/api';
let sessionData = null;
let currentRecord = null;
let sessionChangelog = [];
let slugCache = {}; // type → [{slug, path}]

// ── init ───────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  loadSession();
  // Pre-load slug lists for autocomplete
  ['soldier', 'document', 'event', 'anecdote'].forEach(t => prefetchSlugs(t));
  // Load feedback badge count
  loadFeedbackCounts();
});

async function loadSession() {
  try {
    const data = await api('GET', '/session');
    sessionData = data;
    document.getElementById('branchName').textContent = data.branch;
    updateChangeCount(data.pendingCount);
    if (data.branchCreated) {
      toast(`Working branch created: ${data.branch}`, 'success');
    }
  } catch (e) {
    document.getElementById('branchName').textContent = 'error';
    document.getElementById('changeCount').textContent = 'Could not connect to admin server';
  }
}

function updateChangeCount(n) {
  const el = document.getElementById('changeCount');
  el.textContent = n === 0 ? 'No uncommitted changes' : `${n} uncommitted change${n !== 1 ? 's' : ''}`;
  el.className = 'session-changes' + (n > 0 ? ' has-changes' : '');
  document.getElementById('btnCommit').disabled = n === 0;
  // Only enable push after a commit (we check last commit in session data)
  document.getElementById('btnPush').disabled = !sessionData?.lastCommit;
}

// ── slug prefetch ──────────────────────────────────────────────────────────
async function prefetchSlugs(type) {
  try {
    const data = await api('GET', `/slugs?type=${type}`);
    slugCache[type] = data;
  } catch { /* ignore */ }
}

// ── tab 1: form interactions ───────────────────────────────────────────────
function onTypeChange() {
  const type = document.getElementById('recType').value;
  const slugSelect = document.getElementById('recSlug');

  slugSelect.innerHTML = '<option value="">— loading… —</option>';
  slugSelect.disabled = true;
  document.getElementById('slugHint').textContent = '';
  clearPreview();
  updateAttachButton();

  if (!type) {
    slugSelect.innerHTML = '<option value="">— select a type first —</option>';
    return;
  }

  // If already cached, populate immediately
  if (slugCache[type]?.length) {
    populateSlugSelect(type);
    return;
  }

  // Otherwise fetch then populate
  fetch(`${API}/slugs?type=${type}`)
    .then(r => r.json())
    .then(data => { slugCache[type] = data; populateSlugSelect(type); })
    .catch(() => {
      slugSelect.innerHTML = '<option value="">— error loading slugs —</option>';
    });
}

function populateSlugSelect(type) {
  const slugSelect = document.getElementById('recSlug');
  const items = slugCache[type] || [];
  slugSelect.innerHTML = '<option value="">— select slug —</option>';
  items.forEach(({ slug }) => {
    const opt = document.createElement('option');
    opt.value = slug;
    opt.textContent = slug;
    slugSelect.appendChild(opt);
  });
  slugSelect.disabled = false;
  document.getElementById('slugHint').textContent = `${items.length} record${items.length !== 1 ? 's' : ''} available`;
}

function onSlugChange() {
  const type = document.getElementById('recType').value;
  const slug = document.getElementById('recSlug').value;

  clearPreview();
  updateAttachButton();

  if (type && slug) loadPreview();
}

// ── field definitions by record type ──────────────────────────────────────
const FIELDS_BY_TYPE = {
  document: {
    array:  ['contains', 'tagged', 'related_events'],
    scalar: ['author', 'event', 'status', 'title', 'doc_type'],
  },
  soldier: {
    array:  ['contains', 'tagged'],
    scalar: ['status', 'rank', 'mos', 'platoon', 'hometown'],
  },
  event: {
    array:  ['contains', 'tagged', 'casualties', 'related_events', 'accounts'],
    scalar: ['status', 'title', 'location'],
  },
  anecdote: {
    array:  ['contains', 'tagged'],
    scalar: ['event', 'status', 'title'],
  },
};

// Which array fields pull from which slug cache
const ARRAY_FIELD_SOURCE = {
  contains:       'soldier',
  tagged:         'soldier',
  casualties:     'soldier',
  accounts:       'document',
  related_events: 'event',
};

// Fixed option sets for scalar fields
const SCALAR_OPTIONS = {
  status: ['draft', 'published', 'redacted'],
};

function onTypeChange() {
  const type = document.getElementById('recType').value;
  const slugSelect = document.getElementById('recSlug');
  const fieldSelect = document.getElementById('recField');

  // Reset downstream
  slugSelect.innerHTML = '<option value="">— loading… —</option>';
  slugSelect.disabled = true;
  fieldSelect.innerHTML = '<option value="">— select field —</option>';
  document.getElementById('slugHint').textContent = '';
  document.getElementById('fieldHint').textContent = '';
  clearPreview();
  resetValueField();
  updateAttachButton();

  if (!type) {
    slugSelect.innerHTML = '<option value="">— select a type first —</option>';
    return;
  }

  // Populate field select based on type
  const fields = FIELDS_BY_TYPE[type];
  if (fields) {
    const arrGroup = document.createElement('optgroup');
    arrGroup.label = 'Array fields (append)';
    fields.array.forEach(f => { const o = new Option(f, f); arrGroup.appendChild(o); });
    fieldSelect.appendChild(arrGroup);

    const scalarGroup = document.createElement('optgroup');
    scalarGroup.label = 'Scalar fields (set)';
    fields.scalar.forEach(f => { const o = new Option(f, f); scalarGroup.appendChild(o); });
    fieldSelect.appendChild(scalarGroup);
  }

  // Populate slug select
  if (slugCache[type]?.length) {
    populateSlugSelect(type);
  } else {
    fetch(`${API}/slugs?type=${type}`)
      .then(r => r.json())
      .then(data => { slugCache[type] = data; populateSlugSelect(type); })
      .catch(() => { slugSelect.innerHTML = '<option value="">— error loading slugs —</option>'; });
  }
}

function onFieldChange() {
  const field = document.getElementById('recField').value;
  const hint  = document.getElementById('fieldHint');
  const vHint = document.getElementById('valueHint');
  const vField = document.getElementById('valueField');
  const multiSelect = document.getElementById('recValueMulti');
  const scalarInput = document.getElementById('recValueScalar');

  resetValueField();
  if (!field) { hint.textContent = ''; updateAttachButton(); return; }

  const type = document.getElementById('recType').value;
  const isArr = FIELDS_BY_TYPE[type]?.array.includes(field);

  hint.innerHTML = `<span class="field-type-pill ${isArr ? 'pill-array' : 'pill-scalar'}">${isArr ? 'array · appends' : 'scalar · overwrites'}</span>`;

  if (isArr) {
    vField.className = 'form-field value-field is-multi';
    const source = ARRAY_FIELD_SOURCE[field];
    if (source && slugCache[source]) {
      multiSelect.innerHTML = '';
      slugCache[source].forEach(({ slug }) => {
        const o = new Option(slug, slug);
        multiSelect.appendChild(o);
      });
      vHint.textContent = `Ctrl/Cmd+click to select multiple · ${slugCache[source].length} options`;
    } else if (source) {
      // Fetch if not cached
      fetch(`${API}/slugs?type=${source}`)
        .then(r => r.json())
        .then(data => {
          slugCache[source] = data;
          multiSelect.innerHTML = '';
          data.forEach(({ slug }) => { multiSelect.appendChild(new Option(slug, slug)); });
          vHint.textContent = `Ctrl/Cmd+click to select multiple · ${data.length} options`;
        });
    }
  } else {
    vField.className = 'form-field value-field is-scalar';
    scalarInput.value = '';
    // Fixed options for known scalar fields
    const datalist = document.getElementById('valueList');
    datalist.innerHTML = '';
    if (SCALAR_OPTIONS[field]) {
      SCALAR_OPTIONS[field].forEach(v => datalist.appendChild(new Option(v, v)));
      vHint.textContent = SCALAR_OPTIONS[field].join(' | ');
    } else {
      vHint.textContent = '';
    }
  }

  updateAttachButton();
}

function resetValueField() {
  document.getElementById('valueField').className = 'form-field value-field is-scalar';
  document.getElementById('recValueScalar').value = '';
  document.getElementById('recValueMulti').innerHTML = '';
  document.getElementById('valueHint').textContent = '';
  document.getElementById('valueList').innerHTML = '';
}

function getSelectedValues() {
  const vField = document.getElementById('valueField');
  if (vField.classList.contains('is-multi')) {
    return Array.from(document.getElementById('recValueMulti').selectedOptions).map(o => o.value);
  } else {
    const v = document.getElementById('recValueScalar').value.trim();
    return v ? [v] : [];
  }
}

function updateAttachButton() {
  const type  = document.getElementById('recType').value;
  const slug  = document.getElementById('recSlug').value;
  const field = document.getElementById('recField').value;
  const hasAll = type && slug && field;
  document.getElementById('btnAttachContinue').disabled = !hasAll;
  document.getElementById('btnAttachDone').disabled = !hasAll;
  document.getElementById('btnDetach').disabled = !hasAll;
}

// ── preview ────────────────────────────────────────────────────────────────
async function loadPreview(highlightField = null) {
  const type = document.getElementById('recType').value;
  const slug = document.getElementById('recSlug').value.trim();
  if (!type || !slug) return;

  const area = document.getElementById('previewArea');
  area.innerHTML = '<div class="record-preview"><div class="preview-body"><span class="loading">Loading record…</span></div></div>';

  try {
    const data = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    currentRecord = data;
    renderPreview(data.data, data.filePath, highlightField);
  } catch (e) {
    area.innerHTML = `<div class="record-preview"><div class="preview-body" style="color:var(--red)">${e.message}</div></div>`;
  }
}

function renderPreview(fm, filePath, highlightField) {
  const skipKeys = ['layout', 'permalink'];
  const rows = Object.entries(fm)
    .filter(([k]) => !skipKeys.includes(k))
    .map(([k, v]) => {
      const isArr = Array.isArray(v);
      const isEmpty = v === '' || v === null || v === undefined || (isArr && v.length === 0);
      const display = isArr ? (v.length ? v.join(', ') : '(empty)') : (isEmpty ? '(empty)' : String(v));
      const cls = `fm-val${isArr ? ' is-array' : ''}${isEmpty ? ' is-empty' : ''}${k === highlightField ? ' just-changed' : ''}`;
      return `<div class="fm-row"><span class="fm-key">${k}</span><span class="${cls}">${escHtml(display)}</span></div>`;
    }).join('');

  const shortPath = filePath.replace(/^.*\/site\//, 'site/');
  document.getElementById('previewArea').innerHTML = `
    <div class="record-preview">
      <div class="preview-header">
        <span>Front matter preview</span>
        <span style="font-family:monospace;font-weight:400">${escHtml(shortPath)}</span>
      </div>
      <div class="preview-body">${rows}</div>
    </div>`;
}

function clearPreview() {
  document.getElementById('previewArea').innerHTML = '';
  currentRecord = null;
}

// ── attach / detach ────────────────────────────────────────────────────────
async function doAttach(mode = 'done') {
  const type  = document.getElementById('recType').value;
  const slug  = document.getElementById('recSlug').value;
  const field = document.getElementById('recField').value;
  const values = getSelectedValues();

  if (!values.length) { toast('Select at least one value to attach.', 'error'); return; }

  let anyChanged = false;
  const attached = [];

  for (const value of values) {
    try {
      const result = await api('POST', '/attach', { type, slug, field, value });
      if (result.changed) { anyChanged = true; attached.push(value); }
    } catch (e) {
      toast(`Error attaching "${value}": ${e.message}`, 'error');
      return;
    }
  }

  if (!anyChanged) {
    toast('No changes — all values already present.', '');
  } else {
    const label = attached.join(', ');
    toast(`Attached: ${field} ← ${label}`, 'success');
    logChange(`ATTACH  ${type}:${slug}  ${field} ← ${label}`);
    await loadPreview(field);
    await refreshSessionStatus();
  }

  if (mode === 'continue') {
    // Clear value only — keep type, slug, field
    resetValueField();
    onFieldChange(); // re-populate the value list
  } else {
    // Clear everything
    document.getElementById('recType').value = '';
    document.getElementById('recSlug').innerHTML = '<option value="">— select a type first —</option>';
    document.getElementById('recSlug').disabled = true;
    document.getElementById('recField').innerHTML = '<option value="">— select field —</option>';
    document.getElementById('slugHint').textContent = '';
    document.getElementById('fieldHint').textContent = '';
    resetValueField();
    clearPreview();
    updateAttachButton();
  }
}

async function doDetach() {
  const type   = document.getElementById('recType').value;
  const slug   = document.getElementById('recSlug').value;
  const field  = document.getElementById('recField').value;
  const values = getSelectedValues();

  if (!values.length) { toast('Select at least one value to detach.', 'error'); return; }

  const label = values.join(', ');
  if (!confirm(`Remove "${label}" from ${field} on ${slug}?`)) return;

  let anyChanged = false;
  for (const value of values) {
    try {
      const result = await api('POST', '/detach', { type, slug, field, value });
      if (result.changed) anyChanged = true;
    } catch (e) {
      toast(`Error detaching "${value}": ${e.message}`, 'error');
      return;
    }
  }

  if (!anyChanged) {
    toast(`Values not found in ${field} — no change.`, '');
  } else {
    toast(`Detached: ${field} — ${label}`, 'success');
    logChange(`DETACH  ${type}:${slug}  ${field} — ${label}`);
    await loadPreview(field);
    await refreshSessionStatus();
  }
}

// ── session controls ───────────────────────────────────────────────────────
async function refreshSessionStatus() {
  try {
    const data = await api('GET', '/session');
    sessionData = data;
    updateChangeCount(data.pendingCount);
  } catch { /* ignore */ }
}

function openCommitModal() {
  const changes = sessionData?.changes || [];
  const listEl = document.getElementById('modalChangesList');
  listEl.textContent = changes.length
    ? changes.map(c => `${c.status}  ${c.path}`).join('\n')
    : 'No changes tracked yet.';

  // Generate a default message from session changelog
  const msg = sessionChangelog.length
    ? sessionChangelog.slice(0, 3).join('; ')
    : 'Admin tool: front matter updates';
  document.getElementById('commitMsg').value = msg;

  document.getElementById('commitModal').classList.add('open');
}

function closeCommitModal() {
  document.getElementById('commitModal').classList.remove('open');
}

async function doCommit() {
  const message = document.getElementById('commitMsg').value.trim();
  if (!message) { toast('Commit message required.', 'error'); return; }

  try {
    const result = await api('POST', '/session/commit', { message });
    toast(`Committed: ${result.hash}`, 'success');
    closeCommitModal();
    sessionChangelog = [];
    await refreshSessionStatus();
    document.getElementById('btnPush').disabled = false;
  } catch (e) {
    toast(e.message, 'error');
  }
}

async function pushBranch() {
  if (!confirm(`Push ${sessionData?.branch} to origin?`)) return;
  try {
    const result = await api('POST', '/session/push', {});
    toast(`Pushed: ${result.branch}`, 'success');
  } catch (e) {
    toast(e.message, 'error');
  }
}

// ── changelog ──────────────────────────────────────────────────────────────
function logChange(entry) {
  sessionChangelog.push(entry);
  const area = document.getElementById('changelogArea');
  const entries = document.getElementById('changelogEntries');
  area.style.display = 'block';
  const div = document.createElement('div');
  div.className = 'changelog-entry';
  div.textContent = entry;
  entries.insertBefore(div, entries.firstChild);
}

// ── tab switching ──────────────────────────────────────────────────────────
function switchTab(name) {
  const tabNames = ['attach', 'edit', 'photos', 'newprofile', 'todo', 'feedback', null];
  document.querySelectorAll('.tab-btn').forEach((b, i) => {
    b.classList.toggle('active', tabNames[i] === name);
  });
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  const panel = document.getElementById(`panel-${name}`);
  if (panel) panel.classList.add('active');
}

// ── edit record — field map ────────────────────────────────────────────────
// Maps record type → tab label → array of { field, type, source? }
// type: 'scalar' | 'array'
// source: slug cache key to populate add-list (for array fields)
const EDIT_TABS = {
  document: {
    'Record info': [
      { field: 'title',       type: 'scalar' },
      { field: 'status',      type: 'scalar', options: ['draft','published','redacted'] },
      { field: 'date',        type: 'scalar' },
      { field: 'date_known',  type: 'scalar', options: ['true','false'] },
      { field: 'doc_type',    type: 'scalar' },
      { field: 'author',     type: 'scalar', source: 'soldier' },
      { field: 'archive_id',  type: 'scalar' },
    ],
    'Soldiers': [
      { field: 'author',    type: 'scalar', source: 'soldier' },
      { field: 'contains',  type: 'array',  source: 'soldier' },
      { field: 'tagged',    type: 'array',  source: 'soldier' },
    ],
    'Source': [
      { field: 'source_url',  type: 'scalar' },
      { field: 'source_type', type: 'scalar' },
    ],
    'Images': [
      { field: 'images', type: 'array' },
    ],
  },
  event: {
    'Record info': [
      { field: 'title',      type: 'scalar' },
      { field: 'status',     type: 'scalar', options: ['draft','published'] },
      { field: 'date',       type: 'scalar' },
      { field: 'date_known', type: 'scalar', options: ['true','false'] },
      { field: 'location',   type: 'scalar' },
      { field: 'type',       type: 'scalar' },
    ],
    'Soldiers': [
      { field: 'contains',   type: 'array', source: 'soldier' },
      { field: 'tagged',     type: 'array', source: 'soldier' },
    ],
    'Documents': [
      { field: 'accounts',        type: 'array', source: 'document' },
      { field: 'related_events',  type: 'array', source: 'event' },
    ],
    'Context': [
      { field: 'date_note',          type: 'scalar' },
      { field: 'location_note',      type: 'scalar' },
      { field: 'lat',                type: 'scalar' },
      { field: 'lon',                type: 'scalar' },
      { field: 'location_precision', type: 'scalar' },
    ],
  },
  soldier: {
    'Record info': [
      { field: 'title',                type: 'scalar' },
      { field: 'status',               type: 'scalar', options: ['veteran','deceased','kia','researching'] },
      { field: 'rank',                 type: 'scalar' },
      { field: 'mos',                  type: 'scalar' },
      { field: 'platoon',              type: 'scalar' },
      { field: 'hometown',             type: 'scalar' },
      { field: 'arrived',              type: 'scalar' },
      { field: 'departed',             type: 'scalar' },
      { field: 'character_of_service', type: 'scalar', options: ['Honorable','General','Other than Honorable','Bad Conduct','Dishonorable'] },
    ],
    'Identity': [
      { field: 'first_name',  type: 'scalar' },
      { field: 'last_name',   type: 'scalar' },
      { field: 'middle_name', type: 'scalar' },
      { field: 'nickname',    type: 'scalar' },
      { field: 'breadcrumb',  type: 'scalar' },
    ],
    'Flags': [
      { field: 'family_contact',         type: 'scalar', options: ['true','false'] },
      { field: 'wartime_content_notice', type: 'scalar', options: ['true','false'] },
      { field: 'associated',             type: 'scalar', options: ['true','false'] },
      { field: 'associated_unit',        type: 'scalar' },
      { field: 'profile_photo',          type: 'scalar' },
    ],
    'Decorations': [
      { field: 'decorations',               type: 'array_text' },
      { field: 'distinguished_decorations', type: 'array_text' },
    ],
    'Links': [
      { field: 'brothers',  type: 'array', source: 'soldier' },
      { field: 'documents', type: 'array', source: 'document' },
    ],
  },
  anecdote: {
    'Record info': [
      { field: 'title',      type: 'scalar' },
      { field: 'status',     type: 'scalar', options: ['draft','published'] },
      { field: 'archive_id', type: 'scalar' },
    ],
    'Soldiers': [
      { field: 'contains', type: 'array', source: 'soldier' },
      { field: 'tagged',   type: 'array', source: 'soldier' },
    ],
    'Source': [
      { field: 'event', type: 'scalar', source: 'event' },
    ],
  },
};

// ── edit record — state ────────────────────────────────────────────────────
let editRecord = null;       // current loaded record { data, filePath }
let editFieldDef = null;     // current field definition { field, type, source?, options? }
let editSelectedIndex = null; // for array remove — which index is selected

// ── edit record — cascade ──────────────────────────────────────────────────
function onEditTypeChange() {
  const type = document.getElementById('editType').value;
  const slugSel = document.getElementById('editSlug');
  const tabSel  = document.getElementById('editTab');
  const fieldSel = document.getElementById('editField');

  slugSel.innerHTML = '<option value="">— loading… —</option>';
  slugSel.disabled = true;
  tabSel.innerHTML = '<option value="">— select a record first —</option>';
  tabSel.disabled = true;
  fieldSel.innerHTML = '<option value="">— select a tab first —</option>';
  fieldSel.disabled = true;
  hideEditValue();
  editRecord = null;

  if (!type) { slugSel.innerHTML = '<option value="">— select a type first —</option>'; return; }

  const populate = (items) => {
    slugSel.innerHTML = '<option value="">— select slug —</option>';
    items.forEach(({ slug }) => slugSel.appendChild(new Option(slug, slug)));
    slugSel.disabled = false;
    document.getElementById('editSlugHint').textContent = `${items.length} record${items.length !== 1 ? 's' : ''} available`;
  };

  if (slugCache[type]?.length) { populate(slugCache[type]); return; }
  fetch(`${API}/slugs?type=${type}`)
    .then(r => r.json())
    .then(d => { slugCache[type] = d; populate(d); })
    .catch(() => { slugSel.innerHTML = '<option value="">— error loading slugs —</option>'; });
}

async function onEditSlugChange() {
  const type = document.getElementById('editType').value;
  const slug = document.getElementById('editSlug').value;
  const tabSel = document.getElementById('editTab');
  const fieldSel = document.getElementById('editField');

  tabSel.innerHTML = '<option value="">— select tab —</option>';
  tabSel.disabled = true;
  fieldSel.innerHTML = '<option value="">— select a tab first —</option>';
  fieldSel.disabled = true;
  hideEditValue();
  editRecord = null;
  document.getElementById('editPreviewArea').innerHTML = '';

  if (!type || !slug) return;

  // Load the record
  try {
    const data = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    editRecord = data;
    renderEditPreview(data.data, data.filePath);
  } catch (e) {
    toast(`Could not load record: ${e.message}`, 'error');
    return;
  }

  // Populate tab dropdown
  const tabs = EDIT_TABS[type];
  if (tabs) {
    Object.keys(tabs).forEach(tabName => tabSel.appendChild(new Option(tabName, tabName)));
    tabSel.disabled = false;
  }
}

function onEditTabChange() {
  const type    = document.getElementById('editType').value;
  const tabName = document.getElementById('editTab').value;
  const fieldSel = document.getElementById('editField');

  fieldSel.innerHTML = '<option value="">— select field —</option>';
  fieldSel.disabled = true;
  hideEditValue();
  editFieldDef = null;

  if (!tabName || !EDIT_TABS[type]?.[tabName]) return;

  const fields = EDIT_TABS[type][tabName];
  fields.forEach(f => fieldSel.appendChild(new Option(f.field, f.field)));
  fieldSel.disabled = false;
}

async function onEditFieldChange() {
  const type     = document.getElementById('editType').value;
  const tabName  = document.getElementById('editTab').value;
  const fieldKey = document.getElementById('editField').value;

  hideEditValue();
  editFieldDef = null;
  editSelectedIndex = null;

  if (!fieldKey) return;

  const fields = EDIT_TABS[type]?.[tabName] || [];
  editFieldDef = fields.find(f => f.field === fieldKey);
  if (!editFieldDef) return;

  const currentVal = editRecord?.data?.[fieldKey];
  const hint = document.getElementById('editFieldHint');

  document.getElementById('editValueArea').style.display = 'block';
  document.getElementById('editActionRow').style.display = 'flex';

  if (editFieldDef.type === 'scalar') {
    document.getElementById('editScalarArea').style.display = 'block';
    document.getElementById('editArrayArea').style.display = 'none';
    document.getElementById('btnEditRemove').style.display = 'none';

    // Show current value
    const cur = document.getElementById('editCurrentVal');
    cur.textContent = (currentVal === null || currentVal === undefined || currentVal === '')
      ? '(empty)' : String(currentVal);

    // Populate datalist for known options
    const dl = document.getElementById('editValueList');
    dl.innerHTML = '';
    if (editFieldDef.options) {
      editFieldDef.options.forEach(o => dl.appendChild(new Option(o, o)));
      hint.textContent = editFieldDef.options.join(' | ');
    } else if (editFieldDef.source && slugCache[editFieldDef.source]) {
      slugCache[editFieldDef.source].forEach(({ slug }) => dl.appendChild(new Option(slug, slug)));
      hint.textContent = `${editFieldDef.source} slug`;
    } else {
      hint.textContent = '';
    }

    document.getElementById('editNewVal').value = '';
    document.getElementById('btnEditApply').disabled = false;
    document.getElementById('btnEditDone').disabled = false;

  } else if (editFieldDef.type === 'array' || editFieldDef.type === 'array_text') {
    document.getElementById('editScalarArea').style.display = 'none';
    document.getElementById('editArrayArea').style.display = 'block';
    document.getElementById('btnEditRemove').style.display = 'block';
    document.getElementById('btnEditRemove').disabled = true;

    renderArrayCurrent(currentVal || []);

    if (editFieldDef.type === 'array_text') {
      document.getElementById('editArrayAddSelect').style.display = 'none';
      document.getElementById('editArrayAddText').style.display = 'block';
      document.getElementById('editArrayTextVal').value = '';
      hint.textContent = 'array (free text)';
    } else {
      document.getElementById('editArrayAddSelect').style.display = 'block';
      document.getElementById('editArrayAddText').style.display = 'none';

      const addSel = document.getElementById('editArrayAdd');
      addSel.innerHTML = '';
      const source = editFieldDef.source;
      if (source) {
        const populate = (items) => {
          items.forEach(({ slug }) => addSel.appendChild(new Option(slug, slug)));
          document.getElementById('editArrayHint').textContent =
            `Ctrl/Cmd+click to select multiple · ${items.length} options`;
        };
        if (slugCache[source]?.length) { populate(slugCache[source]); }
        else {
          fetch(`${API}/slugs?type=${source}`)
            .then(r => r.json())
            .then(d => { slugCache[source] = d; populate(d); });
        }
      }
      hint.textContent = 'array field';
    }

    document.getElementById('btnEditApply').disabled = false;
    document.getElementById('btnEditDone').disabled = false;
  }
}

function renderArrayCurrent(arr) {
  const container = document.getElementById('editArrayCurrent');
  container.innerHTML = '';
  editSelectedIndex = null;

  if (!arr.length) {
    container.innerHTML = '<span style="font-size:12px;color:var(--muted);font-style:italic;">(empty)</span>';
    return;
  }

  arr.forEach((item, i) => {
    const label = typeof item === 'object' ? (item.slug || JSON.stringify(item)) : String(item);
    const chip = document.createElement('div');
    chip.style.cssText = 'padding:3px 8px;border:1px solid var(--rule);border-radius:2px;font-size:12px;font-family:monospace;cursor:pointer;background:#fff;';
    chip.textContent = label;
    chip.dataset.index = i;
    chip.onclick = () => {
      container.querySelectorAll('div').forEach(c => c.style.background = '#fff');
      chip.style.background = '#fee2e2';
      chip.style.borderColor = 'var(--red)';
      editSelectedIndex = i;
      document.getElementById('btnEditRemove').disabled = false;
    };
    container.appendChild(chip);
  });
}

function hideEditValue() {
  document.getElementById('editValueArea').style.display = 'none';
  document.getElementById('editActionRow').style.display = 'none';
  document.getElementById('editScalarArea').style.display = 'none';
  document.getElementById('editArrayArea').style.display = 'none';
  document.getElementById('editFieldHint').textContent = '';
  document.getElementById('btnEditApply').disabled = true;
  document.getElementById('btnEditDone').disabled = true;
}

// ── edit record — actions ──────────────────────────────────────────────────
async function doEdit(mode = 'done') {
  const type  = document.getElementById('editType').value;
  const slug  = document.getElementById('editSlug').value;
  const field = editFieldDef?.field;

  if (!field) return;

  if (editFieldDef.type === 'scalar') {
    const newVal = document.getElementById('editNewVal').value.trim();
    if (!newVal) { toast('Enter a new value.', 'error'); return; }

    try {
      await api('POST', '/edit', { type, slug, field, value: newVal });
      toast(`Updated: ${field} → ${newVal}`, 'success');
      logChange(`EDIT  ${type}:${slug}  ${field} → "${newVal}"`);
      const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
      editRecord = rec;
      renderEditPreview(rec.data, rec.filePath);
      document.getElementById('editCurrentVal').textContent = newVal;
      document.getElementById('editNewVal').value = '';
      await refreshSessionStatus();
    } catch (e) { toast(e.message, 'error'); return; }

  } else if (editFieldDef.type === 'array_text') {
    const val = document.getElementById('editArrayTextVal').value.trim();
    if (!val) { toast('Enter a value to add.', 'error'); return; }

    try {
      await api('POST', '/attach', { type, slug, field, value: val });
      toast(`Added to ${field}: "${val}"`, 'success');
      logChange(`EDIT  ${type}:${slug}  ${field} += "${val}"`);
      const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
      editRecord = rec;
      renderEditPreview(rec.data, rec.filePath);
      renderArrayCurrent(rec.data[field] || []);
      document.getElementById('editArrayTextVal').value = '';
      await refreshSessionStatus();
    } catch (e) { toast(e.message, 'error'); return; }

  } else {
    // Array — add selected items
    const addSel = document.getElementById('editArrayAdd');
    const toAdd = Array.from(addSel.selectedOptions).map(o => o.value);
    if (!toAdd.length) { toast('Select at least one value to add.', 'error'); return; }

    for (const value of toAdd) {
      try {
        await api('POST', '/attach', { type, slug, field, value });
      } catch (e) { toast(`Error adding "${value}": ${e.message}`, 'error'); return; }
    }
    toast(`Added to ${field}: ${toAdd.join(', ')}`, 'success');
    logChange(`EDIT  ${type}:${slug}  ${field} += ${toAdd.join(', ')}`);
    const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    editRecord = rec;
    renderEditPreview(rec.data, rec.filePath);
    renderArrayCurrent(rec.data[field] || []);
    await refreshSessionStatus();
  }

  if (mode === 'done') {
    document.getElementById('editType').value = '';
    document.getElementById('editSlug').innerHTML = '<option value="">— select a type first —</option>';
    document.getElementById('editSlug').disabled = true;
    document.getElementById('editTab').innerHTML = '<option value="">— select a record first —</option>';
    document.getElementById('editTab').disabled = true;
    document.getElementById('editField').innerHTML = '<option value="">— select a tab first —</option>';
    document.getElementById('editField').disabled = true;
    document.getElementById('editSlugHint').textContent = '';
    hideEditValue();
    document.getElementById('editPreviewArea').innerHTML = '';
    editRecord = null;
    editFieldDef = null;
  }
}

async function doRemove() {
  const type  = document.getElementById('editType').value;
  const slug  = document.getElementById('editSlug').value;
  const field = editFieldDef?.field;

  if (editSelectedIndex === null || editSelectedIndex === undefined) {
    toast('Select an entry to remove.', 'error'); return;
  }

  const arr = editRecord?.data?.[field] || [];
  const label = typeof arr[editSelectedIndex] === 'object'
    ? (arr[editSelectedIndex].slug || JSON.stringify(arr[editSelectedIndex]))
    : String(arr[editSelectedIndex]);

  if (!confirm(`Remove "${label}" from ${field}?`)) return;

  try {
    await api('POST', '/remove-from-array', { type, slug, field, index: editSelectedIndex });
    toast(`Removed "${label}" from ${field}`, 'success');
    logChange(`REMOVE  ${type}:${slug}  ${field} − "${label}"`);
    const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    editRecord = rec;
    renderEditPreview(rec.data, rec.filePath);
    renderArrayCurrent(rec.data[field] || []);
    editSelectedIndex = null;
    document.getElementById('btnEditRemove').disabled = true;
    await refreshSessionStatus();
  } catch (e) { toast(e.message, 'error'); }
}

function renderEditPreview(fm, filePath) {
  const type         = editRecord?.type;
  const skipKeys     = new Set(['layout', 'permalink']);
  const readonlyKeys = new Set(['slug', 'archive_id']);

  // Flatten all field defs for this record type into a map
  const fieldDefs = {};
  if (type && EDIT_TABS[type]) {
    for (const fields of Object.values(EDIT_TABS[type])) {
      for (const def of fields) fieldDefs[def.field] = def;
    }
  }

  const rows = Object.entries(fm)
    .filter(([k]) => !skipKeys.has(k))
    .map(([k, v]) => {
      const isArr     = Array.isArray(v);
      const isComplex = isArr && v.length > 0 && typeof v[0] === 'object';
      const isEmpty   = v === '' || v === null || v === undefined || (isArr && v.length === 0);

      const display = isComplex
        ? `[${v.length} entr${v.length === 1 ? 'y' : 'ies'}]`
        : isArr
          ? (v.length ? v.join(', ') : '(empty)')
          : (isEmpty ? '(empty)' : String(v));

      const valCls  = `fm-val${isArr ? ' is-array' : ''}${isEmpty ? ' is-empty' : ''}`;
      const isReadonly = readonlyKeys.has(k);
      const def        = fieldDefs[k];
      const canEdit    = !isReadonly && !!def && !isComplex;

      if (!canEdit) {
        const lockIcon = isReadonly ? ` <span class="fm-lock" title="read-only">⊘</span>` : '';
        return `<div class="fm-row"><span class="fm-key">${escHtml(k)}${lockIcon}</span><span class="${valCls}">${escHtml(display)}</span></div>`;
      }

      if (k === 'profile_photo') {
        return `<div class="fm-row fm-row-clickable" onclick="openProfilePhotoModal()">
          <span class="fm-key">${escHtml(k)}</span>
          <span class="${valCls} fm-editable">${escHtml(display)}<span class="fm-edit-hint">📷 set photo</span></span>
        </div>`;
      }

      if (def.type === 'array' || def.type === 'array_text') {
        return `<div class="fm-row fm-row-clickable" onclick="openArrayPopover(this, '${k}')">
          <span class="fm-key">${escHtml(k)}</span>
          <span class="${valCls} fm-editable">${escHtml(display)}<span class="fm-edit-hint">✏ edit</span></span>
        </div>`;
      }

      return `<div class="fm-row fm-row-clickable" onclick="activateInlineEdit(this, '${k}')">
        <span class="fm-key">${escHtml(k)}</span>
        <span class="${valCls} fm-editable" id="fm-val-${k}">${escHtml(display)}<span class="fm-edit-hint">✏</span></span>
      </div>`;
    }).join('');

  const shortPath = filePath.replace(/^.*\/site\//, 'site/');
  document.getElementById('editPreviewArea').innerHTML = `
    <div class="record-preview" style="margin-top:20px;">
      <div class="preview-header">
        <span>Front matter — click any field to edit</span>
        <span style="font-family:monospace;font-weight:400">${escHtml(shortPath)}</span>
      </div>
      <div class="preview-body">${rows}</div>
    </div>`;
}

// ── field def lookup ───────────────────────────────────────────────────────
function getFieldDef(type, field) {
  if (!type || !EDIT_TABS[type]) return null;
  for (const fields of Object.values(EDIT_TABS[type])) {
    const def = fields.find(f => f.field === field);
    if (def) return def;
  }
  return null;
}

// ── inline scalar editing ──────────────────────────────────────────────────
function activateInlineEdit(row, field) {
  const existing = document.querySelector('.fm-inline-active');
  if (existing && existing !== row) cancelInlineEdit(existing);
  if (row.classList.contains('fm-inline-active')) return;

  row.classList.add('fm-inline-active');

  const type       = editRecord?.type;
  const def        = getFieldDef(type, field);
  const currentVal = editRecord?.data?.[field];
  const valSpan    = row.querySelector('.fm-val');

  let input;
  if (def?.options) {
    input = document.createElement('select');
    input.className = 'fm-inline-input';
    def.options.forEach(o => {
      const opt = new Option(o, o);
      if (String(currentVal) === o) opt.selected = true;
      input.appendChild(opt);
    });
  } else {
    input = document.createElement('input');
    input.type = 'text';
    input.className = 'fm-inline-input';
    input.value = (currentVal === null || currentVal === undefined) ? '' : String(currentVal);
  }

  valSpan.style.display = 'none';
  row.appendChild(input);
  input.focus();
  if (input.tagName === 'INPUT') input.select();

  input.addEventListener('keydown', async e => {
    if (e.key === 'Enter') { e.preventDefault(); await saveInlineEdit(row, field, input.value); }
    else if (e.key === 'Escape') cancelInlineEdit(row);
  });

  if (input.tagName === 'SELECT') {
    input.addEventListener('change', async () => saveInlineEdit(row, field, input.value));
  }

  input.addEventListener('blur', () => setTimeout(() => {
    if (row.classList.contains('fm-inline-active')) cancelInlineEdit(row);
  }, 160));
}

function cancelInlineEdit(row) {
  row.classList.remove('fm-inline-active');
  row.querySelector('.fm-inline-input')?.remove();
  const valSpan = row.querySelector('.fm-val');
  if (valSpan) valSpan.style.display = '';
}

async function saveInlineEdit(row, field, newVal) {
  const type    = editRecord?.type;
  const slug    = editRecord?.slug;
  const trimmed = String(newVal).trim();
  if (!type || !slug || !trimmed) { cancelInlineEdit(row); return; }

  try {
    await api('POST', '/edit', { type, slug, field, value: trimmed });
    toast(`${field} → ${trimmed}`, 'success');
    logChange(`EDIT  ${type}:${slug}  ${field} → "${trimmed}"`);
    const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    editRecord = rec;
    renderEditPreview(rec.data, rec.filePath);
    await refreshSessionStatus();
  } catch (e) {
    toast(e.message, 'error');
    cancelInlineEdit(row);
  }
}

// ── array field popover ────────────────────────────────────────────────────
let fmPopoverField = null;

function openArrayPopover(row, field) {
  const activeInline = document.querySelector('.fm-inline-active');
  if (activeInline) cancelInlineEdit(activeInline);

  fmPopoverField = field;
  const type = editRecord?.type;
  const def  = getFieldDef(type, field);
  const arr  = editRecord?.data?.[field] || [];

  document.getElementById('fm-popover-title').textContent = field;
  renderPopoverChips(field, arr);

  if (def?.type === 'array_text') {
    document.getElementById('fm-popover-add-select').style.display = 'none';
    document.getElementById('fm-popover-add-text').style.display   = 'block';
    document.getElementById('fm-popover-text').value = '';
  } else {
    document.getElementById('fm-popover-add-select').style.display = 'block';
    document.getElementById('fm-popover-add-text').style.display   = 'none';
    const sel    = document.getElementById('fm-popover-select');
    sel.innerHTML = '';
    const source = def?.source;
    if (source) {
      const populate = items => {
        items.forEach(({ slug }) => sel.appendChild(new Option(slug, slug)));
        document.getElementById('fm-popover-select-hint').textContent =
          `Ctrl/Cmd+click for multiple · ${items.length} options`;
      };
      if (slugCache[source]?.length) populate(slugCache[source]);
      else fetch(`${API}/slugs?type=${source}`)
        .then(r => r.json())
        .then(d => { slugCache[source] = d; populate(d); });
    }
  }

  const popover = document.getElementById('fm-popover');
  popover.classList.add('open');
  const rowRect = row.getBoundingClientRect();
  let top  = rowRect.bottom + window.scrollY + 4;
  let left = rowRect.left   + window.scrollX;
  if (left + 348 > window.innerWidth) left = window.innerWidth - 356;
  if (left < 4) left = 4;
  popover.style.top  = top  + 'px';
  popover.style.left = left + 'px';
}

function renderPopoverChips(field, arr) {
  const container = document.getElementById('fm-popover-chips');
  if (!arr.length) {
    container.innerHTML = '<span style="font-size:11px;color:var(--muted);font-style:italic;">(empty)</span>';
    return;
  }
  container.innerHTML = '';
  arr.forEach((item, i) => {
    const label = typeof item === 'object' ? (item.slug || JSON.stringify(item)) : String(item);
    const chip  = document.createElement('span');
    chip.className = 'fm-chip';
    chip.innerHTML = `${escHtml(label)} <span class="fm-chip-remove" onclick="fmPopoverRemove(${i})" title="remove">×</span>`;
    container.appendChild(chip);
  });
}

async function fmPopoverRemove(index) {
  const type  = editRecord?.type;
  const slug  = editRecord?.slug;
  const field = fmPopoverField;
  if (!field) return;

  const arr   = editRecord?.data?.[field] || [];
  const label = typeof arr[index] === 'object' ? (arr[index].slug || JSON.stringify(arr[index])) : String(arr[index]);
  if (!confirm(`Remove "${label}" from ${field}?`)) return;

  try {
    await api('POST', '/remove-from-array', { type, slug, field, index });
    toast(`Removed from ${field}`, 'success');
    logChange(`REMOVE  ${type}:${slug}  ${field} − "${label}"`);
    const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
    editRecord = rec;
    renderPopoverChips(field, rec.data[field] || []);
    renderEditPreview(rec.data, rec.filePath);
    await refreshSessionStatus();
  } catch (e) { toast(e.message, 'error'); }
}

async function fmPopoverAdd() {
  const type  = editRecord?.type;
  const slug  = editRecord?.slug;
  const field = fmPopoverField;
  const def   = getFieldDef(type, field);
  if (!field) return;

  let toAdd = [];
  if (def?.type === 'array_text') {
    const val = document.getElementById('fm-popover-text').value.trim();
    if (!val) { toast('Enter a value.', 'error'); return; }
    toAdd = [val];
    document.getElementById('fm-popover-text').value = '';
  } else {
    const sel = document.getElementById('fm-popover-select');
    toAdd = Array.from(sel.selectedOptions).map(o => o.value);
    if (!toAdd.length) { toast('Select at least one value.', 'error'); return; }
  }

  for (const value of toAdd) {
    try { await api('POST', '/attach', { type, slug, field, value }); }
    catch (e) { toast(`Error adding "${value}": ${e.message}`, 'error'); return; }
  }
  toast(`Added to ${field}: ${toAdd.join(', ')}`, 'success');
  logChange(`EDIT  ${type}:${slug}  ${field} += ${toAdd.join(', ')}`);

  const rec = await api('GET', `/record?type=${type}&slug=${encodeURIComponent(slug)}`);
  editRecord = rec;
  renderPopoverChips(field, rec.data[field] || []);
  renderEditPreview(rec.data, rec.filePath);
  await refreshSessionStatus();
}

function fmPopoverClose() {
  document.getElementById('fm-popover').classList.remove('open');
  fmPopoverField = null;
}

document.addEventListener('click', e => {
  const pop = document.getElementById('fm-popover');
  if (pop?.classList.contains('open')
      && !pop.contains(e.target)
      && !e.target.closest('.fm-row-clickable')) {
    fmPopoverClose();
  }
});

// ── profile photo modal ────────────────────────────────────────────────────
const PPH = { file: null, dataUrl: null, crop: null, dragging: false, startX: 0, startY: 0, imgRect: null };

function openProfilePhotoModal() {
  if (!editRecord) return;
  Object.assign(PPH, { file: null, dataUrl: null, crop: null, dragging: false });
  document.getElementById('pph-credit').value = '';
  document.getElementById('pph-photographer').value = '';
  document.getElementById('pph-file-input').value = '';
  pphCropReset();
  pphShowStep('drop');

  const dl = document.getElementById('pph-photographer-list');
  dl.innerHTML = '';
  const fill = items => items.forEach(({ slug }) => dl.appendChild(new Option(slug, slug)));
  if (slugCache.soldier?.length) fill(slugCache.soldier);
  else fetch(`${API}/slugs?type=soldier`).then(r => r.json())
        .then(d => { slugCache.soldier = d; fill(d); });

  const dz = document.getElementById('pph-drop-zone');
  dz.ondragover  = e => { e.preventDefault(); dz.classList.add('drag-over'); };
  dz.ondragleave = () => dz.classList.remove('drag-over');
  dz.ondrop      = e => { e.preventDefault(); dz.classList.remove('drag-over'); const f = e.dataTransfer.files[0]; if (f) pphLoadFile(f); };

  document.getElementById('pph-modal').classList.add('open');
}

function pphClose()        { document.getElementById('pph-modal').classList.remove('open'); }
function pphCloseBg(e)     { if (e.target === document.getElementById('pph-modal')) pphClose(); }
function pphShowStep(step) {
  document.querySelectorAll('.pph-step').forEach(el => el.classList.remove('active'));
  document.getElementById(`pph-step-${step}`).classList.add('active');
}
function pphBack()         { pphShowStep('drop'); }
function pphFileSelected(e) { const f = e.target.files[0]; if (f) pphLoadFile(f); }

function pphLoadFile(file) {
  PPH.file = file;
  const reader = new FileReader();
  reader.onload = ev => {
    PPH.dataUrl = ev.target.result;
    const img = document.getElementById('pph-crop-img');
    img.onload = pphBindCropEvents;
    img.src = PPH.dataUrl;
    pphShowStep('crop');
  };
  reader.readAsDataURL(file);
}

function pphBindCropEvents() {
  const overlay = document.getElementById('pph-crop-overlay');
  overlay.onmousedown = pphCropStart;
  document.addEventListener('mousemove', pphCropMove);
  document.addEventListener('mouseup',   pphCropEnd);
}

function pphCropStart(e) {
  const img = document.getElementById('pph-crop-img');
  if (!img.complete || !img.naturalWidth) return;
  e.preventDefault();
  PPH.dragging = true;
  PPH.imgRect  = img.getBoundingClientRect();
  PPH.startX   = e.clientX;
  PPH.startY   = e.clientY;
  PPH.crop     = null;
  document.getElementById('pph-crop-rect').style.display = 'none';
}

function pphCropMove(e) {
  if (!PPH.dragging) return;
  const ib   = PPH.imgRect;
  const wrap = document.getElementById('pph-crop-wrap').getBoundingClientRect();
  const x1 = Math.max(ib.left,   Math.min(PPH.startX, e.clientX));
  const y1 = Math.max(ib.top,    Math.min(PPH.startY, e.clientY));
  const x2 = Math.min(ib.right,  Math.max(PPH.startX, e.clientX));
  const y2 = Math.min(ib.bottom, Math.max(PPH.startY, e.clientY));
  const rect = document.getElementById('pph-crop-rect');
  rect.style.display = 'block';
  rect.style.left    = (x1 - wrap.left) + 'px';
  rect.style.top     = (y1 - wrap.top)  + 'px';
  rect.style.width   = (x2 - x1) + 'px';
  rect.style.height  = (y2 - y1) + 'px';
  PPH.crop = {
    x: (x1 - ib.left) / ib.width,
    y: (y1 - ib.top)  / ib.height,
    w: (x2 - x1)      / ib.width,
    h: (y2 - y1)      / ib.height,
  };
  document.getElementById('pph-crop-coords').textContent =
    `${Math.round(PPH.crop.w * 100)}×${Math.round(PPH.crop.h * 100)}%`;
}

function pphCropEnd() {
  if (!PPH.dragging) return;
  PPH.dragging = false;
  if (!PPH.crop || PPH.crop.w < 0.02 || PPH.crop.h < 0.02) pphCropReset();
}

function pphCropReset() {
  const r = document.getElementById('pph-crop-rect');
  const c = document.getElementById('pph-crop-coords');
  if (r) r.style.display = 'none';
  if (c) c.textContent   = 'drag to select — or skip for full image';
  PPH.crop = null;
}

async function pphSave() {
  const slug = editRecord?.slug;
  if (!slug || !PPH.dataUrl) return;

  const credit       = document.getElementById('pph-credit').value.trim();
  const photographer = document.getElementById('pph-photographer').value.trim();
  const crop         = (PPH.crop && PPH.crop.w > 0.02 && PPH.crop.h > 0.02) ? PPH.crop : null;

  try {
    const r = await api('POST', '/soldier/profile-photo', { slug, imageData: PPH.dataUrl, crop, credit, photographer });
    toast('Profile photo saved.', 'success');
    logChange(`PROFILE PHOTO  ${slug}  → ${r.filename}`);
    pphClose();
    const rec = await api('GET', `/record?type=soldier&slug=${encodeURIComponent(slug)}`);
    editRecord = rec;
    renderEditPreview(rec.data, rec.filePath);
    await refreshSessionStatus();
  } catch (e) {
    toast('Save failed: ' + e.message, 'error');
  }
}

// ── utilities ──────────────────────────────────────────────────────────────
async function api(method, path, body) {
  const opts = {
    method,
    headers: { 'Content-Type': 'application/json' },
  };
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(API + path, opts);
  const json = await res.json();
  if (!res.ok) throw new Error(json.error || `HTTP ${res.status}`);
  return json;
}

let toastTimer;
function toast(msg, type = '') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast show${type ? ' ' + type : ''}`;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 3500);
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>

<!-- ══════════════════════════════════════════════════════════════
     ADD ISSUE MODAL
     ══════════════════════════════════════════════════════════════ -->
<div id="add-issue-modal" class="modal-overlay" style="display:none" onclick="closeAddIssueModalIfBg(event)">
  <div class="modal-box">
    <div class="modal-header">
      <span class="modal-title">Log an Issue</span>
      <button class="modal-close" onclick="closeAddIssueModal()">✕</button>
    </div>

    <div class="modal-body">
      <div class="form-row">
        <label>ID (auto-generated)</label>
        <span id="add-issue-id-preview" class="id-preview">—</span>
      </div>

      <div class="form-row">
        <label for="ai-type">Type <span class="req">*</span></label>
        <select id="ai-type" onchange="updateAddIssueId()">
          <option value="">— select —</option>
          <option value="epic">Epic</option>
          <option value="bug">Bug</option>
          <option value="task">Task</option>
          <option value="research">Research</option>
        </select>
      </div>

      <div class="form-row">
        <label for="ai-scope">Scope <span class="req">*</span></label>
        <select id="ai-scope" onchange="updateAddIssueId()">
          <option value="">— select —</option>
          <option value="site">Site</option>
          <option value="admin">Admin</option>
          <option value="data">Data</option>
        </select>
      </div>

      <div class="form-row">
        <label for="ai-title">Title <span class="req">*</span></label>
        <input type="text" id="ai-title" placeholder="Short description" />
      </div>

      <div class="form-row">
        <label for="ai-notes">Notes</label>
        <textarea id="ai-notes" rows="3" placeholder="Optional detail, context, or steps to reproduce"></textarea>
      </div>

      <div class="form-row">
        <label for="ai-parent">Parent Epic</label>
        <select id="ai-parent">
          <option value="">None (flat task)</option>
        </select>
      </div>

      <div class="form-row">
        <label for="ai-relates">Relates To</label>
        <select id="ai-relates" multiple></select>
        <small>Ctrl/Cmd+click for multiple</small>
      </div>
    </div>

    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeAddIssueModal()">Cancel</button>
      <button class="btn-primary"   onclick="submitAddIssue()">Log Issue</button>
    </div>
  </div>
</div>


<!-- ══════════════════════════════════════════════════════════════
     TAB 4 CSS — Photo Intake
     ══════════════════════════════════════════════════════════════ -->
<style>
/* ── Sub-tabs ── */
.ph-subtabs {
  display: flex;
  gap: 4px;
  padding: 8px 16px 0;
  border-bottom: 1px solid var(--rule, #ccc);
}
.ph-subtab {
  padding: 6px 16px;
  background: none;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: 4px 4px 0 0;
  cursor: pointer;
  font-size: 0.88rem;
  color: var(--ink, #222);
}
.ph-subtab:hover  { background: var(--hover, #f0ede6); }
.ph-subtab.active {
  background: var(--paper, #fff);
  border-color: var(--rule, #ccc);
  border-bottom-color: var(--paper, #fff);
  font-weight: 600;
  margin-bottom: -1px;
}

/* ── Pane layout ── */
.ph-pane {
  display: flex;
  height: calc(100vh - 155px);
  overflow: hidden;
}
.ph-sidebar {
  width: 200px;
  min-width: 200px;
  border-right: 1px solid var(--rule, #ccc);
  overflow-y: auto;
  padding: 8px;
}
.ph-sidebar-toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 0 0 6px;
  border-bottom: 1px solid var(--rule, #e0e0e0);
  margin-bottom: 6px;
}
.btn-sm { font-size: 0.78rem; padding: 3px 10px; }
.ph-sidebar-heading {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-muted, #888);
  padding: 6px 4px 3px;
}
.ph-main {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px;
}

/* ── Folder list items ── */
.ph-folder-item {
  padding: 7px 8px;
  border-radius: 4px;
  cursor: pointer;
  margin-bottom: 2px;
}
.ph-folder-item:hover   { background: var(--hover, #f0ede6); }
.ph-folder-item.active  { background: var(--hover, #f0ede6); font-weight: 600; }
.ph-folder-item.is-staged { opacity: 0.5; }
.ph-folder-name { display: block; font-size: 0.88rem; }
.ph-folder-meta { display: block; font-size: 0.75rem; color: var(--ink-muted, #888); }

/* ── Raw detail ── */
.ph-detail-title { font-size: 1rem; font-weight: 700; margin: 0 0 4px; }
.ph-detail-meta  { font-size: 0.8rem; color: var(--ink-muted, #888); margin-bottom: 12px; }
.ph-notes {
  font-size: 0.82rem;
  background: var(--hover, #f0ede6);
  border-radius: 4px;
  padding: 8px 10px;
  margin-bottom: 12px;
  white-space: pre-wrap;
}
.ph-photos-list {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 16px;
}
.ph-photo-name {
  font-size: 0.75rem;
  font-family: monospace;
  background: var(--surface, #faf8f4);
  border: 1px solid var(--rule, #ccc);
  border-radius: 3px;
  padding: 2px 6px;
}
.ph-stage-form { display: flex; flex-direction: column; gap: 8px; }

/* ── Crop preview ── */
.ph-crop-wrap {
  position: relative;
  display: inline-block;
  cursor: crosshair;
  margin-bottom: 10px;
  max-width: 100%;
}
.ph-crop-img {
  display: block;
  max-width: 100%;
  max-height: 340px;
  width: auto;
  height: auto;
  pointer-events: none;
  user-select: none;
}
.ph-crop-overlay {
  position: absolute;
  inset: 0;
}
.ph-crop-rect {
  position: absolute;
  border: 2px solid #f5c800;
  background: rgba(245,200,0,0.08);
  box-sizing: border-box;
  pointer-events: none;
}
.ph-crop-section {
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--rule, #eee);
}
.ph-crop-section:last-child { border-bottom: none; }
.ph-crop-fname {
  font-family: monospace;
  font-size: 0.75rem;
  color: var(--ink-muted, #888);
  margin-bottom: 6px;
}
.ph-crop-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}
.ph-crop-coords {
  font-size: 0.72rem;
  font-family: monospace;
  color: var(--ink-muted, #aaa);
}

/* ── Rename table ── */
.ph-rename-table {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 4px 8px;
  margin-bottom: 12px;
  font-size: 0.78rem;
}
.ph-rename-orig {
  font-family: monospace;
  color: var(--ink-muted, #888);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ph-rename-arrow { color: var(--ink-muted, #aaa); user-select: none; }
.ph-rename-input {
  font-family: monospace;
  font-size: 0.78rem;
  padding: 3px 6px;
  border: 1px solid var(--rule, #ccc);
  border-radius: 3px;
  width: 100%;
  box-sizing: border-box;
}
.ph-rename-input.is-changed {
  border-color: var(--yellow, #f5c800);
  background: #fffde7;
}

/* ── Submissions pane ── */
.ph-submissions-pane {
  flex-direction: column;
  overflow: hidden;
}
.ph-submissions-toolbar {
  padding: 8px 16px 6px;
  border-bottom: 1px solid var(--rule, #ccc);
  display: flex;
  justify-content: flex-end;
  flex-shrink: 0;
}
.ph-submissions-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.ph-sub-card {
  border: 1px solid var(--rule, #ccc);
  border-radius: 6px;
  padding: 14px 16px;
  background: var(--paper, #fff);
}
.ph-sub-card.ph-sub-pulled {
  border-color: #4caf50;
  background: #f6fff6;
}
.ph-sub-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}
.ph-sub-soldier {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 2px;
}
.ph-sub-meta {
  font-size: 0.78rem;
  color: var(--ink-muted, #888);
  margin-bottom: 2px;
}
.ph-sub-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.ph-sub-pulled-label {
  font-size: 0.8rem;
  color: #4caf50;
  font-weight: 600;
}
.ph-sub-notes {
  margin-bottom: 8px;
  font-size: 0.78rem;
  max-height: 80px;
  overflow-y: auto;
}
.ph-error { color: #c0392b; font-size: 0.85rem; }

/* ── Staging folder header (slug + revert) ── */
.ph-staging-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--rule, #e0e0e0);
}
.ph-staging-slug {
  font-size: 0.82rem;
  font-family: monospace;
  color: var(--ink-muted, #888);
}
.btn-revert {
  font-size: 0.78rem;
  padding: 3px 10px;
  background: transparent;
  color: var(--red, #c0392b);
  border: 1px solid var(--red, #c0392b);
  border-radius: 4px;
  cursor: pointer;
  line-height: 1.4;
}
.btn-revert:hover { background: var(--red, #c0392b); color: #fff; }

/* ── Per-photo form ── */
.ph-photo-nav {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.ph-photo-counter { font-size: 0.88rem; color: var(--ink-muted, #888); }
.ph-preview-img {
  max-width: 100%;
  max-height: 260px;
  display: block;
  border-radius: 4px;
  border: 1px solid var(--rule, #ccc);
  margin-bottom: 6px;
  object-fit: contain;
  background: #111;
}
.ph-filename {
  font-size: 0.78rem;
  font-family: monospace;
  color: var(--ink-muted, #888);
  margin-bottom: 14px;
}
.ph-form-grid { display: flex; flex-direction: column; gap: 10px; }
.ph-field { display: flex; flex-direction: column; gap: 3px; }
.ph-field-row { flex-direction: row; gap: 16px; align-items: flex-end; }
.ph-field-row > div { display: flex; flex-direction: column; gap: 3px; }
.ph-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--ink-muted, #555);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.ph-muted { font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 0.75rem; }
.ph-input, .ph-select, .ph-textarea {
  border: 1px solid var(--rule, #ccc);
  border-radius: 4px;
  padding: 5px 8px;
  font-size: 0.88rem;
  font-family: inherit;
  background: var(--surface, #faf8f4);
  color: var(--ink, #222);
}
.ph-textarea { resize: vertical; }
.ph-input-sm { width: 64px; }
.ph-select[multiple] { min-height: 90px; }

/* ── Roster checkbox picker ── */
.ph-filter-input {
  border: 1px solid var(--rule, #ccc);
  border-radius: 4px 4px 0 0;
  border-bottom: none;
  padding: 4px 8px;
  font-size: 0.82rem;
  font-family: inherit;
  background: var(--surface, #faf8f4);
  color: var(--ink, #222);
  width: 100%;
}
.ph-checkbox-list {
  border: 1px solid var(--rule, #ccc);
  border-radius: 0;
  padding: 3px 2px;
  max-height: 120px;
  overflow-y: auto;
  background: var(--surface, #faf8f4);
  width: 100%;
}
.ph-cb-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2px 6px;
  font-size: 0.82rem;
  font-family: monospace;
  cursor: pointer;
  user-select: none;
  border-radius: 2px;
}
.ph-cb-row:hover { background: var(--hover, #f0ede6); }
.ph-cb-row input[type=checkbox] { margin: 0; cursor: pointer; flex-shrink: 0; }
.ph-extra-input {
  border-radius: 0 0 4px 4px;
  border-top: none;
  font-size: 0.8rem;
  font-family: monospace;
  width: 100%;
}

/* ── Form actions + flush ── */
.ph-form-actions { margin-top: 14px; }
.ph-flush-panel {
  margin-top: 18px;
  padding: 12px;
  border: 1px solid var(--accent, #5a7a4a);
  border-radius: 6px;
  background: #f4f8f2;
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-width: 600px;
}
.ph-flush-summary { font-size: 0.88rem; }
.ph-warn { color: #e67e22; margin-left: 6px; }

/* ── Stub-missing warning + create modal ── */
.ph-stub-warn {
  font-size: 0.82rem; color: #c0392b;
  display: flex; align-items: center; gap: 8px; padding: 4px 0;
}
.ph-stub-warn button {
  font-size: 0.78rem; padding: 2px 8px;
  background: #c0392b; color: #fff;
  border: none; border-radius: 4px; cursor: pointer;
}
.ph-stub-warn button:hover { background: #a93226; }
#ph-create-stub-modal {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  z-index: 1000; display: flex; align-items: center; justify-content: center;
}
.ph-csb-box {
  background: #fff; border-radius: 8px; padding: 24px; width: 360px;
  max-width: 95vw; display: flex; flex-direction: column; gap: 12px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.18);
}
.ph-csb-box h3 { margin: 0; font-size: 1rem; }
.ph-csb-box label { font-size: 0.82rem; font-weight: 600; display: flex; flex-direction: column; gap: 4px; }
.ph-csb-box input, .ph-csb-box select { padding: 5px 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
.ph-csb-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px; }

/* ── Misc ── */
.ph-placeholder { font-size: 0.88rem; color: var(--ink-muted, #888); font-style: italic; }
.ph-empty       { font-size: 0.82rem; color: var(--ink-muted, #aaa); padding: 4px; }
.ph-loading     { font-size: 0.88rem; color: var(--ink-muted, #888); }
.ph-error       { font-size: 0.88rem; color: #c0392b; }
</style>


<!-- ══════════════════════════════════════════════════════════════
     TAB 4 JAVASCRIPT — Photo Intake
     ══════════════════════════════════════════════════════════════ -->
<script>
// ─── State ───────────────────────────────────────────────────────────────────
const PH = {
  rawFolders:     [],
  stagingFolders: [],
  rosterSlugs:    [],
  events:         [],
  activeSubTab:   'raw',
  // Raw
  selectedRawFolder: null,
  rawDetail:         null,
  // Staging
  selectedStagingSlug: null,
  stagingDetail:       null,
  photoIdx: 0,
  buffer:   {},  // filename → form value object
  pendingStageSlugs: null  // set when stub modal is opened from phStage()
};

// ─── Boot ────────────────────────────────────────────────────────────────────
async function phInit() {
  // Use prefetched soldier slugs if available
  if (slugCache.soldier && slugCache.soldier.length) {
    PH.rosterSlugs = slugCache.soldier.map(s => s.slug).sort();
  } else {
    try {
      const d = await api('GET', '/slugs?type=soldier');
      PH.rosterSlugs = (d.slugs || []).map(s => s.slug).sort();
    } catch(e) { PH.rosterSlugs = []; }
  }
  try {
    const ev = await api('GET', '/photos/events');
    PH.events = ev.events || [];
  } catch(e) { PH.events = []; }

  await phLoadRaw();
  await phLoadStaging();
}

// ─── Sub-tab switching ───────────────────────────────────────────────────────
function phSwitchSubTab(tab) {
  PH.activeSubTab = tab;
  ['raw', 'staging', 'submissions', 'edit'].forEach(t => {
    const btn  = document.getElementById(`ph-tab-${t}`);
    const pane = document.getElementById(`ph-pane-${t}`);
    if (btn)  btn.classList.toggle('active', t === tab);
    if (pane) pane.style.display = t === tab ? 'flex' : 'none';
  });
  if (tab === 'submissions' && !PH.submissionsLoaded) phLoadSubmissions();
  if (tab === 'edit'        && !PHE.soldiersLoaded)   pheLoadSoldiers();
}

// ─── Raw pane ────────────────────────────────────────────────────────────────
async function phLoadRaw() {
  try {
    const d = await api('GET', '/photos/raw');
    PH.rawFolders = d.folders || [];
    phRenderRawList();
    const badge = document.getElementById('ph-raw-badge');
    const count = PH.rawFolders.filter(f => !f.alreadyStaged).length;
    if (badge) { badge.textContent = count; badge.style.display = count ? 'inline-block' : 'none'; }
    const tabBadge = document.getElementById('ph-tab-badge');
    if (tabBadge) { tabBadge.textContent = count; tabBadge.style.display = count ? 'inline-block' : 'none'; }
  } catch(e) { console.error('phLoadRaw', e); }
}

function phRenderRawList() {
  const el = document.getElementById('ph-raw-list');
  if (!PH.rawFolders.length) {
    el.innerHTML = '<p class="ph-empty">No raw folders.</p>';
    return;
  }
  el.innerHTML = PH.rawFolders.map(f => `
    <div class="ph-folder-item${f.alreadyStaged ? ' is-staged' : ''}${PH.selectedRawFolder === f.folder ? ' active' : ''}"
         onclick="phSelectRawFolder('${escHtml(f.folder)}')">
      <span class="ph-folder-name">${escHtml(f.displayName)}</span>
      <span class="ph-folder-meta">${f.photoCount} photo${f.photoCount !== 1 ? 's' : ''}${f.alreadyStaged ? ' · staged' : ''}</span>
    </div>`).join('');
}

async function phSelectRawFolder(folder) {
  PH.selectedRawFolder = folder;
  phRenderRawList();
  const detail = document.getElementById('ph-raw-detail');
  detail.innerHTML = '<p class="ph-loading">Loading…</p>';
  try {
    const d = await api('GET', `/photos/raw/${encodeURIComponent(folder)}`);
    PH.rawDetail = d;
    phRenderRawDetail(d);
  } catch(e) {
    detail.innerHTML = '<p class="ph-error">Failed to load folder.</p>';
  }
}

function phRenderRawDetail(d) {
  const detail = document.getElementById('ph-raw-detail');
  const slugOpts = d.allSlugs.map(s => `<option value="${escHtml(s)}">`).join('');

  // Per-photo crop + rename sections
  const photoSections = d.photos.map(p => {
    const imgSrc = `/api/photos/raw/${encodeURIComponent(d.folderName)}/image/${encodeURIComponent(p)}`;
    const safeId = p.replace(/[^a-z0-9]/gi, '_');
    return `
      <div class="ph-crop-section" id="crop-section-${safeId}">
        <div class="ph-crop-fname">${escHtml(p)}</div>
        <div class="ph-crop-wrap" id="crop-wrap-${safeId}">
          <img class="ph-crop-img" id="crop-img-${safeId}" src="${imgSrc}" draggable="false" />
          <div class="ph-crop-overlay" id="crop-overlay-${safeId}">
            <div class="ph-crop-rect" id="crop-rect-${safeId}" style="display:none"></div>
          </div>
        </div>
        <div class="ph-crop-actions">
          <button class="btn btn-secondary btn-sm" id="crop-btn-${safeId}">Crop</button>
          <button class="btn btn-secondary btn-sm" onclick="phCropReset('${safeId}')">Reset</button>
          <span class="ph-crop-coords" id="crop-coords-${safeId}">drag to select</span>
        </div>
      </div>`;
  }).join('');

  // Rename table
  const renameRows = d.photos.map(p => `
    <span class="ph-rename-orig" title="${escHtml(p)}">${escHtml(p)}</span>
    <span class="ph-rename-arrow">→</span>
    <input class="ph-rename-input" data-orig="${escHtml(p)}" value="${escHtml(p)}"
           oninput="this.classList.toggle('is-changed', this.value.trim() !== this.dataset.orig)" />`
  ).join('');

  detail.innerHTML = `
    <div>
      <h3 class="ph-detail-title">${escHtml(d.displayName)}</h3>
      <div class="ph-detail-meta">${d.photos.length} photo${d.photos.length !== 1 ? 's' : ''}${d.notesContent ? ' · has notes' : ''}</div>
      ${d.notesContent ? `<div class="ph-notes">${escHtml(d.notesContent)}</div>` : ''}
      ${photoSections}
      <div class="ph-label" style="margin-bottom:4px">Rename files (edit any name before staging)</div>
      <div class="ph-rename-table">${renameRows}</div>
      <div class="ph-stage-form">
        <label class="ph-label">Assign to soldier slug</label>
        <datalist id="ph-slug-dl">${slugOpts}</datalist>
        <input type="text" id="ph-slug-input" class="ph-input" list="ph-slug-dl"
               placeholder="Type slug or pick from suggestions…" />
        <small style="font-size:0.75rem;color:var(--ink-muted,#888)">Suggestions: ${d.suggestions.join(', ') || 'none'}</small>
        <div style="display:flex;gap:8px;margin-top:6px">
          <button class="btn btn-commit" onclick="phStage()">Move to Staging →</button>
          <button class="btn btn-secondary" onclick="phCancelRaw()">Cancel</button>
        </div>
      </div>
    </div>`;

  // Wire crop events programmatically — avoids e.currentTarget=null in inline handlers
  phBindCropEvents(d.folderName, d.photos);
}

// ─── Crop UI ─────────────────────────────────────────────────────────────────

const CROP = {
  active:   false,
  folder:   null,
  filename: null,
  safeId:   null,
  startX:   0,
  startY:   0,
  imgRect:  null,
  rect:     null,   // { x, y, w, h } as 0..1 fractions
};

function phBindCropEvents(folderName, photos) {
  photos.forEach(filename => {
    const safeId = filename.replace(/[^a-z0-9]/gi, '_');
    const wrap   = document.getElementById(`crop-wrap-${safeId}`);
    const btn    = document.getElementById(`crop-btn-${safeId}`);
    if (!wrap) return;

    wrap.addEventListener('mousedown', e => {
      const img = wrap.querySelector('.ph-crop-img');
      if (!img || !img.complete || !img.naturalWidth) return;
      e.preventDefault();
      CROP.active   = true;
      CROP.folder   = folderName;
      CROP.filename = filename;
      CROP.safeId   = safeId;
      CROP.imgRect  = img.getBoundingClientRect();
      CROP.startX   = e.clientX;
      CROP.startY   = e.clientY;
      CROP.rect     = null;
      const r = document.getElementById(`crop-rect-${safeId}`);
      if (r) r.style.display = 'none';
    });

    wrap.addEventListener('mousemove', e => {
      if (!CROP.active || CROP.safeId !== safeId) return;
      e.preventDefault();
      const ib = CROP.imgRect;
      const wb = wrap.getBoundingClientRect();
      const x1 = Math.max(ib.left,   Math.min(CROP.startX, e.clientX));
      const y1 = Math.max(ib.top,    Math.min(CROP.startY, e.clientY));
      const x2 = Math.min(ib.right,  Math.max(CROP.startX, e.clientX));
      const y2 = Math.min(ib.bottom, Math.max(CROP.startY, e.clientY));

      const r = document.getElementById(`crop-rect-${safeId}`);
      if (r) {
        r.style.display = 'block';
        r.style.left    = (x1 - wb.left) + 'px';
        r.style.top     = (y1 - wb.top)  + 'px';
        r.style.width   = (x2 - x1) + 'px';
        r.style.height  = (y2 - y1) + 'px';
      }

      CROP.rect = {
        x: (x1 - ib.left) / ib.width,
        y: (y1 - ib.top)  / ib.height,
        w: (x2 - x1)      / ib.width,
        h: (y2 - y1)      / ib.height,
      };
      const coords = document.getElementById(`crop-coords-${safeId}`);
      if (coords) {
        const pct = v => Math.round(v * 100);
        coords.textContent = `${pct(CROP.rect.w)}×${pct(CROP.rect.h)}%`;
      }
    });

    wrap.addEventListener('mouseup', () => {
      if (!CROP.active || CROP.safeId !== safeId) return;
      CROP.active = false;
      if (!CROP.rect || CROP.rect.w < 0.02 || CROP.rect.h < 0.02) phCropReset(safeId);
    });

    if (btn) btn.addEventListener('click', () => phCropApply(folderName, filename, safeId));
  });
}

function phCropReset(safeId) {
  const r = document.getElementById(`crop-rect-${safeId}`);
  const c = document.getElementById(`crop-coords-${safeId}`);
  if (r) r.style.display = 'none';
  if (c) c.textContent = 'drag to select';
  if (CROP.safeId === safeId) CROP.rect = null;
}

async function phCropApply(folder, filename, safeId) {
  if (!CROP.rect || CROP.safeId !== safeId) {
    toast('Draw a selection first.', 'error'); return;
  }
  const { x, y, w, h } = CROP.rect;
  if (w < 0.02 || h < 0.02) { toast('Selection too small.', 'error'); return; }
  try {
    const r = await api('POST', '/photos/raw/crop', { folder, filename, x, y, w, h });
    if (!r.ok) throw new Error(r.error);
    const img = document.getElementById(`crop-img-${safeId}`);
    if (img) img.src = img.src.split('?')[0] + '?t=' + Date.now();
    phCropReset(safeId);
    toast('Cropped.');
  } catch(e) {
    toast('Crop failed: ' + e.message, 'error');
  }
}

// Collect { originalName: newName } from the rename inputs.
// Only includes entries where the name actually changed.
function phGetRenames() {
  const renames = {};
  document.querySelectorAll('.ph-rename-input').forEach(input => {
    const orig = input.dataset.orig;
    const next = input.value.trim();
    if (next && next !== orig) renames[orig] = next;
  });
  return renames;
}

async function phStage() {
  const slug = document.getElementById('ph-slug-input')?.value.trim();
  if (!slug) { alert('Enter a soldier slug first.'); return; }

  // Stub check: warn before staging if this soldier has no profile yet
  try {
    const chk = await fetch(`/api/soldiers/check?slugs=${encodeURIComponent(slug)}`);
    const { missing } = await chk.json();
    if (missing && missing.length) {
      phOpenCreateStubModal(slug);
      // Store slug so the modal can proceed to stage after creating stub
      PH.pendingStageSlugs = slug;
      return;
    }
  } catch(e) { /* non-fatal — proceed anyway */ }

  try {
    const result = await api('POST', '/photos/raw/stage', { folder: PH.selectedRawFolder, slug, renames: phGetRenames() });
    if (result.ok) {
      toast(`Staged to ${slug}`, 'success');
      PH.selectedRawFolder = null;
      document.getElementById('ph-raw-detail').innerHTML = '<p class="ph-placeholder">Select a folder to review</p>';
      await phLoadRaw();
      await phLoadStaging();
      if (PH.activeSubTab === 'raw') phSwitchSubTab('staging');
    } else {
      alert(`Stage failed: ${result.error}`);
    }
  } catch(e) { alert('Stage failed: ' + e.message); }
}

function phCancelRaw() {
  PH.selectedRawFolder = null;
  PH.rawDetail = null;
  document.getElementById('ph-raw-detail').innerHTML = '<p class="ph-placeholder">Select a folder to review</p>';
  phRenderRawList(); // clears active highlight in sidebar
}

// ─── Staging pane ────────────────────────────────────────────────────────────
async function phLoadStaging() {
  try {
    const d = await api('GET', '/photos/staging');
    PH.stagingFolders = d.folders || [];
    phRenderStagingList();
    const badge = document.getElementById('ph-staging-badge');
    if (badge) {
      badge.textContent = PH.stagingFolders.length;
      badge.style.display = PH.stagingFolders.length ? 'inline-block' : 'none';
    }
  } catch(e) { console.error('phLoadStaging', e); }
}

function phRenderStagingList() {
  const existing = PH.stagingFolders.filter(f =>  f.isExisting);
  const fresh    = PH.stagingFolders.filter(f => !f.isExisting);
  const renderItems = arr => arr.length
    ? arr.map(f => `
        <div class="ph-folder-item${PH.selectedStagingSlug === f.slug ? ' active' : ''}"
             onclick="phSelectStagingSlug('${escHtml(f.slug)}')">
          <span class="ph-folder-name">${escHtml(f.slug)}</span>
          <span class="ph-folder-meta">${f.photoCount} photo${f.photoCount !== 1 ? 's' : ''}</span>
        </div>`).join('')
    : '<p class="ph-empty">None</p>';
  document.getElementById('ph-staging-existing').innerHTML = renderItems(existing);
  document.getElementById('ph-staging-new').innerHTML      = renderItems(fresh);
}

async function phSelectStagingSlug(slug) {
  PH.selectedStagingSlug = slug;
  PH.photoIdx = 0;
  PH.buffer   = {};
  phRenderStagingList();
  document.getElementById('ph-staging-detail').innerHTML = '<p class="ph-loading">Loading…</p>';
  try {
    const d = await api('GET', `/photos/staging/${encodeURIComponent(slug)}`);
    PH.stagingDetail = d;
    phRenderPhoto(0);
  } catch(e) {
    document.getElementById('ph-staging-detail').innerHTML = '<p class="ph-error">Failed to load staging folder.</p>';
  }
}

async function phRevertStaging() {
  const slug = PH.selectedStagingSlug;
  if (!slug) return;
  if (!confirm(`Delete the staging folder for "${slug}"?\n\nYour raw folder is untouched — you can re-stage it at any time.`)) return;
  try {
    await api('DELETE', `/photos/staging/${encodeURIComponent(slug)}`);
    toast(`Staging for "${slug}" reverted`, 'success');
    PH.selectedStagingSlug = null;
    PH.stagingDetail = null;
    PH.buffer = {};
    PH.photoIdx = 0;
    document.getElementById('ph-staging-detail').innerHTML = '<p class="ph-placeholder">Select a staging folder to tag photos</p>';
    await phLoadStaging();
  } catch(e) { alert('Revert failed: ' + e.message); }
}

// ─── Per-photo form ───────────────────────────────────────────────────────────
function phRenderPhoto(idx) {
  const d    = PH.stagingDetail;
  const detail = document.getElementById('ph-staging-detail');
  if (!d || !d.photos.length) {
    detail.innerHTML = '<p class="ph-empty">No photos in this folder.</p>';
    return;
  }
  PH.photoIdx = idx;
  const filename = d.photos[idx];
  const slug     = PH.selectedStagingSlug;
  const buf      = PH.buffer[filename] || {};
  const dest     = buf.dest || 'field';
  const isFirst  = idx === 0;
  const isLast   = idx === d.photos.length - 1;

  // Split stored contains/tagged back into roster-known vs freeform
  const splitContains = phSplitRosterExtra(buf.contains || '');
  const splitTagged   = phSplitRosterExtra(buf.tagged   || '');

  const eventOpts  = PH.events.map(e => `<option value="${escHtml(e)}">`).join('');
  const rosterDl   = PH.rosterSlugs.map(s => `<option value="${escHtml(s)}">`).join('');

  detail.innerHTML = `
    <div class="ph-photo-form">
      <div class="ph-staging-header">
        <span class="ph-staging-slug">${escHtml(slug)}</span>
        <button class="btn btn-revert" onclick="phRevertStaging()">⤺ Revert folder</button>
      </div>
      ${d.notesContent ? `
      <div class="ph-notes">
        <strong style="display:block;margin-bottom:4px;font-size:0.78rem;text-transform:uppercase;letter-spacing:.04em;color:var(--ink-muted,#888)">Notes</strong>${escHtml(d.notesContent)}
      </div>` : ''}
      <div class="ph-photo-nav">
        <button class="btn btn-secondary" onclick="phNav(-1)" ${isFirst ? 'disabled' : ''}>← Back</button>
        <span class="ph-photo-counter">Photo ${idx + 1} of ${d.photos.length}</span>
        <button class="btn btn-secondary" onclick="phNav(1)" ${isLast ? 'disabled' : ''}>Next →</button>
      </div>

      <div class="ph-photo-preview">
        <img src="/api/photos/staging/${encodeURIComponent(slug)}/image/${encodeURIComponent(filename)}"
             alt="${escHtml(filename)}" class="ph-preview-img"
             onerror="this.style.display='none'" />
        <div class="ph-filename">${escHtml(filename)}</div>
      </div>

      <div class="ph-form-grid">

        <div class="ph-field">
          <label class="ph-label">Destination</label>
          <select id="ph-dest" class="ph-select" onchange="phToggleDestFields()">
            <option value="field"   ${dest === 'field'   ? 'selected' : ''}>Field</option>
            <option value="profile" ${dest === 'profile' ? 'selected' : ''}>Profile</option>
            <option value="event"   ${dest === 'event'   ? 'selected' : ''}>Event</option>
          </select>
        </div>

        <div class="ph-field" id="ph-subject-field" style="${dest === 'profile' ? '' : 'display:none'}">
          <label class="ph-label">Subject</label>
          <datalist id="ph-roster-dl">${rosterDl}</datalist>
          <input type="text" id="ph-subject-slug" class="ph-input"
                 value="${escHtml(buf.subjectSlug || slug)}"
                 list="ph-roster-dl"
                 onblur="phCheckSubjectSlug()" />
          <div id="ph-stub-warn" class="ph-stub-warn" style="display:none">
            <span id="ph-stub-warn-msg"></span>
            <button onclick="phOpenCreateStubModal()">Create Stub</button>
          </div>
        </div>

        <div class="ph-field" id="ph-event-field" style="${dest === 'event' ? '' : 'display:none'}">
          <label class="ph-label">Event Slug</label>
          <datalist id="ph-events-dl">${eventOpts}</datalist>
          <input type="text" id="ph-event-slug" class="ph-input"
                 value="${escHtml(buf.eventSlug || '')}"
                 list="ph-events-dl" placeholder="event-slug" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Caption</label>
          <textarea id="ph-caption" class="ph-textarea" rows="3">${escHtml(buf.caption || '')}</textarea>
        </div>

        <div class="ph-field">
          <label class="ph-label">Caption Short</label>
          <input type="text" id="ph-caption-short" class="ph-input" value="${escHtml(buf.caption_short || '')}" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Photographer</label>
          <input type="text" id="ph-photographer" class="ph-input"
                 value="${escHtml(buf.photographer || '')}"
                 list="ph-roster-dl" placeholder="soldier-slug  ·  unknown  ·  unknown-of" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Credit <span class="ph-muted">(display string)</span></label>
          <input type="text" id="ph-credit" class="ph-input" value="${escHtml(buf.credit || '')}" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Contains <span class="ph-muted">(soldiers pictured)</span></label>
          <input type="text" class="ph-filter-input" placeholder="Filter roster…"
                 oninput="phFilterCheckboxList(this, 'ph-contains-cbl')" />
          <div id="ph-contains-cbl" class="ph-checkbox-list"></div>
          <input type="text" id="ph-contains-extra" class="ph-input ph-extra-input"
                 value="${escHtml(splitContains.extra)}"
                 placeholder="Extra slugs not in roster (comma-separated)" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Tagged <span class="ph-muted">(soldiers referenced)</span></label>
          <input type="text" class="ph-filter-input" placeholder="Filter roster…"
                 oninput="phFilterCheckboxList(this, 'ph-tagged-cbl')" />
          <div id="ph-tagged-cbl" class="ph-checkbox-list"></div>
          <input type="text" id="ph-tagged-extra" class="ph-input ph-extra-input"
                 value="${escHtml(splitTagged.extra)}"
                 placeholder="Extra slugs not in roster (comma-separated)" />
        </div>

        <div class="ph-field ph-field-row">
          <div>
            <label class="ph-label">Quality <span class="ph-muted">1–5</span></label>
            <input type="number" id="ph-quality" class="ph-input ph-input-sm"
                   min="1" max="5" value="${escHtml(String(buf.quality || ''))}" />
          </div>
          <div>
            <label class="ph-label">Date</label>
            <input type="text" id="ph-date" class="ph-input"
                   value="${escHtml(buf.date || '')}" placeholder="YYYY or YYYY-MM" />
          </div>
          <div>
            <label class="ph-label">Date Known</label>
            <input type="checkbox" id="ph-date-known"
                   ${buf.date_known === true || buf.date_known === 'true' ? 'checked' : ''} />
          </div>
        </div>

      </div><!-- /.ph-form-grid -->

      <div class="ph-form-actions" style="margin-top:14px;display:flex;gap:8px;align-items:center">
        <button class="btn btn-commit" onclick="phSaveAndNav(1)">
          Save &amp; ${isLast ? 'Review ↓' : 'Next →'}
        </button>
        <button class="btn btn-secondary" onclick="phSaveBuffer()" style="font-size:0.82rem">Save only</button>
        <span id="ph-save-confirm" style="font-size:0.8rem;color:var(--ink-muted,#888);display:none">Saved ✓</span>
      </div>

      ${isLast ? `
      <div class="ph-flush-panel" id="ph-flush-panel">
        <div class="ph-flush-summary" id="ph-flush-summary"></div>
        <button class="btn btn-commit" onclick="phFlush()">Flush to Site →</button>
      </div>` : ''}

    </div>`;

  // Populate roster checkbox lists after render
  phPopulateCheckboxList('ph-contains-cbl', splitContains.known);
  phPopulateCheckboxList('ph-tagged-cbl',   splitTagged.known);
  phToggleDestFields();
  if (isLast) phUpdateFlushSummary();
}

// ─── Roster helpers ──────────────────────────────────────────────────────────
function phPopulateCheckboxList(containerId, selectedValues = []) {
  const container = document.getElementById(containerId);
  if (!container) return;
  container.innerHTML = PH.rosterSlugs.map(s =>
    `<label class="ph-cb-row">` +
    `<input type="checkbox" value="${escHtml(s)}"${selectedValues.includes(s) ? ' checked' : ''} />` +
    `${escHtml(s)}</label>`
  ).join('');
}

function phFilterCheckboxList(input, containerId) {
  const filter = input.value.toLowerCase();
  const container = document.getElementById(containerId);
  if (!container) return;
  container.querySelectorAll('.ph-cb-row').forEach(row => {
    const slug = row.querySelector('input[type=checkbox]').value;
    row.style.display = (!filter || slug.includes(filter)) ? '' : 'none';
  });
}

function phSplitRosterExtra(csv) {
  const all   = csv.split(',').map(s => s.trim()).filter(Boolean);
  const known = all.filter(s =>  PH.rosterSlugs.includes(s));
  const extra = all.filter(s => !PH.rosterSlugs.includes(s)).join(', ');
  return { known, extra };
}

function phGetCheckboxList(containerId, extraId) {
  const container = document.getElementById(containerId);
  const checked = container
    ? Array.from(container.querySelectorAll('input[type=checkbox]:checked')).map(cb => cb.value)
    : [];
  const extra = (document.getElementById(extraId)?.value || '').split(',').map(s => s.trim()).filter(Boolean);
  return [...checked, ...extra].join(',');
}

// ─── Destination field toggle ─────────────────────────────────────────────────
function phToggleDestFields() {
  const dest = document.getElementById('ph-dest')?.value;
  const sf   = document.getElementById('ph-subject-field');
  const ef   = document.getElementById('ph-event-field');
  if (sf) sf.style.display = dest === 'profile' ? '' : 'none';
  if (ef) ef.style.display = dest === 'event'   ? '' : 'none';
}

// ─── Buffer ──────────────────────────────────────────────────────────────────
function phSaveBuffer() {
  const d = PH.stagingDetail;
  if (!d) return;
  const filename = d.photos[PH.photoIdx];
  PH.buffer[filename] = {
    filename,
    dest:          document.getElementById('ph-dest')?.value        || 'field',
    subjectSlug:   document.getElementById('ph-subject-slug')?.value.trim() || '',
    eventSlug:     document.getElementById('ph-event-slug')?.value.trim()   || '',
    caption:       document.getElementById('ph-caption')?.value       || '',
    caption_short: document.getElementById('ph-caption-short')?.value || '',
    photographer:  document.getElementById('ph-photographer')?.value.trim() || '',
    credit:        document.getElementById('ph-credit')?.value        || '',
    contains:      phGetCheckboxList('ph-contains-cbl', 'ph-contains-extra'),
    tagged:        phGetCheckboxList('ph-tagged-cbl',   'ph-tagged-extra'),
    quality:       document.getElementById('ph-quality')?.value       || '',
    date:          document.getElementById('ph-date')?.value          || '',
    date_known:    document.getElementById('ph-date-known')?.checked  || false
  };
  // Flash save confirm
  const conf = document.getElementById('ph-save-confirm');
  if (conf) { conf.style.display = 'inline'; setTimeout(() => conf.style.display = 'none', 1200); }
}

function phNav(dir) {
  phSaveBuffer();
  const d = PH.stagingDetail;
  if (!d) return;
  const next = PH.photoIdx + dir;
  if (next >= 0 && next < d.photos.length) phRenderPhoto(next);
}

function phSaveAndNav(dir) {
  phSaveBuffer();
  const d    = PH.stagingDetail;
  if (!d) return;
  const next = PH.photoIdx + dir;
  if (next < d.photos.length) {
    phRenderPhoto(next);
  } else {
    // On last photo — re-render to show flush panel with updated summary
    phRenderPhoto(PH.photoIdx);
  }
}

function phUpdateFlushSummary() {
  const el = document.getElementById('ph-flush-summary');
  if (!el || !PH.stagingDetail) return;
  const total    = PH.stagingDetail.photos.length;
  const buffered = PH.stagingDetail.photos.filter(f => PH.buffer[f]).length;
  const untagged = total - buffered;
  el.innerHTML = `<strong>${buffered} of ${total} photos tagged.</strong>${untagged
    ? `<span class="ph-warn">${untagged} untagged — will be skipped.</span>` : ''}`;
}

// ─── Flush ───────────────────────────────────────────────────────────────────
async function phFlush() {
  phSaveBuffer();
  const d    = PH.stagingDetail;
  const slug = PH.selectedStagingSlug;
  if (!d) return;

  const bufferArr = d.photos.filter(f => PH.buffer[f]).map(f => PH.buffer[f]);
  if (!bufferArr.length) { alert('No tagged photos to flush.'); return; }

  // Pre-check: warn if any profile photos target a soldier with no stub
  const profileSlugs = [...new Set(
    bufferArr.filter(e => e.dest === 'profile').map(e => (e.subjectSlug || slug).trim())
  )];
  if (profileSlugs.length) {
    try {
      const chk = await fetch(`/api/soldiers/check?slugs=${encodeURIComponent(profileSlugs.join(','))}`);
      const { missing } = await chk.json();
      if (missing && missing.length) {
        const ok = confirm(
          `Warning: ${missing.map(s => `"${s}"`).join(', ')} ${missing.length === 1 ? 'has' : 'have'} no soldier stub.\n\nFlush anyway? The photo will land in the right folder, but the soldier page won't exist until you create the stub.`
        );
        if (!ok) return;
      }
    } catch(e) { /* non-fatal — proceed */ }
  }

  if (!confirm(`Flush ${bufferArr.length} photo${bufferArr.length !== 1 ? 's' : ''} from staging/${slug} to site/?`)) return;

  try {
    const result = await api('POST', '/photos/flush', { slug, buffer: bufferArr });
    if (result.errors && result.errors.length) {
      alert(`Flush completed with errors:\n${result.errors.join('\n')}`);
    } else {
      toast(`Flushed ${result.moved.length} photo${result.moved.length !== 1 ? 's' : ''} to site/`, 'success');
    }
    // Reset
    PH.selectedStagingSlug = null;
    PH.stagingDetail       = null;
    PH.buffer              = {};
    PH.photoIdx            = 0;
    document.getElementById('ph-staging-detail').innerHTML = '<p class="ph-placeholder">Select a staging folder to tag photos</p>';
    await phLoadStaging();
  } catch(e) { alert('Flush failed: ' + e.message); }
}

// ─── Subject slug stub check ─────────────────────────────────────────────────
async function phCheckSubjectSlug() {
  const input = document.getElementById('ph-subject-slug');
  const warn  = document.getElementById('ph-stub-warn');
  const msg   = document.getElementById('ph-stub-warn-msg');
  if (!input || !warn) return;
  const val = input.value.trim();
  if (!val) { warn.style.display = 'none'; return; }
  try {
    const res  = await fetch(`/api/soldiers/check?slugs=${encodeURIComponent(val)}`);
    const data = await res.json();
    if (data.missing && data.missing.includes(val)) {
      msg.textContent = `No stub found for "${val}".`;
      warn.style.display = 'flex';
    } else {
      warn.style.display = 'none';
    }
  } catch(e) { warn.style.display = 'none'; }
}

// ─── Create stub mini-modal ───────────────────────────────────────────────────
function phOpenCreateStubModal(slugOverride) {
  const slug = slugOverride || (document.getElementById('ph-subject-slug')?.value || '').trim();
  let modal = document.getElementById('ph-create-stub-modal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'ph-create-stub-modal';
    modal.innerHTML = `
      <div class="ph-csb-box">
        <h3>Create Soldier Stub</h3>
        <label>Slug <input id="ph-csb-slug" class="ph-input" readonly /></label>
        <label>Full Name <input id="ph-csb-name" class="ph-input" placeholder="Frank Guidara" /></label>
        <label>Rank <input id="ph-csb-rank" class="ph-input" placeholder="LT" /></label>
        <label>Status
          <select id="ph-csb-status">
            <option value="researching">researching</option>
            <option value="veteran">veteran</option>
            <option value="deceased">deceased</option>
            <option value="kia">kia</option>
          </select>
        </label>
        <div class="ph-csb-actions">
          <button class="btn" onclick="phCloseCreateStubModal()">Cancel</button>
          <button class="btn btn-commit" onclick="phCreateStub()">Create</button>
        </div>
        <div id="ph-csb-error" class="ph-error" style="display:none"></div>
      </div>`;
    document.body.appendChild(modal);
  }
  const _slugInput = document.getElementById('ph-csb-slug');
  _slugInput.value    = slug;
  _slugInput.readOnly = !!slug; // editable when opened standalone, locked when pre-filled
  _slugInput.style.background = slug ? 'var(--hover,#f0ede6)' : '';
  document.getElementById('ph-csb-name').value   = '';
  document.getElementById('ph-csb-rank').value   = '';
  document.getElementById('ph-csb-status').value = 'researching';
  document.getElementById('ph-csb-error').style.display = 'none';
  modal.style.display = 'flex';
  document.getElementById('ph-csb-name').focus();
}

function phCloseCreateStubModal() {
  const modal = document.getElementById('ph-create-stub-modal');
  if (modal) modal.style.display = 'none';
  PH.pendingStageSlugs = null;
}

async function phCreateStub() {
  const slug   = document.getElementById('ph-csb-slug').value.trim();
  const name   = document.getElementById('ph-csb-name').value.trim();
  const rank   = document.getElementById('ph-csb-rank').value.trim();
  const status = document.getElementById('ph-csb-status').value;
  const errEl  = document.getElementById('ph-csb-error');

  if (!name) { errEl.textContent = 'Full name is required.'; errEl.style.display = ''; return; }

  try {
    const res  = await fetch('/api/soldiers/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug, name, rank, status })
    });
    const data = await res.json();
    if (!data.ok) {
      errEl.textContent = data.error || 'Create failed.';
      errEl.style.display = '';
      return;
    }
    phCloseCreateStubModal();
    const warnEl = document.getElementById('ph-stub-warn');
    if (warnEl) warnEl.style.display = 'none';
    toast(`Stub created: ${slug}`, 'success');

    // If called from phStage(), proceed to move the folder now
    if (PH.pendingStageSlugs === slug) {
      PH.pendingStageSlugs = null;
      try {
        const result = await api('POST', '/photos/raw/stage', { folder: PH.selectedRawFolder, slug, renames: phGetRenames() });
        if (result.ok) {
          toast(`Staged to ${slug}`, 'success');
          PH.selectedRawFolder = null;
          document.getElementById('ph-raw-detail').innerHTML = '<p class="ph-placeholder">Select a folder to review</p>';
          await phLoadRaw();
          await phLoadStaging();
          phSwitchSubTab('staging');
        } else {
          alert(`Stage failed: ${result.error}`);
        }
      } catch(e2) { alert('Stage failed: ' + e2.message); }
    }
  } catch(e) {
    errEl.textContent = 'Request failed: ' + e.message;
    errEl.style.display = '';
  }
}

// ─── Hook into switchTab ──────────────────────────────────────────────────────
(function() {
  const _prev = typeof switchTab === 'function' ? switchTab : null;
  window.switchTab = function(name) {
    if (_prev) _prev(name);
    if (name === 'photos') phInit();
  };
})();

// ─── Submissions pane ─────────────────────────────────────────────────────────

PH.submissions      = [];
PH.submissionsLoaded = false;

async function phLoadSubmissions() {
  PH.submissionsLoaded = true;
  const el = document.getElementById('ph-submissions-list');
  el.innerHTML = '<p class="ph-placeholder">Fetching from R2…</p>';
  try {
    const d = await api('GET', '/submissions/list');
    PH.submissions = d.folders || [];
    phRenderSubmissions();
    // Badge count
    const badge = document.getElementById('ph-submissions-badge');
    if (PH.submissions.length) {
      badge.textContent = PH.submissions.length;
      badge.style.display = 'inline-block';
    } else {
      badge.style.display = 'none';
    }
  } catch(e) {
    el.innerHTML = `<p class="ph-error">Error: ${escHtml(e.message)}</p>`;
  }
}

function phRenderSubmissions() {
  const el = document.getElementById('ph-submissions-list');
  if (!PH.submissions.length) {
    el.innerHTML = '<p class="ph-placeholder">No pending submissions in R2.</p>';
    return;
  }
  el.innerHTML = PH.submissions.map(f => {
    const meta     = f.metadata || {};
    const soldier  = meta.soldier_name || meta.soldier || '—';
    const submitter = meta.submitter_name || meta.name || '—';
    const submitted = meta.submitted ? new Date(meta.submitted).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) : '—';
    const fileCount = f.files ? f.files.length : 0;
    const notes    = (meta.notes || '').trim();
    const pulled   = f._pulled;  // set locally after a successful pull

    return `<div class="ph-sub-card${pulled ? ' ph-sub-pulled' : ''}" id="subcard-${escHtml(f.id)}">
      <div class="ph-sub-card-header">
        <div>
          <div class="ph-sub-soldier">${escHtml(soldier)}</div>
          <div class="ph-sub-meta">From ${escHtml(submitter)} · ${submitted} · ${fileCount} file${fileCount !== 1 ? 's' : ''}</div>
          <div class="ph-sub-meta" style="font-family:monospace;font-size:0.72rem;color:var(--muted,#aaa)">${escHtml(f.id)}</div>
        </div>
        <div class="ph-sub-actions">
          ${pulled
            ? `<span class="ph-sub-pulled-label">✓ Pulled to Raw</span>
               <button class="btn btn-danger btn-sm" onclick="phDiscardSubmission('${escHtml(f.id)}')">Discard from R2</button>`
            : `<button class="btn btn-primary btn-sm" onclick="phPullSubmission('${escHtml(f.id)}')">Pull to Raw →</button>`
          }
        </div>
      </div>
      ${notes ? `<div class="ph-notes ph-sub-notes">${escHtml(notes)}</div>` : ''}
      ${f.files && f.files.length ? `<div class="ph-photos-list">${f.files.map(fi => `<span class="ph-photo-name">${escHtml(fi.filename)}</span>`).join('')}</div>` : ''}
    </div>`;
  }).join('');
}

async function phPullSubmission(id) {
  const card = document.getElementById(`subcard-${id}`);
  const btn  = card ? card.querySelector('.btn-primary') : null;
  if (btn) { btn.disabled = true; btn.textContent = 'Pulling…'; }

  try {
    const r = await api('POST', `/submissions/pull/${encodeURIComponent(id)}`);
    // Mark the card as pulled in local state
    const f = PH.submissions.find(s => s.id === id);
    if (f) f._pulled = true;
    phRenderSubmissions();
    // Reload the Raw list so the new folder shows up immediately
    await phLoadRaw();
    toast(`Pulled to raw — switch to Raw tab to process.`);
  } catch(e) {
    if (btn) { btn.disabled = false; btn.textContent = 'Pull to Raw →'; }
    toast(`Pull failed: ${e.message}`, 'error');
  }
}

async function phDiscardSubmission(id) {
  if (!confirm(`Delete folder "${id}" from R2?\n\nOnly do this after the photos have been fully processed.`)) return;
  try {
    await api('POST', `/submissions/discard/${encodeURIComponent(id)}`);
    PH.submissions = PH.submissions.filter(s => s.id !== id);
    phRenderSubmissions();
    // Update badge
    const badge = document.getElementById('ph-submissions-badge');
    if (PH.submissions.length) {
      badge.textContent = PH.submissions.length;
    } else {
      badge.style.display = 'none';
    }
    toast('Submission discarded from R2.');
  } catch(e) {
    toast(`Discard failed: ${e.message}`, 'error');
  }
}

// ─── Photo Edit tab (PHE) ─────────────────────────────────────────────────────

const PHE = {
  soldiersLoaded:  false,
  soldiers:        [],
  filteredSoldiers:[],
  selectedSlug:    null,
  photos:          [],
  photoIdx:        0,
};

// ── Soldier list ──────────────────────────────────────────────────────────────

async function pheLoadSoldiers() {
  const listEl = document.getElementById('phe-soldier-list');
  listEl.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const d = await api('GET', '/photos/edit/soldiers');
    PHE.soldiers        = d.soldiers || [];
    PHE.filteredSoldiers = PHE.soldiers;
    PHE.soldiersLoaded  = true;
    pheRenderSoldierList();
  } catch(e) {
    listEl.innerHTML = `<p class="ph-placeholder" style="color:var(--red,#c00)">Error: ${escHtml(e.message)}</p>`;
  }
}

function pheFilterSoldiers(value) {
  const q = value.toLowerCase();
  PHE.filteredSoldiers = q ? PHE.soldiers.filter(s => s.slug.includes(q)) : PHE.soldiers;
  pheRenderSoldierList();
}

function pheRenderSoldierList() {
  const listEl = document.getElementById('phe-soldier-list');
  if (!PHE.filteredSoldiers.length) {
    listEl.innerHTML = '<p class="ph-placeholder">No soldiers found</p>';
    return;
  }
  listEl.innerHTML = PHE.filteredSoldiers.map(s =>
    `<div class="ph-folder-item${PHE.selectedSlug === s.slug ? ' active' : ''}"
          onclick="pheSelectSoldier('${escHtml(s.slug)}')">
       <span class="ph-folder-name">${escHtml(s.slug)}</span>
       <span class="ph-folder-meta">${s.photoCount} photo${s.photoCount !== 1 ? 's' : ''}</span>
     </div>`
  ).join('');
}

async function pheSelectSoldier(slug) {
  PHE.selectedSlug = slug;
  PHE.photos       = [];
  PHE.photoIdx     = 0;
  pheRenderSoldierList();
  const mainEl = document.getElementById('phe-main');
  mainEl.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const d = await api('GET', `/photos/edit/${encodeURIComponent(slug)}`);
    PHE.photos = d.photos || [];
    if (d.rosterSlugs && d.rosterSlugs.length) PH.rosterSlugs = d.rosterSlugs;
    if (!PHE.photos.length) {
      mainEl.innerHTML = '<p class="ph-placeholder">No photos found for this soldier.</p>';
      return;
    }
    pheRenderPhoto(0);
  } catch(e) {
    mainEl.innerHTML = `<p class="ph-placeholder" style="color:var(--red,#c00)">Error: ${escHtml(e.message)}</p>`;
  }
}

// ── Photo navigator ───────────────────────────────────────────────────────────

function pheRenderPhoto(idx) {
  const mainEl = document.getElementById('phe-main');
  if (!PHE.photos.length) return;
  PHE.photoIdx = idx;
  const photo   = PHE.photos[idx];
  const slug    = PHE.selectedSlug;
  const isFirst = idx === 0;
  const isLast  = idx === PHE.photos.length - 1;

  const imgSrc   = `/api/photos/edit/${encodeURIComponent(slug)}/image?subfolder=${encodeURIComponent(photo.subfolder)}&filename=${encodeURIComponent(photo.filename)}`;
  const rosterDl = PH.rosterSlugs.map(s => `<option value="${escHtml(s)}">`).join('');
  const eventOpts = PH.events.map(e => `<option value="${escHtml(e)}">`).join('');

  const contains = Array.isArray(photo.contains) ? photo.contains : [];
  const tagged   = Array.isArray(photo.tagged)   ? photo.tagged   : [];
  const splitContains = {
    known: contains.filter(s =>  PH.rosterSlugs.includes(s)),
    extra: contains.filter(s => !PH.rosterSlugs.includes(s)).join(', ')
  };
  const splitTagged = {
    known: tagged.filter(s =>  PH.rosterSlugs.includes(s)),
    extra: tagged.filter(s => !PH.rosterSlugs.includes(s)).join(', ')
  };

  mainEl.innerHTML = `
    <div class="ph-photo-form">
      <div class="ph-staging-header">
        <span class="ph-staging-slug">${escHtml(slug)}</span>
        <span style="font-size:0.78rem;color:var(--ink-muted,#888);margin-left:8px">${escHtml(photo.subfolder)}</span>
      </div>

      <div class="ph-photo-nav">
        <button class="btn btn-secondary" onclick="pheNav(-1)" ${isFirst ? 'disabled' : ''}>&#8592; Back</button>
        <span class="ph-photo-counter">Photo ${idx + 1} of ${PHE.photos.length}</span>
        <button class="btn btn-secondary" onclick="pheNav(1)" ${isLast ? 'disabled' : ''}>Next &#8594;</button>
      </div>

      <div class="ph-photo-preview">
        <img src="${imgSrc}" alt="${escHtml(photo.filename)}" class="ph-preview-img"
             onerror="this.style.display='none'" />
        <div class="ph-filename">${escHtml(photo.filename)}</div>
      </div>

      <div class="ph-form-grid">

        <div class="ph-field">
          <label class="ph-label">Caption</label>
          <textarea id="phe-caption" class="ph-textarea" rows="3">${escHtml(photo.caption || '')}</textarea>
        </div>

        <div class="ph-field">
          <label class="ph-label">Caption Short</label>
          <input type="text" id="phe-caption-short" class="ph-input" value="${escHtml(photo.caption_short || '')}" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Photographer</label>
          <datalist id="phe-roster-dl">${rosterDl}</datalist>
          <input type="text" id="phe-photographer" class="ph-input"
                 value="${escHtml(photo.photographer || '')}"
                 list="phe-roster-dl" placeholder="soldier-slug or empty" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Credit <span class="ph-muted">(display string)</span></label>
          <input type="text" id="phe-credit" class="ph-input" value="${escHtml(photo.credit || '')}" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Contains <span class="ph-muted">(soldiers pictured)</span></label>
          <input type="text" class="ph-filter-input" placeholder="Filter roster…"
                 oninput="phFilterCheckboxList(this, 'phe-contains-cbl')" />
          <div id="phe-contains-cbl" class="ph-checkbox-list"></div>
          <input type="text" id="phe-contains-extra" class="ph-input ph-extra-input"
                 value="${escHtml(splitContains.extra)}"
                 placeholder="Extra slugs not in roster (comma-separated)" />
        </div>

        <div class="ph-field">
          <label class="ph-label">Tagged <span class="ph-muted">(soldiers referenced)</span></label>
          <input type="text" class="ph-filter-input" placeholder="Filter roster…"
                 oninput="phFilterCheckboxList(this, 'phe-tagged-cbl')" />
          <div id="phe-tagged-cbl" class="ph-checkbox-list"></div>
          <input type="text" id="phe-tagged-extra" class="ph-input ph-extra-input"
                 value="${escHtml(splitTagged.extra)}"
                 placeholder="Extra slugs not in roster (comma-separated)" />
        </div>

        <div class="ph-field ph-field-row">
          <div>
            <label class="ph-label">Quality <span class="ph-muted">1&#8211;5</span></label>
            <input type="number" id="phe-quality" class="ph-input ph-input-sm"
                   min="1" max="5" value="${escHtml(String(photo.quality || ''))}" />
          </div>
          <div>
            <label class="ph-label">Date</label>
            <input type="text" id="phe-date" class="ph-input"
                   value="${escHtml(photo.date || '')}" placeholder="YYYY or YYYY-MM-DD" />
          </div>
          <div>
            <label class="ph-label">Date Known</label>
            <input type="checkbox" id="phe-date-known"
                   ${photo.date_known === true ? 'checked' : ''} />
          </div>
        </div>

        <div class="ph-field">
          <label class="ph-label">Event</label>
          <datalist id="phe-events-dl">${eventOpts}</datalist>
          <input type="text" id="phe-event" class="ph-input"
                 value="${escHtml(photo.event || '')}"
                 list="phe-events-dl" placeholder="event-slug" />
        </div>

      </div><!-- /.ph-form-grid -->

      <div class="ph-form-actions" style="margin-top:14px;display:flex;gap:8px;align-items:center">
        <button class="btn btn-commit" onclick="pheSave()">Save</button>
        <span id="phe-save-confirm" style="font-size:0.8rem;color:var(--ink-muted,#888);display:none">Saved &#10003;</span>
        <span id="phe-save-error"   style="font-size:0.8rem;color:var(--red,#c00);display:none"></span>
      </div>
    </div>`;

  phPopulateCheckboxList('phe-contains-cbl', splitContains.known);
  phPopulateCheckboxList('phe-tagged-cbl',   splitTagged.known);
}

function pheNav(dir) {
  const next = PHE.photoIdx + dir;
  if (next >= 0 && next < PHE.photos.length) pheRenderPhoto(next);
}

// ── Save ──────────────────────────────────────────────────────────────────────

async function pheSave() {
  const photo = PHE.photos[PHE.photoIdx];
  if (!photo) return;

  photo.caption       = document.getElementById('phe-caption')?.value       || '';
  photo.caption_short = document.getElementById('phe-caption-short')?.value || '';
  photo.photographer  = document.getElementById('phe-photographer')?.value.trim()  || '';
  photo.credit        = document.getElementById('phe-credit')?.value        || '';
  photo.quality       = document.getElementById('phe-quality')?.value       || '';
  photo.date          = document.getElementById('phe-date')?.value          || '';
  photo.date_known    = document.getElementById('phe-date-known')?.checked  || false;
  photo.event         = document.getElementById('phe-event')?.value.trim()  || '';

  const containsStr = phGetCheckboxList('phe-contains-cbl', 'phe-contains-extra');
  const taggedStr   = phGetCheckboxList('phe-tagged-cbl',   'phe-tagged-extra');
  photo.contains = containsStr ? containsStr.split(',').map(s => s.trim()).filter(Boolean) : [];
  photo.tagged   = taggedStr   ? taggedStr.split(',').map(s => s.trim()).filter(Boolean)   : [];

  const confirmEl = document.getElementById('phe-save-confirm');
  const errorEl   = document.getElementById('phe-save-error');
  if (confirmEl) confirmEl.style.display = 'none';
  if (errorEl)   errorEl.style.display   = 'none';

  try {
    await api('PATCH', `/photos/edit/${encodeURIComponent(PHE.selectedSlug)}`, { updates: PHE.photos });
    if (confirmEl) {
      confirmEl.style.display = 'inline';
      setTimeout(() => { confirmEl.style.display = 'none'; }, 1800);
    }
  } catch(e) {
    if (errorEl) {
      errorEl.textContent   = `Save failed: ${e.message}`;
      errorEl.style.display = 'inline';
    }
  }
}
</script>


<!-- ══════════════════════════════════════════════════════════════
     TAB 5 CSS
     ══════════════════════════════════════════════════════════════ -->
<style>
/* ── Tab bar additions ── */
.add-issue-btn {
  margin-left: auto;
  background: var(--accent, #5a7a4a);
  color: #fff;
  border-color: var(--accent, #5a7a4a);
  font-weight: 600;
}
.add-issue-btn:hover { opacity: 0.88; }

.tab-badge {
  display: inline-block;
  background: #c0392b;
  color: #fff;
  border-radius: 10px;
  font-size: 0.7rem;
  padding: 1px 6px;
  margin-left: 6px;
  vertical-align: middle;
}

/* ── Todo layout ── */
.todo-layout {
  display: flex;
  gap: 0;
  height: calc(100vh - 120px);
  overflow: hidden;
}

.todo-sidebar {
  width: 160px;
  min-width: 160px;
  border-right: 1px solid var(--rule, #ccc);
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 12px 8px;
}

.todo-nav-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 8px 10px;
  background: none;
  border: none;
  border-radius: 4px;
  text-align: left;
  cursor: pointer;
  font-size: 0.9rem;
  color: var(--ink, #222);
}
.todo-nav-btn:hover  { background: var(--hover, #f0ede6); }
.todo-nav-btn.active { background: var(--hover, #f0ede6); font-weight: 600; }

.todo-nav-count {
  font-size: 0.75rem;
  background: var(--rule, #ccc);
  border-radius: 8px;
  padding: 1px 6px;
  color: var(--ink-muted, #666);
}

.todo-main {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px;
}

/* ── Pane header ── */
.todo-pane-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  flex-wrap: wrap;
}
.todo-pane-title {
  font-size: 1rem;
  font-weight: 600;
  margin-right: 4px;
}
.todo-scope-chips {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}
.scope-chip {
  padding: 3px 10px;
  border-radius: 12px;
  border: 1px solid var(--rule, #ccc);
  background: none;
  font-size: 0.8rem;
  cursor: pointer;
  color: var(--ink, #222);
}
.scope-chip.active {
  background: var(--ink, #222);
  color: var(--cream, #fff);
  border-color: var(--ink, #222);
}

/* ── Item cards ── */
.todo-list { display: flex; flex-direction: column; gap: 6px; }

.todo-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid var(--rule, #ccc);
  border-radius: 6px;
  background: var(--surface, #faf8f4);
  position: relative;
}
.todo-item.is-epic {
  border-left: 3px solid var(--accent, #5a7a4a);
  background: var(--surface-alt, #f5f2eb);
}
.todo-item.is-bug-site  { border-left: 3px solid #c0392b; }
.todo-item.is-bug-admin { border-left: 3px solid #e67e22; }
.todo-item.is-bug-data  { border-left: 3px solid #8e44ad; }
.todo-item.is-done { opacity: 0.55; }
.todo-item.is-done .todo-item-title { text-decoration: line-through; }
.todo-item.is-child { margin-left: 20px; }

.todo-item-check {
  margin-top: 2px;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  cursor: pointer;
}
.todo-item-body  { flex: 1; min-width: 0; }
.todo-item-title { font-size: 0.9rem; font-weight: 500; word-break: break-word; }
.todo-item-notes {
  font-size: 0.8rem;
  color: var(--ink-muted, #666);
  margin-top: 3px;
  white-space: pre-wrap;
  word-break: break-word;
}
.todo-item-meta {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-top: 5px;
  align-items: center;
}
.badge {
  font-size: 0.7rem;
  padding: 1px 6px;
  border-radius: 8px;
  border: 1px solid var(--rule, #ccc);
  color: var(--ink-muted, #555);
  background: var(--surface, #faf8f4);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.badge-scope-site   { border-color: #c0392b; color: #c0392b; }
.badge-scope-admin  { border-color: #e67e22; color: #e67e22; }
.badge-scope-data   { border-color: #8e44ad; color: #8e44ad; }
.badge-type-epic    { border-color: var(--accent, #5a7a4a); color: var(--accent, #5a7a4a); }
.badge-type-bug     { background: #fde8e8; }
.badge-type-research { background: #e8f0fd; }

.todo-relates {
  font-size: 0.75rem;
  color: var(--ink-muted, #666);
  margin-top: 3px;
}
.todo-relates span {
  font-family: monospace;
  background: var(--hover, #f0ede6);
  padding: 0px 4px;
  border-radius: 3px;
  margin-right: 3px;
}

.todo-group-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ink-muted, #888);
  margin: 14px 0 6px;
}

/* ── Health checks ── */
.todo-scan-dashboard { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }

.scan-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 12px;
  border: 1px solid var(--rule, #ccc);
  border-radius: 6px;
  background: var(--surface, #faf8f4);
}
.scan-row-name  { flex: 1; font-size: 0.88rem; font-weight: 500; }
.scan-row-meta  { font-size: 0.78rem; color: var(--ink-muted, #666); min-width: 140px; }
.scan-row-meta.stale { color: #e67e22; }
.scan-row-meta.never { color: #c0392b; }
.scan-row-count { font-size: 0.8rem; min-width: 60px; text-align: right; }
.btn-sm {
  padding: 4px 10px;
  font-size: 0.8rem;
  border: 1px solid var(--rule, #ccc);
  border-radius: 4px;
  background: var(--surface, #faf8f4);
  cursor: pointer;
}
.btn-sm:hover { background: var(--hover, #f0ede6); }
.btn-sm.running { opacity: 0.6; pointer-events: none; }

.todo-scan-results {
  border: 1px solid var(--rule, #ccc);
  border-radius: 6px;
  padding: 12px;
  margin-top: 8px;
}
.todo-scan-results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  font-weight: 600;
}
.scan-result-row {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  padding: 7px 0;
  border-bottom: 1px solid var(--rule, #eee);
  font-size: 0.85rem;
}
.scan-result-row:last-child { border-bottom: none; }
.scan-result-slug   { font-family: monospace; min-width: 160px; color: var(--ink, #222); }
.scan-result-path   { color: var(--ink-muted, #666); flex: 1; font-size: 0.78rem; }
.scan-result-detail { color: var(--ink-muted, #555); flex: 1; font-size: 0.78rem; white-space: pre-wrap; }
.btn-promote {
  padding: 3px 8px;
  font-size: 0.75rem;
  background: var(--accent, #5a7a4a);
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  white-space: nowrap;
}
.btn-promote:hover { opacity: 0.85; }

/* ── Add Issue Modal ── */
.modal-box {
  background: var(--cream, #fff);
  border-radius: 8px;
  width: 540px;
  max-width: 95vw;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  border-bottom: 1px solid var(--rule, #ccc);
}
.modal-title  { font-weight: 700; font-size: 1rem; }
.modal-close  { background: none; border: none; font-size: 1.1rem; cursor: pointer; color: var(--ink-muted, #666); }
.modal-body   { flex: 1; overflow-y: auto; padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; }
.modal-footer { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--rule, #ccc); }

.form-row { display: flex; flex-direction: column; gap: 4px; }
.form-row label { font-size: 0.82rem; font-weight: 600; color: var(--ink-muted, #555); }
.form-row input, .form-row select, .form-row textarea {
  border: 1px solid var(--rule, #ccc);
  border-radius: 4px;
  padding: 6px 8px;
  font-size: 0.9rem;
  font-family: inherit;
  background: var(--surface, #faf8f4);
  color: var(--ink, #222);
}
.form-row textarea { resize: vertical; }
.form-row small { font-size: 0.75rem; color: var(--ink-muted, #888); }
.id-preview {
  font-family: monospace;
  font-size: 0.82rem;
  color: var(--ink-muted, #666);
  background: var(--hover, #f0ede6);
  padding: 4px 8px;
  border-radius: 4px;
}
.req { color: #c0392b; }

.btn-primary {
  padding: 7px 18px;
  background: var(--accent, #5a7a4a);
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
}
.btn-primary:hover { opacity: 0.88; }
.btn-secondary {
  padding: 7px 18px;
  background: none;
  border: 1px solid var(--rule, #ccc);
  border-radius: 4px;
  font-size: 0.9rem;
  cursor: pointer;
}
.btn-secondary:hover { background: var(--hover, #f0ede6); }
</style>


<!-- ══════════════════════════════════════════════════════════════
     TAB 5 JAVASCRIPT
     ══════════════════════════════════════════════════════════════ -->
<script>
// ─── State ───────────────────────────────────────────────────────────────────
const TODO = {
  items:       [],
  scans:       {},
  activePane:  'open',
  scopeFilter: '',
  lastScanKey: null,
  lastScanResults: []
};

// ─── Boot ────────────────────────────────────────────────────────────────────
async function todoInit() {
  await todoLoadItems();
  await todoLoadScans();
  todoRenderOpen();
  todoUpdateBadge();
  todoRenderScanDashboard();
}

// ─── Data loading ────────────────────────────────────────────────────────────
async function todoLoadItems() {
  try {
    const res    = await fetch('/api/todo/items');
    TODO.items   = await res.json();
    todoUpdateCounts();
  } catch (e) { console.error('todoLoadItems', e); }
}

async function todoLoadScans() {
  try {
    const res  = await fetch('/api/todo/scans');
    TODO.scans = await res.json();
  } catch (e) { console.error('todoLoadScans', e); }
}

// ─── Badge + counts ──────────────────────────────────────────────────────────
function todoUpdateBadge() {
  const open   = TODO.items.filter(i => i.status === 'open' && i.type !== 'epic');
  const badge  = document.getElementById('todo-badge');
  if (!badge) return;
  if (open.length > 0) {
    badge.textContent = open.length;
    badge.style.display = 'inline-block';
  } else {
    badge.style.display = 'none';
  }
}

function todoUpdateCounts() {
  const open = TODO.items.filter(i => i.status === 'open').length;
  const done = TODO.items.filter(i => i.status === 'complete').length;
  const elO  = document.getElementById('todo-open-count');
  const elD  = document.getElementById('todo-done-count');
  if (elO) elO.textContent = open;
  if (elD) elD.textContent = done;
}

// ─── Pane switching ──────────────────────────────────────────────────────────
function todoShowPane(pane) {
  TODO.activePane = pane;
  ['open','done','health'].forEach(p => {
    const el  = document.getElementById(`todo-pane-${p}`);
    const btn = document.getElementById(`todo-nav-${p}`);
    if (el)  el.style.display  = (p === pane) ? 'block' : 'none';
    if (btn) btn.classList.toggle('active', p === pane);
  });
  if (pane === 'open')   todoRenderOpen();
  if (pane === 'done')   todoRenderDone();
  if (pane === 'health') todoRenderScanDashboard();
}

function todoScopeFilter(btn, scope) {
  TODO.scopeFilter = scope;
  document.querySelectorAll('.scope-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  todoRenderOpen();
}

// ─── Render: Open pane ───────────────────────────────────────────────────────
function todoRenderOpen() {
  const list     = document.getElementById('todo-open-list');
  const typeVal  = document.getElementById('todo-filter-type')?.value || '';
  const scopeVal = TODO.scopeFilter;

  const open = TODO.items.filter(i => {
    if (i.status !== 'open') return false;
    if (typeVal  && i.type  !== typeVal)  return false;
    if (scopeVal && i.scope !== scopeVal) return false;
    return true;
  });

  const groups = [
    { key: 'epic',     label: 'Epics',    items: [] },
    { key: 'bug',      label: 'Bugs',     items: [] },
    { key: 'task',     label: 'Tasks',    items: [] },
    { key: 'research', label: 'Research', items: [] }
  ];

  const roots    = open.filter(i => !i.parent_id);
  const children = open.filter(i =>  i.parent_id);

  roots.forEach(item => {
    const g = groups.find(g => g.key === item.type);
    if (g) {
      g.items.push(item);
      children.filter(c => c.parent_id === item.id).forEach(c => g.items.push({ ...c, _child: true }));
    }
  });

  const scopeOrder = { site: 0, admin: 1, data: 2 };
  groups.find(g => g.key === 'bug').items.sort((a, b) =>
    (scopeOrder[a.scope] ?? 9) - (scopeOrder[b.scope] ?? 9)
  );

  let html = '';
  for (const group of groups) {
    if (!group.items.length) continue;
    if (!typeVal) html += `<div class="todo-group-label">${group.label}</div>`;
    group.items.forEach(item => { html += todoItemHtml(item, item._child); });
  }

  list.innerHTML = html || '<p style="color:var(--ink-muted,#888);font-size:0.9rem">No open items.</p>';
}

// ─── Render: Done pane ───────────────────────────────────────────────────────
function todoRenderDone() {
  const list    = document.getElementById('todo-done-list');
  const typeVal = document.getElementById('todo-done-filter-type')?.value || '';

  const done = TODO.items
    .filter(i => i.status === 'complete' && (!typeVal || i.type === typeVal))
    .sort((a, b) => (b.completed || '').localeCompare(a.completed || ''));

  list.innerHTML = done.length
    ? done.map(i => todoItemHtml(i, false)).join('')
    : '<p style="color:var(--ink-muted,#888);font-size:0.9rem">Nothing completed yet.</p>';
}

// ─── Item card HTML ──────────────────────────────────────────────────────────
function todoItemHtml(item, isChild) {
  const isDone = item.status === 'complete';
  const isEpic = item.type   === 'epic';
  const isBug  = item.type   === 'bug';

  let cls = 'todo-item';
  if (isEpic)           cls += ' is-epic';
  if (isBug && !isDone) {
    if (item.scope === 'site')  cls += ' is-bug-site';
    if (item.scope === 'admin') cls += ' is-bug-admin';
    if (item.scope === 'data')  cls += ' is-bug-data';
  }
  if (isDone)  cls += ' is-done';
  if (isChild) cls += ' is-child';

  const checked    = isDone ? 'checked' : '';
  const scopeBadge = item.scope
    ? `<span class="badge badge-scope-${item.scope}">${item.scope}</span>` : '';
  const typeBadge  = `<span class="badge badge-type-${item.type}">${item.type}</span>`;
  const dateBadge  = `<span class="badge">${isDone ? item.completed : item.created}</span>`;

  const relates = (item.relates_to || []).length
    ? `<div class="todo-relates">↔ ${item.relates_to.map(id =>
        `<span>${escHtml(id)}</span>`).join('')}</div>` : '';

  const notes = item.notes
    ? `<div class="todo-item-notes">${escHtml(item.notes)}</div>` : '';

  const childCount = isEpic
    ? TODO.items.filter(c => c.parent_id === item.id && c.status === 'open').length : null;
  const checkOrCount = isEpic
    ? `<span style="font-size:0.75rem;color:var(--ink-muted,#888);min-width:16px">${childCount} open</span>`
    : `<input type="checkbox" class="todo-item-check" ${checked}
         onchange="todoToggleItem('${item.id}', this.checked)" />`;

  return `
    <div class="${cls}" id="todo-item-${item.id}">
      ${checkOrCount}
      <div class="todo-item-body">
        <div class="todo-item-title">${escHtml(item.title)}</div>
        ${notes}
        ${relates}
        <div class="todo-item-meta">
          ${scopeBadge}${typeBadge}${dateBadge}
        </div>
      </div>
    </div>`;
}

// ─── Toggle complete ─────────────────────────────────────────────────────────
async function todoToggleItem(id, complete) {
  try {
    await fetch(`/api/todo/items/${id}`, {
      method:  'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ status: complete ? 'complete' : 'open' })
    });
    await todoLoadItems();
    todoRenderOpen();
    todoRenderDone();
    todoUpdateBadge();
  } catch (e) { console.error('todoToggleItem', e); }
}

// ─── Health Checks ───────────────────────────────────────────────────────────
const SCAN_LABELS = {
  draft_records:       'Draft records',
  open_questions:      'Open questions in front matter',
  missing_first_name:  'Soldiers missing first name',
  broken_slug_refs:    'Broken slug references (contains / tagged)',
  name_duplicates:     'Duplicate soldier names',
  front_matter_health: 'Malformed slugs in front matter'
};

function todoRenderScanDashboard() {
  const el = document.getElementById('todo-scan-dashboard');
  if (!el) return;

  const now = new Date();
  let html  = '';

  for (const [key, label] of Object.entries(SCAN_LABELS)) {
    const meta    = TODO.scans[key] || {};
    const lastRun = meta.last_run;
    const count   = meta.result_count;
    let metaCls   = '';
    let metaTxt   = 'Never run';

    if (lastRun) {
      const diff = Math.floor((now - new Date(lastRun)) / 86400000);
      metaTxt    = `Last run: ${lastRun} (${diff}d ago)`;
      metaCls    = diff > 7 ? 'stale' : '';
    } else {
      metaCls = 'never';
    }

    const countTxt = count !== null && count !== undefined
      ? `${count} result${count !== 1 ? 's' : ''}` : '—';

    html += `
      <div class="scan-row">
        <span class="scan-row-name">${label}</span>
        <span class="scan-row-meta ${metaCls}">${metaTxt}</span>
        <span class="scan-row-count">${countTxt}</span>
        <button class="btn-sm" id="scan-run-${key}"
                onclick="todoRunScan('${key}', this)">Run</button>
      </div>`;
  }

  el.innerHTML = html;
}

async function todoRunScan(scanKey, btn) {
  btn.textContent = 'Running…';
  btn.classList.add('running');
  try {
    const res  = await fetch(`/api/todo/scans/${scanKey}/run`, { method: 'POST' });
    const data = await res.json();
    TODO.lastScanKey     = scanKey;
    TODO.lastScanResults = data.results || [];
    await todoLoadScans();
    todoRenderScanDashboard();
    todoShowScanResults(scanKey, data.results || []);
  } catch (e) {
    console.error('todoRunScan', e);
  } finally {
    btn.textContent = 'Run';
    btn.classList.remove('running');
  }
}

function todoShowScanResults(scanKey, results) {
  const container = document.getElementById('todo-scan-results');
  const title     = document.getElementById('todo-scan-results-title');
  const list      = document.getElementById('todo-scan-results-list');
  if (!container || !title || !list) return;

  title.textContent = `${SCAN_LABELS[scanKey]} — ${results.length} result${results.length !== 1 ? 's' : ''}`;
  container.style.display = 'block';

  if (!results.length) {
    list.innerHTML = '<p style="color:var(--ink-muted,#888);font-size:0.88rem">No issues found.</p>';
    return;
  }

  list.innerHTML = results.map((r, idx) => `
    <div class="scan-result-row">
      <span class="scan-result-slug">${escHtml(r.slug || '—')}</span>
      <span class="scan-result-path">${escHtml(r.path || '')}</span>
      <span class="scan-result-detail">${escHtml(r.detail || '')}</span>
      <button class="btn-promote"
              onclick="todoPromoteResult('${scanKey}', ${idx})">→ Task</button>
    </div>`).join('');
}

function todoCloseScanResults() {
  const el = document.getElementById('todo-scan-results');
  if (el) el.style.display = 'none';
}

async function todoPromoteResult(scanKey, idx) {
  const r = TODO.lastScanResults[idx];
  if (!r) return;
  openAddIssueModal({
    type:  'task',
    scope: 'data',
    title: `[${scanKey}] ${r.slug}`,
    notes: r.detail || '',
    promotedFrom: { scanKey, slug: r.slug, detail: r.detail }
  });
}

// ─── Add Issue Modal ─────────────────────────────────────────────────────────
let _pendingPromotedFrom = null;

function openAddIssueModal(prefill = {}) {
  _pendingPromotedFrom = prefill.promotedFrom || null;

  document.getElementById('ai-type').value  = prefill.type  || '';
  document.getElementById('ai-scope').value = prefill.scope || '';
  document.getElementById('ai-title').value = prefill.title || '';
  document.getElementById('ai-notes').value = prefill.notes || '';
  updateAddIssueId();

  const parentSel = document.getElementById('ai-parent');
  const epics     = TODO.items.filter(i => i.type === 'epic' && i.status === 'open');
  parentSel.innerHTML = '<option value="">None (flat task)</option>' +
    epics.map(e => `<option value="${e.id}">${escHtml(e.title)}</option>`).join('');

  const relSel = document.getElementById('ai-relates');
  const open   = TODO.items.filter(i => i.status === 'open');
  relSel.innerHTML = open.map(i =>
    `<option value="${i.id}">[${i.type.toUpperCase()}] ${escHtml(i.title.slice(0,60))}</option>`
  ).join('');

  document.getElementById('add-issue-modal').style.display = 'flex';
  document.getElementById('ai-title').focus();
}

function closeAddIssueModal() {
  document.getElementById('add-issue-modal').style.display = 'none';
  _pendingPromotedFrom = null;
}

function closeAddIssueModalIfBg(e) {
  if (e.target === document.getElementById('add-issue-modal')) closeAddIssueModal();
}

function updateAddIssueId() {
  const type  = document.getElementById('ai-type')?.value  || '???';
  const scope = document.getElementById('ai-scope')?.value || '???';
  const now   = new Date();
  const pad   = (n, l=2) => String(n).padStart(l,'0');
  const ts    = `${now.getFullYear()}${pad(now.getMonth()+1)}${pad(now.getDate())}${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}${pad(now.getMilliseconds(),3)}`;
  const el    = document.getElementById('add-issue-id-preview');
  if (el) el.textContent = `${scope.toUpperCase()}-${type.toUpperCase()}-${ts}`;
}

async function submitAddIssue() {
  const type     = document.getElementById('ai-type').value.trim();
  const scope    = document.getElementById('ai-scope').value.trim();
  const title    = document.getElementById('ai-title').value.trim();
  const notes    = document.getElementById('ai-notes').value.trim();
  const parentId = document.getElementById('ai-parent').value || null;
  const relatesTo = Array.from(document.getElementById('ai-relates').selectedOptions).map(o => o.value);

  if (!type || !scope || !title) {
    alert('Type, Scope, and Title are required.');
    return;
  }

  try {
    const endpoint = _pendingPromotedFrom ? '/api/todo/promote' : '/api/todo/items';
    const body     = {
      type, scope, title, notes,
      parent_id:  parentId,
      relates_to: relatesTo,
      ..._pendingPromotedFrom ? {
        scanKey: _pendingPromotedFrom.scanKey,
        slug:    _pendingPromotedFrom.slug,
        detail:  _pendingPromotedFrom.detail
      } : {}
    };

    await fetch(endpoint, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify(body)
    });

    closeAddIssueModal();
    await todoLoadItems();
    todoRenderOpen();
    todoUpdateBadge();
    todoUpdateCounts();
  } catch (e) {
    console.error('submitAddIssue', e);
    alert('Failed to save issue. Check console.');
  }
}

// ─── Hook into switchTab ──────────────────────────────────────────────────────
// Intercept switchTab calls for 'todo' to trigger todoInit, and 'feedback' to load data
(function() {
  const _orig = typeof switchTab === 'function' ? switchTab : null;
  window.switchTab = function(name) {
    if (_orig) _orig(name);
    if (name === 'todo') todoInit();
    if (name === 'feedback') fbInit();
  };
})();
</script>

<!-- ARRAY / SCALAR FIELD POPOVER -->
<div id="fm-popover" class="fm-popover">
  <div class="fm-popover-title" id="fm-popover-title"></div>
  <div style="font-size:11px;color:var(--muted);margin-bottom:4px;">Current entries — click × to remove</div>
  <div class="fm-popover-chips" id="fm-popover-chips"></div>

  <!-- Slug-backed add -->
  <div id="fm-popover-add-select">
    <div style="font-size:11px;color:var(--muted);margin-bottom:4px;">Add</div>
    <select multiple id="fm-popover-select" size="5" style="width:100%"></select>
    <div style="font-size:11px;color:var(--muted);margin-top:3px;" id="fm-popover-select-hint"></div>
  </div>

  <!-- Free-text add -->
  <div id="fm-popover-add-text" style="display:none">
    <div style="font-size:11px;color:var(--muted);margin-bottom:4px;">Add</div>
    <input type="text" id="fm-popover-text" placeholder="Enter value…" style="width:100%"
           onkeydown="if(event.key==='Enter'){event.preventDefault();fmPopoverAdd();}">
  </div>

  <div class="fm-popover-footer">
    <button class="btn btn-secondary btn-sm" onclick="fmPopoverClose()">Close</button>
    <button class="btn btn-primary btn-sm" onclick="fmPopoverAdd()">Add</button>
  </div>
</div>

<style>
/* ── Site Feedback tab ── */
.fb-pane {
  flex-direction: column;
  overflow: hidden;
  display: none;
  height: calc(100vh - 155px);
}
.fb-pane-active { display: flex; }
.fb-list {
  flex: 1;
  overflow-y: auto;
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
/* Request type group headers */
.fb-type-group { margin-bottom: 4px; }
.fb-type-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  padding: 10px 0 6px;
  border-bottom: 1px solid var(--rule);
  margin-bottom: 8px;
}
/* Individual cards */
.fb-card {
  border: 1px solid var(--rule);
  border-radius: 5px;
  background: var(--paper);
  overflow: hidden;
}
.fb-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px 10px;
  background: var(--cream);
  border-bottom: 1px solid var(--rule);
}
.fb-card-name {
  font-weight: 700;
  font-size: 0.95rem;
}
.fb-card-meta {
  font-size: 0.78rem;
  color: var(--muted);
  margin-top: 2px;
}
.fb-card-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 2px 8px;
  border-radius: 3px;
  background: var(--yellow);
  color: var(--ink);
  flex-shrink: 0;
}
.fb-card-body {
  padding: 12px 16px;
}
/* Request message / raw text */
.fb-message {
  font-family: var(--font-body);
  font-size: 0.92rem;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
  margin-bottom: 10px;
}
/* Survey answer sections */
.fb-section {
  margin-bottom: 14px;
}
.fb-section-title {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 6px;
  padding-bottom: 4px;
  border-bottom: 1px solid var(--rule);
}
.fb-qa {
  margin-bottom: 8px;
}
.fb-q {
  font-size: 0.82rem;
  color: var(--muted);
  margin-bottom: 2px;
}
.fb-q.is-followup { padding-left: 12px; border-left: 2px solid var(--rule); }
.fb-a {
  font-family: var(--font-body);
  font-size: 0.92rem;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-word;
}
/* Skip info */
.fb-skipped {
  font-size: 0.8rem;
  font-style: italic;
  color: var(--muted);
  margin-top: 4px;
}
/* Document file list */
.fb-file-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 10px;
}
.fb-file-chip {
  font-size: 0.75rem;
  font-family: monospace;
  background: var(--cream);
  border: 1px solid var(--rule);
  border-radius: 3px;
  padding: 2px 8px;
}
/* Card action row */
.fb-card-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  padding: 8px 16px 12px;
  border-top: 1px solid var(--rule);
  margin-top: 8px;
}
.btn-danger-sm {
  font-size: 0.78rem;
  padding: 4px 10px;
  background: none;
  border: 1px solid var(--red);
  color: var(--red);
  border-radius: 3px;
  cursor: pointer;
  font-family: var(--font-ui);
}
.btn-danger-sm:hover { background: var(--red); color: #fff; }
.fb-pulled-tag {
  font-size: 0.72rem;
  color: var(--green);
  font-style: italic;
  align-self: center;
  margin-right: auto;
}
/* Skipper Stories panel additions */
.fb-story-tab {
  font-size: 0.78rem;
  color: var(--muted);
  margin-bottom: 8px;
}
.fb-story-response {
  font-size: 0.9rem;
  color: var(--ink, #14120c);
  line-height: 1.6;
  white-space: pre-wrap;
  background: #fafaf8;
  border: 1px solid var(--border);
  padding: 10px 14px;
  margin-bottom: 10px;
  max-height: 220px;
  overflow-y: auto;
}
.fb-card-meta-row {
  display: flex;
  gap: 16px;
  font-size: 0.78rem;
  color: var(--muted);
  flex-wrap: wrap;
}
.ph-toolbar-hint {
  font-size: 0.75rem;
  color: var(--muted);
  font-style: italic;
  align-self: center;
}
</style>

<!-- PROFILE PHOTO MODAL -->
<div id="pph-modal" class="modal-overlay" onclick="pphCloseBg(event)">
  <div class="modal" style="width:580px;max-width:95vw;position:relative;">
    <button onclick="pphClose()" style="position:absolute;top:16px;right:16px;background:none;border:none;font-size:18px;cursor:pointer;color:var(--muted);" title="Close">✕</button>
    <h2>Set Profile Photo</h2>

    <!-- Step 1: Drop -->
    <div class="pph-step active" id="pph-step-drop">
      <p class="section-desc" style="margin-bottom:12px;">Drop a photo, or click to browse. JPEG or PNG.</p>
      <div class="pph-drop-zone" id="pph-drop-zone"
           onclick="document.getElementById('pph-file-input').click()">
        <div style="font-size:24px;margin-bottom:8px;">↓</div>
        <div>Drop photo here or click to browse</div>
      </div>
      <input type="file" id="pph-file-input" accept="image/jpeg,image/png"
             style="display:none" onchange="pphFileSelected(event)">
    </div>

    <!-- Step 2: Crop + metadata -->
    <div class="pph-step" id="pph-step-crop">
      <p style="font-size:12px;color:var(--muted);margin-bottom:8px;">
        Drag to select a crop area, or leave empty to use the full image.
      </p>
      <div style="text-align:center;">
        <div class="pph-crop-wrap" id="pph-crop-wrap">
          <img class="pph-crop-img" id="pph-crop-img" draggable="false" alt="">
          <div class="pph-crop-overlay" id="pph-crop-overlay">
            <div class="pph-crop-rect" id="pph-crop-rect"></div>
          </div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
        <button class="btn btn-secondary btn-sm" onclick="pphCropReset()">Reset crop</button>
        <span id="pph-crop-coords" style="font-size:11px;color:var(--muted);">drag to select — or skip for full image</span>
      </div>
      <div class="pph-meta-grid">
        <span class="pph-meta-label">Credit</span>
        <input type="text" id="pph-credit" placeholder="e.g. Photographed by Dale Tincher">
        <span class="pph-meta-label">Photographer</span>
        <input type="text" id="pph-photographer" placeholder="soldier slug (optional)"
               list="pph-photographer-list">
        <datalist id="pph-photographer-list"></datalist>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="btn btn-secondary" onclick="pphBack()">← Back</button>
        <button class="btn btn-primary" onclick="pphSave()">Save Profile Photo</button>
      </div>
    </div>
  </div>
</div>
<!-- SITE FEEDBACK JS -->
<script>
// ── Site Feedback state ──────────────────────────────────────────────────────
const FB = {
  loaded:       { requests: false, accounts: false, documents: false, stories: false },
  accountItems: {},  // key → full item object for create-draft lookup
};

// ── Init / tab switch ────────────────────────────────────────────────────────
function fbInit() {
  // Load whichever subtab is currently active
  const active = document.querySelector('#panel-feedback .ph-subtab.active');
  const name = active ? active.id.replace('fb-tab-btn-', '') : 'requests';
  if (!FB.loaded[name]) _fbLoad(name);
}

function fbSwitchSubTab(name) {
  document.querySelectorAll('#panel-feedback .ph-subtab').forEach(b => b.classList.remove('active'));
  const btn = document.getElementById(`fb-tab-btn-${name}`);
  if (btn) btn.classList.add('active');

  document.querySelectorAll('.fb-pane').forEach(p => {
    p.style.display = 'none';
    p.classList.remove('fb-pane-active');
  });
  const pane = document.getElementById(`fb-pane-${name}`);
  if (pane) { pane.style.display = 'flex'; pane.classList.add('fb-pane-active'); }

  if (!FB.loaded[name]) _fbLoad(name);
}

function _fbLoad(name) {
  if (name === 'requests')  fbLoadRequests();
  if (name === 'accounts')  fbLoadAccounts();
  if (name === 'documents') fbLoadDocuments();
  if (name === 'stories')   fbLoadStories();
}

// ── Badge rollup ─────────────────────────────────────────────────────────────
async function loadFeedbackCounts() {
  try {
    const data = await api('GET', '/feedback/counts');
    const badge = document.getElementById('fb-tab-badge');
    if (badge) {
      badge.textContent = data.total;
      badge.style.display = data.total > 0 ? 'inline-block' : 'none';
    }
    _setSubBadge('requests',  data.requests);
    _setSubBadge('accounts',  data.accounts);
    _setSubBadge('documents', data.documents);
    _setSubBadge('stories',   data.stories);
  } catch (e) {
    console.error('loadFeedbackCounts', e);
  }
}

function _setSubBadge(name, count) {
  const el = document.getElementById(`fb-${name}-badge`);
  if (el) { el.textContent = count; el.style.display = count > 0 ? 'inline-block' : 'none'; }
}

// ── Helpers ──────────────────────────────────────────────────────────────────
function _fbFmt(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  if (isNaN(d)) return iso;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) +
    ' ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
}

function _fbSize(bytes) {
  if (!bytes) return '';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1048576) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / 1048576).toFixed(1)} MB`;
}

function _e(s) { return escHtml ? escHtml(s) : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ── Requests ─────────────────────────────────────────────────────────────────
async function fbLoadRequests() {
  FB.loaded.requests = false;
  const list = document.getElementById('fb-requests-list');
  list.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const data = await api('GET', '/feedback/requests');
    FB.loaded.requests = true;
    const items = data.items || [];
    if (!items.length) {
      list.innerHTML = '<p class="ph-placeholder">No pending requests.</p>';
      return;
    }
    // Group by type_label
    const groups = {};
    items.forEach(item => {
      const label = item.type_label || 'Unknown';
      if (!groups[label]) groups[label] = [];
      groups[label].push(item);
    });
    let html = '';
    for (const [label, group] of Object.entries(groups)) {
      html += `<div class="fb-type-group">`;
      html += `<div class="fb-type-label">${_e(label)} <span style="font-weight:400;opacity:.7">(${group.length})</span></div>`;
      group.forEach(item => { html += _fbRequestCard(item); });
      html += `</div>`;
    }
    list.innerHTML = html;
    _setSubBadge('requests', items.length);
  } catch (e) {
    list.innerHTML = `<p class="ph-placeholder" style="color:var(--red)">Error: ${_e(e.message)}</p>`;
  }
}

function _fbRequestCard(item) {
  const name    = item.name    ? _e(item.name)    : '<em style="color:var(--muted)">Anonymous</em>';
  const contact = item.contact ? ` — ${_e(item.contact)}` : '';
  const page    = item.page    ? `<span style="font-size:.78rem;color:var(--muted)"> on /${_e(item.page)}</span>` : '';
  const msg     = item.message || item.details || '';

  return `<div class="fb-card" data-key="${_e(item.key)}">
  <div class="fb-card-header">
    <div>
      <div class="fb-card-name">${name}${contact}</div>
      <div class="fb-card-meta">${_fbFmt(item.submitted)}${page}</div>
    </div>
    <span class="fb-card-badge">${_e(item.type_label || item.type || '?')}</span>
  </div>
  <div class="fb-card-body">
    ${msg ? `<div class="fb-message">${_e(msg)}</div>` : ''}
    ${item.soldier_name ? `<div style="font-size:.82rem;color:var(--muted)">Soldier: <strong>${_e(item.soldier_name)}</strong>${item.soldier_slug ? ` (${_e(item.soldier_slug)})` : ''}</div>` : ''}
  </div>
  <div class="fb-card-actions">
    <button class="btn-danger-sm" onclick="fbDiscardRequest('${_e(item.key)}', this)">Discard</button>
  </div>
</div>`;
}

async function fbDiscardRequest(key, btn) {
  if (!confirm('Delete this request from R2? This cannot be undone.')) return;
  btn.disabled = true;
  try {
    await api('POST', '/feedback/discard/request', { key });
    btn.closest('.fb-card').remove();
    toast('Request discarded.', 'success');
    loadFeedbackCounts();
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
  }
}

// ── Survey Accounts ───────────────────────────────────────────────────────────
async function fbLoadAccounts() {
  FB.loaded.accounts = false;
  const list = document.getElementById('fb-accounts-list');
  list.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const data = await api('GET', '/feedback/accounts');
    FB.loaded.accounts = true;
    const items = data.items || [];
    if (!items.length) {
      list.innerHTML = '<p class="ph-placeholder">No survey responses.</p>';
      return;
    }
    FB.accountItems = {};
    items.forEach(item => { if (item.key) FB.accountItems[item.key] = item; });
    list.innerHTML = items.map(item => _fbAccountCard(item)).join('');
    _setSubBadge('accounts', items.length);
  } catch (e) {
    list.innerHTML = `<p class="ph-placeholder" style="color:var(--red)">Error: ${_e(e.message)}</p>`;
  }
}

function _fbAccountCard(item) {
  const fullName    = [item.first_name, item.last_name].filter(Boolean).map(s => _e(s)).join(' ') || '<em style="color:var(--muted)">Unknown</em>';
  const platoon     = item.platoon  ? `<span class="fb-card-badge" style="margin-left:6px">${_e(item.platoon)}</span>` : '';
  const eventTitle  = item.event_title || item.event_slug || '';

  // Build answers HTML
  const resolved = item.resolved_answers || [];
  const skipped  = item.skipped_sections || {};
  let answersHtml = '';

  for (const section of resolved) {
    answersHtml += `<div class="fb-section">
      <div class="fb-section-title">${_e(section.sectionTitle)}</div>`;
    for (const qa of section.answers) {
      const answerText = Array.isArray(qa.answer) ? qa.answer.join(', ') : String(qa.answer);
      answersHtml += `<div class="fb-qa">
        <div class="fb-q${qa.isFollowUp ? ' is-followup' : ''}">${_e(qa.text)}</div>
        <div class="fb-a">${_e(answerText)}</div>
      </div>`;
    }
    answersHtml += `</div>`;
  }

  const skippedSections = Object.keys(skipped);
  if (skippedSections.length) {
    answersHtml += `<div class="fb-skipped">Skipped sections: ${skippedSections.map(s => _e(s)).join(', ')}</div>`;
  }
  if (!answersHtml) {
    answersHtml = '<p class="ph-placeholder">No answers recorded.</p>';
  }

  const permAnswer = (item.answers || {})['closing-permission'] || '';
  const shareLabel = permAnswer === 'publish' ? 'OK to publish' :
                     permAnswer === 'restricted' ? 'Restricted' :
                     permAnswer === 'discuss' ? 'Wants follow-up' : '';
  const shareBadge = shareLabel ? `<span class="fb-card-badge" style="background:${permAnswer==='publish'?'var(--green);color:#fff':permAnswer==='discuss'?'#dbeafe;color:#1e40af':'#fee2e2;color:#991b1b'}">${shareLabel}</span>` : '';

  return `<div class="fb-card" data-key="${_e(item.key)}">
  <div class="fb-card-header">
    <div>
      <div class="fb-card-name">${fullName} ${platoon}</div>
      <div class="fb-card-meta">${_fbFmt(item.submitted)}${eventTitle ? ' — ' + _e(eventTitle) : ''}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0">
      ${shareBadge}
      <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end">
        ${item._pulled ? `<span class="fb-pulled-tag" style="align-self:center">✓ Pulled</span>` : ''}
        <button class="btn btn-secondary btn-sm" onclick="fbCreateDraft('${_e(item.key)}', this)">Create Draft</button>
        <button class="btn btn-secondary btn-sm" onclick="fbPullAccount('${_e(item.key)}', this)">Pull to _intake</button>
        <button class="btn-danger-sm" onclick="fbDiscardAccount('${_e(item.key)}', this)">Discard</button>
      </div>
    </div>
  </div>
  <div class="fb-card-body">
    ${answersHtml}
  </div>
</div>`;
}

async function fbCreateDraft(key, btn) {
  const item = FB.accountItems[key];
  if (!item) { toast('Item not found — try refreshing.', 'error'); return; }

  btn.disabled = true;
  btn.textContent = 'Creating…';
  try {
    const result = await api('POST', '/feedback/create-draft/account', item);
    btn.textContent = '✓ Draft created';
    btn.style.borderColor = 'var(--green)';
    btn.style.color = 'var(--green)';

    // Show the file path inline under the card header
    const card = btn.closest('.fb-card');
    const body = card.querySelector('.fb-card-body');
    const note = document.createElement('div');
    note.style.cssText = 'font-size:.78rem;font-family:monospace;color:var(--green);margin-bottom:10px;padding:6px 8px;background:#f0fff0;border-radius:3px;border:1px solid #b2dfb2';
    note.textContent = '✓ ' + result.filePath;
    body.insertBefore(note, body.firstChild);

    toast(`Draft created: ${result.filePath}`, 'success');
  } catch (e) {
    // 409 = already exists
    if (e.message && e.message.includes('already exists')) {
      btn.textContent = 'Draft exists';
      btn.disabled = false;
      toast(e.message, 'error');
    } else {
      toast('Error: ' + e.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Create Draft';
    }
  }
}

async function fbPullAccount(key, btn) {
  btn.disabled = true;
  btn.textContent = 'Pulling…';
  try {
    await api('POST', '/feedback/pull/account', { key });
    btn.textContent = '✓ Pulled';
    toast('Account pulled to _intake/accounts/', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Pull to _intake';
  }
}

async function fbDiscardAccount(key, btn) {
  if (!confirm('Delete this survey response from R2? This cannot be undone.')) return;
  btn.disabled = true;
  try {
    await api('POST', '/feedback/discard/account', { key });
    btn.closest('.fb-card').remove();
    toast('Response discarded.', 'success');
    loadFeedbackCounts();
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
  }
}

// ── Document Contributions ────────────────────────────────────────────────────
async function fbLoadDocuments() {
  FB.loaded.documents = false;
  const list = document.getElementById('fb-documents-list');
  list.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const data = await api('GET', '/feedback/documents');
    FB.loaded.documents = true;
    const items = data.items || [];
    if (!items.length) {
      list.innerHTML = '<p class="ph-placeholder">No document contributions.</p>';
      return;
    }
    list.innerHTML = items.map(item => _fbDocumentCard(item)).join('');
    _setSubBadge('documents', items.length);
  } catch (e) {
    list.innerHTML = `<p class="ph-placeholder" style="color:var(--red)">Error: ${_e(e.message)}</p>`;
  }
}

function _fbDocumentCard(item) {
  const meta     = item.metadata || {};
  const name     = meta.name    ? _e(meta.name)    : '<em style="color:var(--muted)">Unknown submitter</em>';
  const contact  = meta.contact ? ` — ${_e(meta.contact)}` : '';
  const desc     = meta.description || meta.message || '';
  const files    = item.files || [];
  const fileChips = files.map(f =>
    `<span class="fb-file-chip">${_e(f.filename)} <span style="color:var(--muted)">${_fbSize(f.size)}</span></span>`
  ).join('');

  return `<div class="fb-card" data-id="${_e(item.id)}">
  <div class="fb-card-header">
    <div>
      <div class="fb-card-name">${name}${contact}</div>
      <div class="fb-card-meta">${_fbFmt(meta.submitted)} — ${files.length} file${files.length !== 1 ? 's' : ''}</div>
    </div>
    <span class="fb-card-badge">${files.length} file${files.length !== 1 ? 's' : ''}</span>
  </div>
  <div class="fb-card-body">
    ${desc ? `<div class="fb-message">${_e(desc)}</div>` : ''}
    ${fileChips ? `<div class="fb-file-list">${fileChips}</div>` : ''}
    <div style="font-size:.75rem;color:var(--muted);font-family:monospace">ID: ${_e(item.id)}</div>
  </div>
  <div class="fb-card-actions">
    <button class="btn btn-secondary btn-sm" onclick="fbPullDocument('${_e(item.id)}', this)">Pull to _intake</button>
    <button class="btn-danger-sm" onclick="fbDiscardDocument('${_e(item.id)}', this)">Discard</button>
  </div>
</div>`;
}

async function fbPullDocument(id, btn) {
  btn.disabled = true;
  btn.textContent = 'Pulling…';
  try {
    await api('POST', `/feedback/pull/document/${encodeURIComponent(id)}`);
    btn.textContent = '✓ Pulled';
    const card = btn.closest('.fb-card');
    const actions = card.querySelector('.fb-card-actions');
    const tag = document.createElement('span');
    tag.className = 'fb-pulled-tag';
    tag.textContent = '✓ Pulled to _intake';
    actions.insertBefore(tag, actions.firstChild);
    toast('Document pulled to _intake/documents/', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Pull to _intake';
  }
}

async function fbDiscardDocument(id, btn) {
  if (!confirm('Delete this document folder from R2? This cannot be undone.')) return;
  btn.disabled = true;
  try {
    await api('POST', `/feedback/discard/document/${encodeURIComponent(id)}`);
    btn.closest('.fb-card').remove();
    toast('Document folder discarded.', 'success');
    loadFeedbackCounts();
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
  }
}

// ── Skipper Stories ───────────────────────────────────────────────────────────

async function fbLoadStories() {
  FB.loaded.stories = true;
  const list = document.getElementById('fb-stories-list');
  list.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const data = await api('GET', '/feedback/stories');
    if (!data.items || data.items.length === 0) {
      list.innerHTML = '<p class="ph-placeholder">No pending stories.</p>';
      return;
    }
    list.innerHTML = data.items.map(renderStoryCard).join('');
  } catch (e) {
    list.innerHTML = `<p class="ph-placeholder" style="color:var(--danger)">Error: ${_e(e.message)}</p>`;
  }
}

function renderStoryCard(item) {
  const displayName = item.publication === 'anonymous' ? 'Anonymous' : _e(item.name || '(no name)');
  const meta = [
    item.platoon ? _e(item.platoon + ' Platoon') : null,
    item.years   ? _e(item.years) : null,
  ].filter(Boolean).join(' · ');

  const pubLabel = {
    publish:   'Publish with name',
    anonymous: 'Publish anonymously',
    archive:   'Archive only — do not publish',
  }[item.publication] || item.publication || '(not set)';

  const status = item.status || 'pending';
  const statusLabel = { held: '⏸ Held', published: '✓ Published', withdrawn: '✗ Withdrawn' }[status] || '⌛ Pending';
  const isPublished = status === 'published' || status === 'withdrawn';

  return `<div class="fb-card" id="story-card-${_e(item.story_id || '')}">
    <div class="fb-card-header">
      <div class="fb-card-title">${displayName}${meta ? ` <span class="fb-card-meta">· ${meta}</span>` : ''}</div>
      <div class="fb-card-date">${_fbFmt(item.submitted)} · ${statusLabel}</div>
    </div>
    <div class="fb-card-body">
      <div class="fb-story-tab">${_e(item.tab_label || item.tab_id || '')} — <em>${_e(item.prompt_text || item.prompt_id || '')}</em></div>
      <div class="fb-story-response">${_e(item.response || '')}</div>
      <div class="fb-card-meta-row">
        <span>Publication: <strong>${_e(pubLabel)}</strong></span>
        ${item.email ? `<span>Email: ${_e(item.email)}</span>` : ''}
        ${item.phone ? `<span>Phone: ${_e(item.phone)}</span>` : ''}
      </div>
    </div>
    <div class="fb-card-actions">
      ${!isPublished ? `<button class="btn btn-primary btn-sm" onclick="fbApproveStory('${_e(item.story_id || item.key || '')}', '${_e(item.key || '')}', this)">Approve</button>` : ''}
      ${!isPublished ? `<button class="btn btn-secondary btn-sm" onclick="fbHoldStory('${_e(item.story_id || item.key || '')}', '${_e(item.key || '')}', this)">${status === 'held' ? 'Unhold' : 'Hold'}</button>` : ''}
      ${status === 'published' ? `<button class="btn btn-secondary btn-sm" onclick="fbWithdrawStory('${_e(item.key || '')}', this)">Withdraw</button>` : ''}
      ${status === 'withdrawn' ? `<button class="btn btn-primary btn-sm" onclick="fbRestoreStory('${_e(item.key || '')}', this)">Restore</button>` : ''}
      ${!isPublished ? `<button class="btn btn-danger btn-sm" onclick="fbDiscardStory('${_e(item.key || '')}', this)">Discard</button>` : ''}
    </div>
  </div>`;
}

async function fbApproveStory(storyId, key, btn) {
  btn.disabled = true;
  btn.textContent = 'Approving…';
  try {
    await api('POST', '/feedback/stories/approve', { story_id: storyId, key });
    btn.closest('.fb-card').remove();
    loadFeedbackCounts();
    toast('Story approved and published.', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Approve';
  }
}

async function fbHoldStory(storyId, key, btn) {
  btn.disabled = true;
  const isHold = btn.textContent.trim() === 'Hold';
  btn.textContent = isHold ? 'Holding…' : 'Unholding…';
  try {
    await api('POST', '/feedback/stories/hold', { story_id: storyId, key, hold: isHold });
    btn.disabled = false;
    btn.textContent = isHold ? 'Unhold' : 'Hold';
    toast(isHold ? 'Story held — will not auto-publish.' : 'Story unhold — will auto-publish tonight.', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = isHold ? 'Hold' : 'Unhold';
  }
}

async function fbDiscardStory(key, btn) {
  if (!confirm('Delete this story from R2? This cannot be undone.')) return;
  btn.disabled = true;
  try {
    await api('POST', '/feedback/stories/discard', { key });
    btn.closest('.fb-card').remove();
    loadFeedbackCounts();
    toast('Story discarded.', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
  }
}

async function fbWithdrawStory(key, btn) {
  btn.disabled = true;
  btn.textContent = 'Withdrawing…';
  try {
    await api('POST', '/feedback/stories/withdraw', { key });
    btn.textContent = 'Withdrawn';
    const card = btn.closest('.fb-card');
    const dateEl = card.querySelector('.fb-card-date');
    if (dateEl) dateEl.textContent = dateEl.textContent.replace('✓ Published', '✗ Withdrawn');
    // Swap button to Restore
    btn.className = 'btn btn-primary btn-sm';
    btn.textContent = 'Restore';
    btn.onclick = () => fbRestoreStory(key, btn);
    btn.disabled = false;
    toast('Story withdrawn — removed from public feed.', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Withdraw';
  }
}

async function fbRestoreStory(key, btn) {
  btn.disabled = true;
  btn.textContent = 'Restoring…';
  try {
    await api('POST', '/feedback/stories/restore', { key });
    const card = btn.closest('.fb-card');
    const dateEl = card.querySelector('.fb-card-date');
    if (dateEl) dateEl.textContent = dateEl.textContent.replace('✗ Withdrawn', '✓ Published');
    btn.className = 'btn btn-secondary btn-sm';
    btn.textContent = 'Withdraw';
    btn.onclick = () => fbWithdrawStory(key, btn);
    btn.disabled = false;
    toast('Story restored — live on public feed.', 'success');
  } catch (e) {
    toast('Error: ' + e.message, 'error');
    btn.disabled = false;
    btn.textContent = 'Restore';
  }
}

async function fbLoadPublishedStories() {
  const list = document.getElementById('fb-published-stories-list');
  list.innerHTML = '<p class="ph-placeholder">Loading…</p>';
  try {
    const data = await api('GET', '/feedback/stories/published');
    if (!data.items || data.items.length === 0) {
      list.innerHTML = '<p class="ph-placeholder">No published stories.</p>';
      return;
    }
    list.innerHTML = data.items.map(renderStoryCard).join('');
  } catch (e) {
    list.innerHTML = `<p class="ph-placeholder" style="color:var(--danger)">Error: ${_e(e.message)}</p>`;
  }
}
</script>

</body>
</html>

<script>
// ─── New Profile Tab ──────────────────────────────────────────────────────────
(function () {

  var NP = { slug: null, mode: 'new' };

  window.npSetMode = function (mode) {
    NP.mode = mode;
    NP.slug = null;
    document.getElementById('np-btn-new').classList.toggle('active', mode === 'new');
    document.getElementById('np-btn-edit').classList.toggle('active', mode === 'edit');
    document.getElementById('np-slug-new').style.display  = mode === 'new'  ? '' : 'none';
    document.getElementById('np-slug-edit').style.display = mode === 'edit' ? '' : 'none';
    document.getElementById('np-sections').style.display  = 'none';
    npSetStatus('');
    if (mode === 'edit') npPopulateEditSelect();
  };

  window.npSlugInput = function () {
    var raw  = document.getElementById('np-slug-input').value.trim();
    var hint = document.getElementById('np-slug-hint');
    var btn  = document.getElementById('np-create-btn');
    var valid = /^[a-z0-9-]+$/.test(raw);
    hint.textContent = valid ? '' : 'lowercase letters, numbers, and hyphens only';
    hint.style.color = valid ? '' : 'var(--red)';
    btn.disabled = !valid || raw.length < 3;
  };

  window.npCreate = async function () {
    var slug = document.getElementById('np-slug-input').value.trim();
    if (!slug) return;
    npSetStatus('Creating...', 'info');
    try {
      var d = await api('POST', '/soldiers/create', { slug: slug });
      if (!d.ok) {
        var msg = d.alreadyExists ? '"' + slug + '" already exists.' : d.error;
        npSetStatus(msg, 'error');
        toast(msg, 'error');
        return;
      }
      NP.slug = slug;
      document.getElementById('np-date_added').value = new Date().toISOString().slice(0, 10);
      npSetStatus('Profile created: ' + slug, '');
      document.getElementById('np-sections').style.display = '';
    } catch (e) {
      npSetStatus(e.message, 'error');
      toast(e.message, 'error');
    }
  };

  async function npPopulateEditSelect() {
    var sel = document.getElementById('np-slug-select');
    sel.innerHTML = '<option value="">-- loading... --</option>';
    try {
      var items = await api('GET', '/slugs?type=soldier');
      // /api/slugs returns [{slug, path}, ...] for soldiers
      var slugs = (Array.isArray(items) ? items : [])
                    .map(function(s) { return typeof s === 'object' ? s.slug : s; })
                    .filter(Boolean).sort();
      sel.innerHTML = '<option value="">-- select soldier --</option>' +
        slugs.map(function(s) { return '<option value="' + s + '">' + s + '</option>'; }).join('');
    } catch (e) {
      sel.innerHTML = '<option value="">Error loading slugs</option>';
      toast(e.message, 'error');
    }
  }

  window.npLoadExisting = async function () {
    var slug = document.getElementById('np-slug-select').value;
    if (!slug) { document.getElementById('np-sections').style.display = 'none'; return; }
    npSetStatus('Loading...', 'info');
    try {
      var d = await api('GET', '/record?type=soldier&slug=' + encodeURIComponent(slug));
      NP.slug = slug;
      npPopulateForm(d.data || d);
      document.getElementById('np-sections').style.display = '';
      npSetStatus('Editing: ' + slug, 'info');
    } catch (e) {
      npSetStatus(e.message, 'error');
      toast(e.message, 'error');
    }
  };

  function npPopulateForm(fm) {
    var fields = [
      'first_name','last_name','middle_name','suffix','nickname','birth_year',
      'rank','mos','platoon',
      'arrived','departed','status','character_of_service',
      'hometown','current_location','year_deceased','cause_of_death',
      'date_added','contributed_by','notes',
    ];
    for (var i = 0; i < fields.length; i++) {
      var f = fields[i];
      var el = document.getElementById('np-' + f);
      if (!el) continue;
      var val = fm[f];
      if (val === undefined || val === null) continue;
      el.value = String(val);
    }
  }

  var SECTION_FIELDS = {
    identity:    ['first_name','last_name','middle_name','suffix','nickname','birth_year'],
    rank:        ['rank','mos','platoon'],
    service:     ['arrived','departed','status','character_of_service'],
    postservice: ['hometown','current_location','year_deceased','cause_of_death'],
    admin:       ['contributed_by','notes'],
  };

  window.npSaveSection = async function (section) {
    if (!NP.slug) { npSetStatus('No active profile -- create or load one first.', 'error'); return; }
    var fields = SECTION_FIELDS[section];
    if (!fields) return;
    var edits = [];
    for (var i = 0; i < fields.length; i++) {
      var f = fields[i];
      var el = document.getElementById('np-' + f);
      if (!el) continue;
      var val = el.value.trim();
      if (val !== '') edits.push({ field: f, value: val });
    }
    if (!edits.length) { npSectionMsg(section, 'Nothing to save.', ''); return; }
    npSectionMsg(section, 'Saving...', '');
    var results = await Promise.all(edits.map(function(e) {
      return api('POST', '/edit', { type: 'soldier', slug: NP.slug, field: e.field, value: e.value })
        .catch(function(err) { return { error: err.message }; });
    }));
    var errors = results.filter(function(r) { return r.error; });
    if (errors.length) {
      var msg = errors.length + ' field(s) failed: ' + errors.map(function(e) { return e.error; }).join('; ');
      npSectionMsg(section, msg, 'error');
      toast(msg, 'error');
    } else {
      npSectionMsg(section, 'Saved ' + results.length + ' field(s).', '');
    }
  };

  function npSetStatus(msg, type) {
    var el = document.getElementById('np-status-bar');
    if (!el) return;
    el.textContent = msg;
    el.className = 'np-status-bar' + (type ? ' ' + type : '');
  }

  function npSectionMsg(section, msg, type) {
    var btn = document.querySelector('.np-section button[onclick="npSaveSection(\'' + section + '\')"]');
    if (!btn) return;
    var sectionEl = btn.closest('.np-section');
    if (!sectionEl) return;
    var msgEl = sectionEl.querySelector('.np-section-msg');
    if (!msgEl) {
      msgEl = document.createElement('div');
      msgEl.className = 'np-section-msg';
      sectionEl.appendChild(msgEl);
    }
    msgEl.textContent = msg;
    msgEl.className = 'np-section-msg' + (type === 'error' ? ' error' : '');
    if (msg && type !== 'error') {
      setTimeout(function() { if (msgEl.textContent === msg) msgEl.textContent = ''; }, 3000);
    }
  }

  // Hook into switchTab
  (function() {
    var _prev = typeof switchTab === 'function' ? switchTab : null;
    window.switchTab = function (name) {
      if (_prev) _prev(name);
    };
  })();

})();
</script>
